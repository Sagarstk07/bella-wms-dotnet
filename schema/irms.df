  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS 
    ""Open"", ""O"", 
    ""Dropped"", ""D"",     
    ""In Pick"", ""I"",  
    ""Completed"", ""C""      "
  HELP "Staging Line Status for this movement."
