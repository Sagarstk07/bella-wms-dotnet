  ""Report"", Yes,
  ""Label"", No, ""Scale"", ?                                                  "
  HELP "Enter printer type."
  ORDER 60

ADD FIELD "row_status" OF "printmst" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 41
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this printer queue active?"
  ORDER 100
  MANDATORY

ADD FIELD "print_form" OF "printmst" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Form"
  POSITION 42
  MAX-WIDTH 20
  HELP "Default form for this printer."
  ORDER 70

ADD FIELD "printer_id" OF "printmst" AS character 
  DESCRIPTION "Printer ID, as known to IRMS (unique). Note, some printers may have more than one id (for instance, a Genicom used for labels and also used for reports)."
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Printer Id"
  POSITION 43
  MAX-WIDTH 30
  VALMSG "Please enter a printer id."
  HELP "Enter an unique identifier for this printer."
  ORDER 30
  MANDATORY

ADD FIELD "printer" OF "printmst" AS character 
  DESCRIPTION "Printer, as known to unix. Corresponds to a physical printer."
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Printer"
  POSITION 44
  MAX-WIDTH 60
  VALMSG "Please enter the unix printer name."
  HELP "Enter the printer name as known to unix (case sensitive)."
  ORDER 40
  CASE-SENSITIVE

ADD FIELD "description" OF "printmst" AS character 
  FORMAT "x(55)"
  INITIAL ""
  LABEL "Description"
  POSITION 45
  MAX-WIDTH 110
  HELP "Enter a description for this queue."
  ORDER 50

ADD FIELD "custom_data" OF "printmst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 46
  MAX-WIDTH 510
  EXTENT 5
  ORDER 90

ADD FIELD "co_num" OF "printmst" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 47
  MAX-WIDTH 8
  VALMSG "Company must be defined in the Company Master table first."
  HELP "Enter the company number."
  ORDER 10

ADD INDEX "co_wh_id" ON "printmst" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  DESCRIPTION "Enforce uniqueness."
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "printer_id" ASCENDING 

ADD TABLE "prod_stg_dtl"
  AREA "unused_dat"
  DESCRIPTION "Contains the detail for production staging."
  DUMP-NAME "prod_dtl"

ADD FIELD "to_bin" OF "prod_stg_dtl" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "To Location"
  POSITION 2
  MAX-WIDTH 20
  HELP "Enter the id for this location."
  ORDER 60
  MANDATORY

ADD FIELD "lot" OF "prod_stg_dtl" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Lot"
  POSITION 3
  MAX-WIDTH 48
  HELP "Lot Number."
  ORDER 40

ADD FIELD "line_status" OF "prod_stg_dtl" AS character 
  DESCRIPTION "Staging Line Statuses - (O)pen, (D)ropped, (I)n-pick,  (C)ompleted."
  FORMAT "X"
  INITIAL "O"
  LABEL "Line Status"
