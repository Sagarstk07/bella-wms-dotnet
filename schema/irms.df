  INDEX-FIELD "RMA" ASCENDING 

ADD TABLE "serial_pick"
  AREA "unused_dat"
  LABEL "Serial Pick"
  DESCRIPTION "This table holds serial numbers assigned to specific order lines."
  DUMP-NAME "serial_p"

ADD FIELD "serial_num" OF "serial_pick" AS character 
  FORMAT "x(24)"
  INITIAL ?
  LABEL "Serial Number"
  POSITION 2
  MAX-WIDTH 48
  HELP "The serial number"
  ORDER 60

ADD FIELD "picked" OF "serial_pick" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Picked"
  POSITION 3
  MAX-WIDTH 1
  ORDER 70

ADD FIELD "line_sequence" OF "serial_pick" AS integer 
  DESCRIPTION "Used for items that are kits, this is a sub-line number."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Seq"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Sq"
  HELP "Enter the order line sequence number."
  ORDER 50

ADD FIELD "line" OF "serial_pick" AS integer 
  FORMAT ">>>9"
  INITIAL ?
  LABEL "Line"
  POSITION 5
  MAX-WIDTH 4
  VALMSG "Please enter a non-zero order line."
  HELP "Order Line number."
  ORDER 40

ADD FIELD "id" OF "serial_pick" AS integer 
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Id"
  POSITION 6
  MAX-WIDTH 4
  HELP "DO NOT EDIT THIS FIELD."
  ORDER 10
  MANDATORY

ADD FIELD "custom_data" OF "serial_pick" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 7
  MAX-WIDTH 510
  EXTENT 5
  ORDER 80

ADD INDEX "id_line_seq_serial" ON "serial_pick" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "id" ASCENDING 
  INDEX-FIELD "line" ASCENDING 
  INDEX-FIELD "line_sequence" ASCENDING 
  INDEX-FIELD "serial_num" ASCENDING 

ADD TABLE "shfmst"
  AREA "misc128_dat"
  LABEL "Shift Master"
  DESCRIPTION "Contains all shifts known to irms.
"
  DUMP-NAME "shfmst"

ADD FIELD "wh_num" OF "shfmst" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "time_start" OF "shfmst" AS character 
  DESCRIPTION "Shift Start Time."
  FORMAT "99:99"
  INITIAL ""
  LABEL "Shift Start"
  POSITION 3
  MAX-WIDTH 10
  COLUMN-LABEL "start"
  HELP "Please enter the start time for this shift."
  ORDER 40
  MANDATORY
  FIELD-TRIGGER "Assign" OVERRIDE PROCEDURE "time.t" CRC "?" 

ADD FIELD "time_end" OF "shfmst" AS character 
  DESCRIPTION "Shift End Time."
  FORMAT "99:99"
  INITIAL ""
  LABEL "Shift End"
  POSITION 4
  MAX-WIDTH 10
  COLUMN-LABEL "end"
  HELP "Please enter the end time for this shift."
  ORDER 50
  MANDATORY
  FIELD-TRIGGER "Assign" OVERRIDE PROCEDURE "time.t" CRC "?" 

ADD FIELD "shf_num" OF "shfmst" AS integer 
  DESCRIPTION "Shift number."
  FORMAT ">>>>>9"
  INITIAL "0"
  LABEL "Shift Number"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Shift #"
  HELP "Enter the Id for this shift."
  ORDER 30
  MANDATORY

ADD FIELD "shf_desc" OF "shfmst" AS character 
  DESCRIPTION "Shift Description."
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Shift Description"
  POSITION 6
  MAX-WIDTH 30
  COLUMN-LABEL "Shift Description"
  HELP "Enter a description for this shift."
  ORDER 60

ADD FIELD "row_status" OF "shfmst" AS logical 
  DESCRIPTION "Shift: active or inactive"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 7
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this shift active?"
  ORDER 180
  MANDATORY

ADD FIELD "custom_data" OF "shfmst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 8
  MAX-WIDTH 510
  EXTENT 5
  ORDER 170

ADD FIELD "co_num" OF "shfmst" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 9
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10

ADD INDEX "co_wh_shf" ON "shfmst" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "shf_num" ASCENDING 

