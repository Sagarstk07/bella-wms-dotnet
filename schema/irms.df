  FORMAT ">>>9"
  INITIAL "1"
  LABEL "Aisle"
  POSITION 33
  MAX-WIDTH 4
  HELP "Enter the aisle where this location is."
  ORDER 50
  MANDATORY

ADD FIELD "abs_num" OF "binmst" AS character 
