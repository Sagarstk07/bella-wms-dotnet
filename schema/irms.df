ADD TABLE "motd"
  AREA "unused_dat"
  LABEL "Message of the Day"
  DESCRIPTION "Stores email-like messages."
  DUMP-NAME "motd"

ADD FIELD "sent" OF "motd" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ?
  LABEL "Sent"
  POSITION 2
  MAX-WIDTH 32
  ORDER 30

ADD FIELD "reply_requested" OF "motd" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Reply Requested"
  POSITION 3
  MAX-WIDTH 1
  ORDER 60

ADD FIELD "received" OF "motd" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ?
  LABEL "Received"
  POSITION 4
  MAX-WIDTH 32
  ORDER 40

ADD FIELD "priority_message" OF "motd" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Priority"
  POSITION 5
  MAX-WIDTH 1
  ORDER 50

ADD FIELD "message_text" OF "motd" AS character 
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Message Text"
  POSITION 6
  MAX-WIDTH 100
  ORDER 70

ADD FIELD "emp_to" OF "motd" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "To"
  POSITION 7
