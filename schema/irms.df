  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "bin_num" ASCENDING 
  INDEX-FIELD "rtn_category" ASCENDING 
  INDEX-FIELD "rtn_pallet_full" ASCENDING 

ADD INDEX "co_wh_cyclecount" ON "inventory" 
  AREA "misc64_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "cycle_flag" ASCENDING 
  INDEX-FIELD "cycle_id" ASCENDING 
  INDEX-FIELD "bin_num" ASCENDING 

ADD INDEX "co_wh_lot_abs" ON "inventory" 
  AREA "misc64_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "lot" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 

