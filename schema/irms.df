  MANDATORY

ADD FIELD "custom_data" OF "rtmst_status" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 3
  MAX-WIDTH 510
  EXTENT 5
  ORDER 30

