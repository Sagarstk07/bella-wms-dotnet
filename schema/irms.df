  DESCRIPTION "Stores a comma seperated list of compatible Theme IDs.                                                                                      "
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Compatible Themes"
  POSITION 7
  MAX-WIDTH 120
  VIEW-AS ""
  COLUMN-LABEL "Compatible Themes"
  HELP "Enter a comma seperated list of compatible Theme IDs."
  ORDER 110

ADD FIELD "change_warning" OF "drop_theme" AS character 
  DESCRIPTION "Stores the Warning Message to display when turned on/off.                                                                                   "
  FORMAT "x(1000)"
  INITIAL ""
  LABEL "Change Warning"
  POSITION 8
  MAX-WIDTH 2000
  VIEW-AS ""
  COLUMN-LABEL "Change Warning"
  HELP "Enter the Warning Message to display when turned on/off."
  ORDER 100

ADD FIELD "row_status" OF "drop_theme" AS logical 
  DESCRIPTION "Stores whether the Drop Theme is active or not.                                                                                             "
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Active"
  POSITION 9
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "Active"
  HELP "Enter Yes to activate this Drop Theme."
  ORDER 90

ADD FIELD "allow_force_drop" OF "drop_theme" AS logical 
  DESCRIPTION "Stores whether to to allow Force Drop within the Theme.                                                                                     "
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Allow Force Drop"
  POSITION 10
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "Force Drop"
  HELP "Enter Yes to allow Force Drop within this Theme."
  ORDER 80

ADD FIELD "set_assigned" OF "drop_theme" AS logical 
  DESCRIPTION "Stores whether to set the Assigned order header field or not.                                                                               "
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Set Assigned"
  POSITION 11
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "Set Assigned"
  HELP "Enter Yes to set the Assigned order header field on the drop."
  ORDER 60

ADD FIELD "set_batch_id" OF "drop_theme" AS logical 
  DESCRIPTION "Stores whether to set the Wave ID on the order header or not.                                                                               "
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Set Batch ID"
  POSITION 12
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "Set Batch ID"
  HELP "Enter Yes to set the Wave ID on the order header."
  ORDER 50

ADD FIELD "description" OF "drop_theme" AS character 
  DESCRIPTION "Stores the Description of the Drop Theme.                                                                                                   "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Description"
  POSITION 13
  MAX-WIDTH 60
  VIEW-AS ""
  COLUMN-LABEL "Description"
  HELP "Enter the Description for this Drop Theme."
  ORDER 40

ADD FIELD "drop_theme_id" OF "drop_theme" AS integer 
  DESCRIPTION "Stores the ID of the Drop Theme.                                                                                                            "
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Drop Theme ID"
  POSITION 14
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Theme ID"
  HELP "Enter the ID for this Drop Theme."
