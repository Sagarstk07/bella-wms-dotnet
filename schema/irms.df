  POSITION 7
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 120

ADD FIELD "create_time" OF "lpn" AS integer 
  DESCRIPTION "Describes the Created Time of the LPN Carton.                                                                                               "
  FORMAT "999999"
  INITIAL "0"
  LABEL "Created Time"
  POSITION 8
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Created Time"
  HELP "Enter the Created Time of the LPN Carton."
  ORDER 110

ADD FIELD "create_date" OF "lpn" AS date 
  DESCRIPTION "Describes the Created Date for the LPN Carton.                                                                                              "
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Created Date"
  POSITION 9
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Created!Date"
