ADD FIELD "clearance_code" OF "rtmst" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Clearance Code"
  POSITION 23
  MAX-WIDTH 48
  HELP "Customs Clearance Code."
