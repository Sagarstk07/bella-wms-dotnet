ADD TABLE "cycle_cnt"
  AREA "misc128_dat"
  LABEL "Cycle Count"
  DESCRIPTION "Table used by the warehouse administrator to set up automatic
cycle counts."
  DUMP-NAME "cycle_cn"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_cycle.t" CRC "?" 

ADD FIELD "wh_num" OF "cycle_cnt" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "task_id" OF "cycle_cnt" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  LABEL "Task Id"
  POSITION 3
  MAX-WIDTH 4
  ORDER 100

ADD FIELD "started" OF "cycle_cnt" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Started"
  POSITION 4
  MAX-WIDTH 32
  HELP "Time stamp of when this cycle count was started."
  ORDER 70
  FIELD-TRIGGER "Assign" OVERRIDE PROCEDURE "datetim.t" CRC "?" 

ADD FIELD "row_status" OF "cycle_cnt" AS logical 
  DESCRIPTION "active or inactive"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 5
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Use this cycle count information?"
  ORDER 150
  MANDATORY

ADD FIELD "requested" OF "cycle_cnt" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Requested"
  POSITION 6
  MAX-WIDTH 32
  HELP "Time stamp of when this cycle count was requested."
  ORDER 60
  FIELD-TRIGGER "Assign" OVERRIDE PROCEDURE "datetim.t" CRC "?" 

ADD FIELD "id" OF "cycle_cnt" AS integer 
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Id"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "id"
  HELP "DO NOT EDIT THIS FIELD."
  ORDER 10
  MANDATORY

ADD FIELD "emp_num" OF "cycle_cnt" AS character 
  FORMAT "x(5)"
  INITIAL ""
  LABEL "Employee Number"
  POSITION 8
  MAX-WIDTH 11
  COLUMN-LABEL ""
  HELP "Employee who requested this cycle count."
  ORDER 110

ADD FIELD "cycle_type" OF "cycle_cnt" AS character 
  FORMAT "X(8)"
  INITIAL "A"
  LABEL "Type of Cycle Count"
  POSITION 9
  MAX-WIDTH 16
  HELP "Cycle count by activity, zone or item."
  ORDER 40
  MANDATORY

ADD FIELD "cycle_string" OF "cycle_cnt" AS character 
  DESCRIPTION "This field needs extensive validation depending on the type of cycle c"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Level of Cycle Count"
  POSITION 10
  MAX-WIDTH 48
  HELP "Enter the Level for this cycle count."
  ORDER 50

ADD FIELD "custom_data" OF "cycle_cnt" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 11
  MAX-WIDTH 510
  EXTENT 5
  ORDER 140

ADD FIELD "co_num" OF "cycle_cnt" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 12
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 20
  MANDATORY

ADD FIELD "completed" OF "cycle_cnt" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Completed"
  POSITION 13
  MAX-WIDTH 32
  HELP "Time stamp of when this cycle count was completed."
  ORDER 90

ADD FIELD "auth_list" OF "cycle_cnt" AS character 
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Authorized"
  POSITION 14
  MAX-WIDTH 100
  HELP "List of employees authorized to perform this cycle count."
  ORDER 120

ADD INDEX "id" ON "cycle_cnt" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "id" ASCENDING 

ADD INDEX "co_wh_type_string" ON "cycle_cnt" 
  AREA "misc128_idx"
  UNIQUE
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "cycle_type" ASCENDING 
  INDEX-FIELD "cycle_string" ASCENDING 

ADD TABLE "cycle_numbers"
  AREA "unused_dat"
  LABEL "Cycle Numbers"
  DESCRIPTION "System Interface - pgm-to-pgm and file transfer cycle numbers.  Used to keep track of what files have been sent and received. (critical to re-starts)"
  DUMP-NAME "cycle_nu"

ADD FIELD "upload" OF "cycle_numbers" AS logical 
  FORMAT "upload/download"
  INITIAL "upload"
  LABEL "Direction"
  POSITION 2
  MAX-WIDTH 1
  HELP "Is this an upload or download?"
  ORDER 70
  MANDATORY

ADD FIELD "timestamp" OF "cycle_numbers" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Time Stamp"
  POSITION 3
  MAX-WIDTH 32
  HELP "Date and time of the latest interaction -- do not modify"
  ORDER 60

ADD FIELD "row_status" OF "cycle_numbers" AS logical 
  DESCRIPTION "active or inactive"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 4
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Process this kind of transaction?"
  ORDER 110
  MANDATORY

ADD FIELD "next_cycle_number" OF "cycle_numbers" AS integer 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Next Number"
  POSITION 5
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "multiple" OF "cycle_numbers" AS logical 
  DESCRIPTION "If true, send this kind of transaction to mainframe whenever irt happe"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 6
  MAX-WIDTH 1
  HELP "Upload multiple times?"
  ORDER 80
  MANDATORY

ADD FIELD "last_acked_cycle" OF "cycle_numbers" AS integer 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Last Acknowledged"
  POSITION 7
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "file_path" OF "cycle_numbers" AS character 
  DESCRIPTION "Not used for All-Phase."
  FORMAT "X(72)"
  INITIAL ""
  LABEL "File Location"
  POSITION 8
  MAX-WIDTH 144
  HELP "Location of this file."
  ORDER 20

ADD FIELD "file_name" OF "cycle_numbers" AS character 
  DESCRIPTION "e.g: irimdn (NOTE, LOWER CASE, PLEASE!)"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "File Name"
  POSITION 9
  MAX-WIDTH 40
  HELP "Transmission id."
  ORDER 10

ADD FIELD "description" OF "cycle_numbers" AS character 
  FORMAT "X(32)"
  INITIAL ""
  LABEL "Description"
  POSITION 10
  MAX-WIDTH 64
  HELP "A description for this file."
  ORDER 30

ADD FIELD "custom_data" OF "cycle_numbers" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 11
  MAX-WIDTH 510
  EXTENT 5
  ORDER 100

ADD INDEX "file" ON "cycle_numbers" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "file_name" ASCENDING 

