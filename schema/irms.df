ADD FIELD "item_qty" OF "prod_stg_dtl" AS decimal 
  DESCRIPTION "Movement quantity."
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Quantity"
  POSITION 8
  MAX-WIDTH 17
  HELP "Quantity."
  DECIMALS 2
  ORDER 90

ADD FIELD "id" OF "prod_stg_dtl" AS integer 
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Id"
  POSITION 9
  MAX-WIDTH 4
  HELP "DO NOT EDIT THIS FIELD."
  ORDER 10
  MANDATORY

ADD FIELD "from_bin" OF "prod_stg_dtl" AS character 
  FORMAT "x(10)"
  INITIAL ?
  LABEL "From Location"
  POSITION 10
  MAX-WIDTH 20
  HELP "Enter the id for this location."
  ORDER 50

ADD FIELD "custom_data" OF "prod_stg_dtl" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 11
  MAX-WIDTH 510
  EXTENT 5
  ORDER 130

