  MAX-WIDTH 156
  VIEW-AS ""
  COLUMN-LABEL "Ext. Msg"
  ORDER 360

ADD FIELD "external_status" OF "pick" AS character 
  DESCRIPTION "External system status"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Ext. Status"
  POSITION 38
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "Ext. Status"
  ORDER 350

