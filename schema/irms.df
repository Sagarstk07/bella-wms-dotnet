  LABEL "Widget Type"
  POSITION 2
  MAX-WIDTH 40
  ORDER 50

ADD FIELD "id" OF "parcel_value" AS character 
  DESCRIPTION "An identifier"
  FORMAT "X(8)"
  INITIAL ""
  LABEL "ID"
  POSITION 3
  MAX-WIDTH 16
  ORDER 20

ADD FIELD "display_format" OF "parcel_value" AS character 
  DESCRIPTION "Progress display format for this variable."
  FORMAT "x(20)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 40
  ORDER 30

ADD FIELD "data_value" OF "parcel_value" AS character 
  DESCRIPTION "Will hold the value, converted to a string when needed."
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Value"
  POSITION 5
  MAX-WIDTH 100
  ORDER 60

ADD FIELD "data_type" OF "parcel_value" AS character 
  DESCRIPTION "Progress data type."
