  MAX-WIDTH 4
  COLUMN-LABEL "max pal"
  HELP "Maximum pallets in this location."
  ORDER 140
  MANDATORY

ADD FIELD "max_lvl" OF "binmst" AS decimal 
  DESCRIPTION "Maximum level (for auto restock) (Used only when this location is a primary pick)."
  FORMAT ">>,>>9.99"
  INITIAL ?
  LABEL "Maximum Level"
  POSITION 22
  MAX-WIDTH 17
  COLUMN-LABEL "max lvl"
  HELP "Enter the maximum allowed level for this item."
