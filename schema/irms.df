  INITIAL "0"
  LABEL "Login Attempts"
  POSITION 61
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Attempts"
  HELP "The number of unsuccessful login attempts since the last login."
  ORDER 570

ADD FIELD "locked_until" OF "empmst" AS datetime 
  DESCRIPTION "Stores the date/time when the user will no longer be locked due to unsuccessful login attempts."
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL "NOW"
  LABEL "Locked Until"
  POSITION 62
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Locked Until"
  HELP "Stores the date/time when the user will no longer be locked."
  ORDER 560

