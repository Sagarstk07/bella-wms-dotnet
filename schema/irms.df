  FORMAT ">,>>9"
  INITIAL "0"
  LABEL "Retention Period"
  POSITION 5
  MAX-WIDTH 4
  HELP "Enter the retention period for this file."
  ORDER 50
  MANDATORY

ADD FIELD "file_path" OF "file_retent" AS character 
  DESCRIPTION "Directory"
  FORMAT "X(72)"
  INITIAL ""
  LABEL "Directory"
  POSITION 6
  MAX-WIDTH 144
  HELP "Location of this file."
  ORDER 20

ADD FIELD "file_name" OF "file_retent" AS character 
  FORMAT "x(72)"
  INITIAL ""
  LABEL "File Name"
  POSITION 7
  MAX-WIDTH 144
  HELP "Enter a File Name."
  ORDER 10
  MANDATORY

ADD FIELD "description" OF "file_retent" AS character 
  FORMAT "X(32)"
  INITIAL ""
  LABEL "Description"
  POSITION 8
  MAX-WIDTH 64
  HELP "A description for this file."
  ORDER 30

ADD FIELD "custom_data" OF "file_retent" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 9
  MAX-WIDTH 510
  EXTENT 5
  ORDER 80

ADD INDEX "filename" ON "file_retent" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "file_name" ASCENDING 

