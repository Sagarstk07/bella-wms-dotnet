ADD TABLE "serial"
  AREA "unused_dat"
  LABEL "Serial Number Table"
  DESCRIPTION "Track serial numbers for items that have the serial id flag
set.
"
  DUMP-NAME "serial"

ADD FIELD "wh_num" OF "serial" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "serial_num" OF "serial" AS character 
  DESCRIPTION "The serial number (captured from the item, as set by manufacturer)."
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Serial Number"
  POSITION 3
  MAX-WIDTH 40
  HELP "Enter the serial number."
  ORDER 40

ADD FIELD "po_suffix" OF "serial" AS character 
  FORMAT "X(2)"
  INITIAL ""
  LABEL "PO Suffix"
  POSITION 4
  MAX-WIDTH 4
  ORDER 230

ADD FIELD "po_number" OF "serial" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "PO Number"
  POSITION 5
  MAX-WIDTH 20
  ORDER 220

ADD FIELD "po_line_sequence" OF "serial" AS integer 
  DESCRIPTION "This is a sub-sequence for the po-line. It is used with kits. This is here just because we will need this datawhen we create the stock receipt transaction."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Seq"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "Sq"
  HELP "Enter the PO line sequence number."
  ORDER 260

ADD FIELD "po_line" OF "serial" AS integer 
  DESCRIPTION "PO Line number, kept here because we need it in the receival transaction."
  FORMAT ">>>9"
  INITIAL "0"
  POSITION 7
  MAX-WIDTH 4
  ORDER 250

ADD FIELD "pallet_id" OF "serial" AS character 
  FORMAT "x(17)"
  INITIAL ""
  LABEL "Pallet Id"
  POSITION 8
  MAX-WIDTH 34
  COLUMN-LABEL "pallet"
  ORDER 150

ADD FIELD "order_suffix" OF "serial" AS character 
  FORMAT "X(2)"
  INITIAL ""
  LABEL "Order Suffix"
  POSITION 9
  MAX-WIDTH 4
  ORDER 170

ADD FIELD "order_line_sequence" OF "serial" AS integer 
  DESCRIPTION "Used for items that are kits, this is a sub-line number."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Seq"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL "Sq"
  HELP "Enter the order line sequence number."
  ORDER 190

ADD FIELD "order_line" OF "serial" AS integer 
  FORMAT ">>>9"
  INITIAL "1"
  LABEL "Line"
  POSITION 11
  MAX-WIDTH 4
  VALMSG "Please enter a non-zero order line."
  HELP "Order Line number."
  ORDER 180
  MANDATORY

ADD FIELD "order" OF "serial" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Order"
  POSITION 12
  MAX-WIDTH 20
  HELP "Please enter an order number."
  ORDER 160
  MANDATORY

ADD FIELD "date_time" OF "serial" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ?
  LABEL "Received"
  POSITION 13
  MAX-WIDTH 32
  ORDER 70

ADD FIELD "cycle_level" OF "serial" AS character 
  DESCRIPTION "S1 = system generated, first count S2 = idem, second count
M1 = manually generated, frist count, M2 = idem, second count"
  FORMAT "X9"
  INITIAL ?
  LABEL "Cycle Count Level"
  POSITION 14
  MAX-WIDTH 4
  HELP "Level of cycle count for this item (don't modify)."
  ORDER 120

ADD FIELD "cycle_id" OF "serial" AS integer 
  FORMAT ">>>>>>9"
  INITIAL ?
  POSITION 15
  MAX-WIDTH 4
  HELP "DO NOT EDIT THIS FIELD."
  ORDER 140

ADD FIELD "cycle_flag" OF "serial" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Cycle Flag"
  POSITION 16
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  ORDER 110
  MANDATORY

ADD FIELD "cycle_emp_num" OF "serial" AS character 
  DESCRIPTION "So that different emps will do 1st and 2nd cycle count."
  FORMAT "x(5)"
  INITIAL ?
  LABEL "Employee Number"
  POSITION 17
  MAX-WIDTH 10
  HELP "Employee who last cycle counted this item."
  ORDER 130

ADD FIELD "custom_data" OF "serial" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 18
  MAX-WIDTH 510
  EXTENT 5
  ORDER 270

ADD FIELD "co_num" OF "serial" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 19
  MAX-WIDTH 8
  VALMSG "Company must be defined in the Company Master table first."
  HELP "Enter the company number."
  ORDER 10

ADD FIELD "bin_num" OF "serial" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Location"
  POSITION 20
  MAX-WIDTH 20
  HELP "Inventory location."
  ORDER 60
  MANDATORY

ADD FIELD "abs_num" OF "serial" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Absolute Item Number"
  POSITION 21
  MAX-WIDTH 48
  COLUMN-LABEL "abs num"
  VALMSG "Item must be defined first."
  HELP "Enter the company-wide unique code for this item."
  ORDER 30
  MANDATORY

ADD INDEX "co_wh_abs_serial" ON "serial" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  DESCRIPTION "Enforce uniqueness of a serial number."
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "serial_num" ASCENDING 

ADD INDEX "abs_serial" ON "serial" 
  AREA "unused_idx"
  UNIQUE
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "serial_num" ASCENDING 

