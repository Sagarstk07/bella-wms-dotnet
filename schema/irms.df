  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 28
  MAX-WIDTH 9
  HELP "Enter the company number."
  ORDER 10

ADD FIELD "check_qty" OF "binmst" AS logical 
