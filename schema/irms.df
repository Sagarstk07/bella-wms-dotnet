ADD TABLE "drop_theme"
  AREA "misc128_dat"
  DESCRIPTION "Stores the various order dropping methods used within the OrderManager.                                                       "
  DUMP-NAME "drpthm"

ADD FIELD "drop_name" OF "drop_theme" AS character 
  DESCRIPTION "Stores the name of the drop theme to display in the order mgr.                                                                              "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Drop Name"
  POSITION 2
  MAX-WIDTH 60
  VIEW-AS ""
  COLUMN-LABEL "Drop Name"
  HELP "Enter the name of this drop theme to display in the order mgr."
  ORDER 160

ADD FIELD "prelim_stk_chk" OF "drop_theme" AS logical 
  DESCRIPTION "Stores whether to run prelim stock checks during order dropping or    not.                                                                  "
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Prelim Stock Check"
  POSITION 3
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "Prelim Stock Check"
  HELP "Enter Yes to run prelim stock checks during order dropping."
  ORDER 150

ADD FIELD "char_3" OF "drop_theme" AS character 
  FORMAT "x(8)"
  INITIAL ?
  LABEL ""
  POSITION 4
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 140

ADD FIELD "char_2" OF "drop_theme" AS character 
  FORMAT "x(8)"
  INITIAL ?
  LABEL ""
  POSITION 5
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 130

ADD FIELD "char_1" OF "drop_theme" AS character 
  FORMAT "x(8)"
  INITIAL ?
  LABEL ""
  POSITION 6
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 120

