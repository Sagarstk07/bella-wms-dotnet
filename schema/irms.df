ADD TABLE "orddtl"
  AREA "misc64_dat"
  LABEL "Order Detail"
  DESCRIPTION "Detail information (1 row per order line) -- many-to-1
relation into ordhdr."
  DUMP-NAME "orddtl"

ADD FIELD "handling_list" OF "orddtl" AS character 
  DESCRIPTION "Stores a pipe delimited list of cautious handling instructions.                                                                             "
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Handling List"
  POSITION 2
  MAX-WIDTH 120
  VIEW-AS ""
  COLUMN-LABEL "Handling List"
  HELP "Enter a pipe delimited list of cautious handling instructions."
  ORDER 540

ADD FIELD "undropped_qty" OF "orddtl" AS decimal 
  DESCRIPTION "Stores the the quantity that remains undropped on the line.                                                                                 "
  FORMAT "->>,>>9.99"
  INITIAL "0"
  LABEL "Undropped Qty"
  POSITION 3
  MAX-WIDTH 17
  VIEW-AS ""
  COLUMN-LABEL "Undropped Qty"
  HELP "Enter the quantity that remains undropped on this line."
  DECIMALS 2
  ORDER 530

ADD FIELD "error_msg" OF "orddtl" AS character 
  DESCRIPTION "Describes the error message for this line.                                                                                                  "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Error Msg"
  POSITION 4
  MAX-WIDTH 17823
  HELP "Enter the Error Message for this line."
  ORDER 520

ADD FIELD "errors" OF "orddtl" AS logical 
  DESCRIPTION "Describes whether or not this line has errors.                                                                                              "
  FORMAT "Y/N"
  INITIAL "no"
  LABEL "Errors"
  POSITION 5
  MAX-WIDTH 1
  HELP "Enter whether or not this line has errors."
  ORDER 510

