ADD TABLE "podet"
  AREA "unused_dat"
  LABEL "RT Detail"
  DESCRIPTION "Purchase Order detail"
  DUMP-NAME "podet"

ADD FIELD "wh_num" OF "podet" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "vend_item" OF "podet" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Vendor Item"
  POSITION 3
  MAX-WIDTH 48
  COLUMN-LABEL "vend item"
  VALMSG "Item must be defined in venddetail table first."
  HELP "Vendor-specific item number."
  ORDER 90
  MANDATORY

ADD FIELD "vendor_id" OF "podet" AS character 
  FORMAT "X(9)"
  INITIAL ""
  LABEL "Vendor ID"
  POSITION 4
  MAX-WIDTH 18
  HELP "Vendor ID"
  ORDER 60

ADD FIELD "uom" OF "podet" AS character 
  DESCRIPTION "UOM e.g.: EA, BX, CT"
  FORMAT "X(4)"
  INITIAL ""
  LABEL "Unit of Measure"
  POSITION 5
  MAX-WIDTH 8
  COLUMN-LABEL "uom"
  VALMSG "UOM must be defined in the UOM Table first."
  HELP "Unit of Measure for this RT line."
  ORDER 180

ADD FIELD "special_handling" OF "podet" AS character 
  FORMAT "X"
  INITIAL ""
  LABEL "Special Handling"
  POSITION 6
  MAX-WIDTH 2
  HELP "<B>ack-order, <C>ross-docking, <T>ie."
  ORDER 160

ADD FIELD "rtn_order_suffix" OF "podet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "x(2)"
  INITIAL ""
  LABEL "Order Suffix"
  POSITION 7
  MAX-WIDTH 4
  ORDER 300

ADD FIELD "rtn_order" OF "podet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Order"
  POSITION 8
  MAX-WIDTH 20
  ORDER 290
  MANDATORY

ADD FIELD "row_status" OF "podet" AS character 
  DESCRIPTION "A == active       O == open
C == completed (received all lines of this"
  FORMAT "x"
  INITIAL "O"
  LABEL "Status"
  POSITION 9
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS 
    ""Open"", ""O"",
    ""Active"", ""A"",
    ""Complete"", ""C"""
  HELP "The status for this R/T line."
  ORDER 420
  MANDATORY

ADD FIELD "ret_line_sequence" OF "podet" AS integer 
  DESCRIPTION "Field added for R&D"
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "RtSeq"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL "RtSq"
  HELP "Enter the return line sequence number."
  ORDER 320

ADD FIELD "ret_line" OF "podet" AS integer 
  DESCRIPTION "Field added for R&D"
  FORMAT ">>>9"
  INITIAL "1"
  LABEL "Line"
  POSITION 11
  MAX-WIDTH 4
  ORDER 310
  MANDATORY

ADD FIELD "return_fl" OF "podet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "X"
  INITIAL ""
  POSITION 12
  MAX-WIDTH 2
  ORDER 330

ADD FIELD "receiver_num" OF "podet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "x(10)"
  INITIAL ""
  POSITION 13
  MAX-WIDTH 20
  ORDER 370

ADD FIELD "rd_po_type" OF "podet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "X"
  INITIAL ""
  POSITION 14
  MAX-WIDTH 2
  ORDER 350

ADD FIELD "quantity" OF "podet" AS decimal 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Quantity Left"
  POSITION 15
  MAX-WIDTH 17
  HELP "Quantity."
  DECIMALS 2
  ORDER 100

ADD FIELD "qty_unavail" OF "podet" AS decimal 
  DESCRIPTION "Field added for R&D"
  FORMAT ">,>>>,>>>.99"
  INITIAL "0"
  POSITION 16
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 340

ADD FIELD "prod_desc" OF "podet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "x(30)"
  INITIAL ""
  POSITION 17
  MAX-WIDTH 60
  ORDER 380

ADD FIELD "po_type" OF "podet" AS character 
  DESCRIPTION "If there is a ""D"" here, this is a ""Department Order"", processed differ"
  FORMAT "X"
  INITIAL ""
  LABEL "PO Type"
  POSITION 18
  MAX-WIDTH 2
  HELP "Purchase Order Type."
  ORDER 250

ADD FIELD "po_suffix" OF "podet" AS character 
  FORMAT "X(2)"
  INITIAL ""
  LABEL "PO Suffix"
  POSITION 19
  MAX-WIDTH 4
  ORDER 240

ADD FIELD "po_number" OF "podet" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "PO Number"
  POSITION 20
  MAX-WIDTH 20
  ORDER 230

ADD FIELD "po_line" OF "podet" AS integer 
  FORMAT ">>>9"
  INITIAL "0"
  POSITION 21
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "po_id" OF "podet" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "PO id"
  POSITION 22
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "percent_fill" OF "podet" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL ?
  LABEL "Percent Fill"
  POSITION 23
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 400

ADD FIELD "packing_list" OF "podet" AS logical 
  DESCRIPTION "Set to true if this is a packing list RT"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 24
  MAX-WIDTH 1
  ORDER 390
  MANDATORY

ADD FIELD "packer" OF "podet" AS character 
  DESCRIPTION "Packer Id. The only reason why this is here is because we need it when we create the stock receipt transaction."
  FORMAT "X(14)"
  INITIAL ""
  POSITION 25
  MAX-WIDTH 28
  ORDER 270

ADD FIELD "ordered_qty" OF "podet" AS decimal 
  DESCRIPTION "Original ordered quantity, for documentation purposes."
  FORMAT "->>,>>9.99"
  INITIAL ?
  LABEL "Quantity Ordered"
  POSITION 26
  MAX-WIDTH 17
  HELP "Quantity ordered."
  DECIMALS 2
  ORDER 130

ADD FIELD "lot" OF "podet" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Lot"
  POSITION 27
  MAX-WIDTH 48
  HELP "Lot Number."
  ORDER 200

ADD FIELD "line_sequence" OF "podet" AS integer 
  DESCRIPTION "Component number for a purchase order line item."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Seq"
  POSITION 28
  MAX-WIDTH 4
  COLUMN-LABEL "Sq"
  HELP "Enter the PO line sequence number."
  ORDER 50

ADD FIELD "line_indicator" OF "podet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "X"
  INITIAL ""
  POSITION 29
  MAX-WIDTH 2
  ORDER 360

ADD FIELD "item_num" OF "podet" AS character 
  DESCRIPTION "NAED number (All-Phase)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Alternate Item Number"
  POSITION 30
  MAX-WIDTH 48
  VALMSG "Please enter this item's catalog number."
  HELP "Enter this item's catalog number."
  ORDER 80
  MANDATORY

ADD FIELD "item_desc" OF "podet" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Item Description"
  POSITION 31
  MAX-WIDTH 60
  COLUMN-LABEL "desc"
  HELP "Description for this item."
  ORDER 220

ADD FIELD "item_cost" OF "podet" AS decimal 
  FORMAT "$>>>,>>9.99"
  INITIAL "0"
  LABEL "Cost"
  POSITION 32
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 170

ADD FIELD "exp_quantity" OF "podet" AS decimal 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Expected Quantity"
  POSITION 33
  MAX-WIDTH 17
  HELP "Quantity expected"
  DECIMALS 2
  ORDER 120

ADD FIELD "delivery" OF "podet" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Delivery"
  POSITION 34
  MAX-WIDTH 4
  HELP "Estimated delivery date."
  ORDER 280

ADD FIELD "custom_data" OF "podet" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 35
  MAX-WIDTH 510
  EXTENT 5
  ORDER 410

ADD FIELD "co_num" OF "podet" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 36
  MAX-WIDTH 8
  VALMSG "Company must be defined in the Company Master table first."
  HELP "Enter the company number."
  ORDER 20

ADD FIELD "comments" OF "podet" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Comments"
  POSITION 37
  MAX-WIDTH 60
  COLUMN-LABEL "comments"
  HELP "Comments for this RT line."
  ORDER 210

ADD FIELD "case_qty" OF "podet" AS integer 
  FORMAT ">>,>>9"
  INITIAL "0"
  LABEL "Outer Pack"
  POSITION 38
  MAX-WIDTH 4
  COLUMN-LABEL "o/p"
  HELP "Outer pack quantity for this RT line."
  ORDER 190

ADD FIELD "bo_quantity" OF "podet" AS decimal 
  DESCRIPTION "Back-order quantity for this item. May be smaller, equal or larger than the quantity field. 0 means no back-orders. (See also: bo_count)"
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "B/O Quantity"
  POSITION 39
  MAX-WIDTH 17
  HELP "Quantity."
  DECIMALS 2
  ORDER 150

ADD FIELD "bo_count" OF "podet" AS integer 
  DESCRIPTION "The number of back orders for this line item. See also bo_quantity.
"
  FORMAT ">>9"
  INITIAL "0"
  LABEL "B/O Count"
  POSITION 40
  MAX-WIDTH 4
  HELP "The number of back orders for this item."
  ORDER 140

ADD FIELD "asn_flag" OF "podet" AS logical 
  DESCRIPTION "This is received from the mainframe. It is set to true if this is an EDI (electronic data i...) transaction, that is, paperless."
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 41
  MAX-WIDTH 1
  HELP "Is this an EDI transaction?"
  ORDER 260
  MANDATORY

ADD FIELD "act_quantity" OF "podet" AS decimal 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Actual Quantity"
  POSITION 42
  MAX-WIDTH 17
  HELP "Quantity received"
  DECIMALS 2
  ORDER 110

ADD FIELD "abs_num" OF "podet" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Absolute Item Number"
  POSITION 43
  MAX-WIDTH 48
  COLUMN-LABEL "abs num"
  VALMSG "Item must be defined first."
  HELP "Enter the company-wide unique code for this item."
  ORDER 70
  MANDATORY

ADD INDEX "id_line_seq" ON "podet" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "po_id" ASCENDING 
  INDEX-FIELD "po_line" ASCENDING 
  INDEX-FIELD "line_sequence" ASCENDING 

ADD INDEX "co_wh_abs" ON "podet" 
  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 

ADD INDEX "co_wh_vendor_status" ON "podet" 
  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "vendor_id" ASCENDING 
  INDEX-FIELD "row_status" ASCENDING 

ADD INDEX "id_abs" ON "podet" 
  AREA "unused_idx"
  INDEX-FIELD "po_id" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 

ADD INDEX "id_item" ON "podet" 
  AREA "unused_idx"
  INDEX-FIELD "po_id" ASCENDING 
  INDEX-FIELD "item_num" ASCENDING 

ADD TABLE "pomst"
  AREA "unused_dat"
  LABEL "RT Master"
  DESCRIPTION "Purchase Order Master File"
  DUMP-NAME "pomst"
  TABLE-TRIGGER "CREATE" OVERRIDE PROCEDURE "n_pomst.t" CRC "?" 

ADD FIELD "wh_num" OF "pomst" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "vendor_id" OF "pomst" AS character 
  FORMAT "X(9)"
  INITIAL ?
  LABEL "Vendor ID"
  POSITION 3
  MAX-WIDTH 18
  HELP "Vendor ID"
  ORDER 170

ADD FIELD "type" OF "pomst" AS character 
  FORMAT "XX"
  INITIAL "C"
  LABEL "R/T Type"
  POSITION 4
  MAX-WIDTH 4
  HELP "Enter the type for this order."
  ORDER 60
  MANDATORY

ADD FIELD "row_status" OF "pomst" AS character 
  DESCRIPTION "A == active       O == open
C == completed (received all lines of this"
  FORMAT "X"
  INITIAL "O"
  LABEL "Status"
  POSITION 5
  MAX-WIDTH 2
  COLUMN-LABEL "Status"
  HELP "The status of this R/T (Open, Active, Complete)."
  ORDER 190
  MANDATORY

ADD FIELD "po_suffix" OF "pomst" AS character 
  FORMAT "X(2)"
  INITIAL ""
  LABEL "PO Suffix"
  POSITION 6
  MAX-WIDTH 4
  ORDER 50
  MANDATORY

ADD FIELD "po_number" OF "pomst" AS character 
  FORMAT "X(10)"
  INITIAL ?
  LABEL "PO Number"
  POSITION 7
  MAX-WIDTH 20
  ORDER 40
  MANDATORY

ADD FIELD "po_id" OF "pomst" AS integer 
  DESCRIPTION "PO Id assigned by IRMS"
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "RT Id"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "id"
  ORDER 10
  MANDATORY

ADD FIELD "percent_fill" OF "pomst" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL ?
  LABEL "Percent Fill"
  POSITION 9
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 160

ADD FIELD "order_suffix" OF "pomst" AS character 
  FORMAT "X(2)"
  INITIAL ""
  LABEL "Order Suffix"
  POSITION 10
  MAX-WIDTH 4
  HELP "Order suffix, used only for RMAs"
  ORDER 100

ADD FIELD "order" OF "pomst" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Order"
  POSITION 11
  MAX-WIDTH 20
  HELP "Order number, used only for RMAs"
  ORDER 90

ADD FIELD "num_shipments" OF "pomst" AS integer 
  DESCRIPTION "Number of shipments to fill."
  FORMAT "->,>>>,>>9"
  INITIAL ?
  LABEL "Number of Shipments"
  POSITION 12
  MAX-WIDTH 4
  ORDER 150

ADD FIELD "num_cartons" OF "pomst" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Number of Cartons"
  POSITION 13
  MAX-WIDTH 4
  ORDER 130

ADD FIELD "delivery" OF "pomst" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Delivery"
  POSITION 14
  MAX-WIDTH 4
  HELP "Estimated delivery date."
  ORDER 80

ADD FIELD "custom_data" OF "pomst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 15
  MAX-WIDTH 510
  EXTENT 5
  ORDER 180

ADD FIELD "co_num" OF "pomst" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 16
  MAX-WIDTH 8
  VALMSG "Company must be defined in the Company Master table first."
  HELP "Enter the company number."
  ORDER 20

ADD FIELD "comments" OF "pomst" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Comments"
  POSITION 17
  MAX-WIDTH 60
  COLUMN-LABEL "comments"
  HELP "Comments for this RT."
  ORDER 70

ADD FIELD "closed_rts" OF "pomst" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL ?
  LABEL "Closed RTs"
  POSITION 18
  MAX-WIDTH 4
  ORDER 140

ADD FIELD "clearance_required" OF "pomst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Customs Hold"
  POSITION 19
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  HELP "Customs clearance required."
  ORDER 120

ADD FIELD "carrier" OF "pomst" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Carrier"
  POSITION 20
  MAX-WIDTH 40
  ORDER 110

ADD INDEX "co_wh_po_suf" ON "pomst" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "po_number" ASCENDING 
  INDEX-FIELD "po_suffix" ASCENDING 

ADD INDEX "co_wh_status_po_suf" ON "pomst" 
  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "row_status" ASCENDING 
  INDEX-FIELD "po_number" ASCENDING 
  INDEX-FIELD "po_suffix" ASCENDING 

ADD INDEX "co_wh_status_type" ON "pomst" 
  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "row_status" ASCENDING 
  INDEX-FIELD "type" ASCENDING 

ADD INDEX "co_wh_vendor_id" ON "pomst" 
  AREA "unused_idx"
  UNIQUE
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "vendor_id" ASCENDING 
  INDEX-FIELD "po_id" ASCENDING 

ADD INDEX "id" ON "pomst" 
  AREA "unused_idx"
  UNIQUE
  INDEX-FIELD "po_id" ASCENDING 

ADD INDEX "order_suf" ON "pomst" 
  AREA "unused_idx"
  INDEX-FIELD "order" ASCENDING 
  INDEX-FIELD "order_suffix" ASCENDING 

ADD TABLE "preferences"
  AREA "misc64_dat"
  DESCRIPTION "Each Record Represents Multiple User Preferences."
  DUMP-NAME "preferen"

ADD FIELD "char_3" OF "preferences" AS character 
  DESCRIPTION "Custom Data"
  FORMAT "x(8)"
  INITIAL ?
  LABEL ""
  POSITION 2
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter custom data."
  ORDER 130

ADD FIELD "char_2" OF "preferences" AS character 
  DESCRIPTION "Custom Data"
  FORMAT "x(8)"
  INITIAL ?
  LABEL ""
  POSITION 3
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter custom data."
  ORDER 120

ADD FIELD "char_1" OF "preferences" AS character 
  DESCRIPTION "Custom Data"
  FORMAT "x(8)"
  INITIAL ?
  LABEL ""
  POSITION 4
  MAX-WIDTH 46
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter custom data."
  ORDER 110

ADD FIELD "create_time" OF "preferences" AS integer 
  DESCRIPTION "The creation time."
  FORMAT "zzzz9"
  INITIAL "0"
  LABEL "Create Time"
  POSITION 5
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Created"
  HELP "Enter the creation time."
  ORDER 100

ADD FIELD "create_by" OF "preferences" AS character 
  DESCRIPTION "The employee that created the preference."
  FORMAT "x(6)"
  INITIAL ?
  LABEL "Created By"
  POSITION 6
  MAX-WIDTH 12
  VIEW-AS ""
  COLUMN-LABEL "Created By"
  HELP "Enter the employee number."
  ORDER 90

ADD FIELD "create_date" OF "preferences" AS date 
  DESCRIPTION "The Date the preference record was created/modified."
  FORMAT "99/99/9999"
  INITIAL "TODAY"
  LABEL "Create Date"
  POSITION 7
  MAX-WIDTH 4
