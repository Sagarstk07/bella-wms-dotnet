  FORMAT "999"
  INITIAL "0"
  LABEL "Group Index"
  POSITION 6
  MAX-WIDTH 4
  HELP "Enter the index to be grouped."
  ORDER 20

ADD FIELD "ReportID" OF "rblayout_group" AS integer 
  DESCRIPTION "Describes the report id.                                                                                                                    "
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Report ID"
  POSITION 7
  MAX-WIDTH 4
