  INITIAL ""
  LABEL "Category"
  POSITION 8
  MAX-WIDTH 16
  HELP "Enter the category to put the menu into."
  ORDER 40

ADD FIELD "menu_name" OF "rf_menu" AS character 
  DESCRIPTION "Describes the menu name.                                                                                                                    "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Menu Name"
  POSITION 9
  MAX-WIDTH 41
