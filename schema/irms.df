  INDEX-FIELD "order" ASCENDING 
  INDEX-FIELD "order_suffix" ASCENDING 
  INDEX-FIELD "line" ASCENDING 
  INDEX-FIELD "line_sequence" ASCENDING 
  INDEX-FIELD "serial_num" ASCENDING 

ADD INDEX "abs_serial" ON "serial_history" 
  AREA "unused_idx"
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "serial_num" ASCENDING 

ADD INDEX "CO_WH_ABS_SERIAL" ON "serial_history" 
  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "serial_num" ASCENDING 

ADD INDEX "rma" ON "serial_history" 
