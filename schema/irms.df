ADD FIELD "wh_num" OF "rule_value" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 3
  MAX-WIDTH 8
  HELP "Enter the warehouse id ('*' for all warehouses)."
  ORDER 15

ADD FIELD "type" OF "rule_value" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Rule Type"
  POSITION 4
  MAX-WIDTH 40
  COLUMN-LABEL "Type"
  HELP "Enter the type for this rule."
  ORDER 20

ADD FIELD "rule_value" OF "rule_value" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Rule Value"
  POSITION 5
  MAX-WIDTH 60
  COLUMN-LABEL "Value"
