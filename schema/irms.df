ADD FIELD "route_default" OF "dockmstr" AS character 
  FORMAT "X(8)"
  INITIAL ""
  LABEL "Default Route"
  POSITION 11
  MAX-WIDTH 16
  HELP "The default route serviced by this shipping dock."
  ORDER 70

ADD FIELD "name" OF "dockmstr" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Description"
  POSITION 12
  MAX-WIDTH 60
  HELP "A description of this dock."
  ORDER 40

ADD FIELD "dock_id" OF "dockmstr" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Dock Id"
  POSITION 13
  MAX-WIDTH 12
