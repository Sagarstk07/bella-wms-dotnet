  ORDER 90

ADD FIELD "sat_delivery" OF "ship_zone" AS logical 
  FORMAT "y/n"
  INITIAL "no"
  LABEL "Sat Del"
  POSITION 5
  MAX-WIDTH 1
  COLUMN-LABEL ""
  HELP "Enter 'Y' for saturday delivery."
