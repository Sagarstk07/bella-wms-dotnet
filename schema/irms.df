ADD TABLE "custmast"
  AREA "misc64_dat"
  LABEL "Customer Master"
  DESCRIPTION "Has information on all customers known to the system.
"
  DUMP-NAME "custmast"

ADD FIELD "scan_carton_refid" OF "custmast" AS logical 
  DESCRIPTION "Used to scan carton identifiers such as an SSCC18 number to be        included in outbound ASNs.                                            "
  FORMAT "Y/N"
  INITIAL "no"
  LABEL "Scan Carton Reference?"
  POSITION 2
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Scan Carton Reference?"
  HELP "Enter 'Y' to force a carton scan during shipping."
  ORDER 300

ADD FIELD "required_customs_data" OF "custmast" AS character 
  DESCRIPTION "This field defines if country of origin and po number are requried forthe customer                                                          "
  FORMAT "x(1)"
  INITIAL ""
  LABEL "Req. Customs Data"
  POSITION 3
  MAX-WIDTH 16
