  INITIAL "no"
  LABEL "Active"
  POSITION 10
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "Active"
  HELP "Enter Yes to activate this Drop Program."
  ORDER 60

ADD FIELD "day_of_week" OF "drop_program" AS character 
  DESCRIPTION "Stores the day(s) of the week that the program is for.                                                                                      "
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Day Of Week"
  POSITION 11
  MAX-WIDTH 30
  VIEW-AS ""
  COLUMN-LABEL "Day Of Week"
  HELP "Enter the day(s) of the week that this program is for."
  ORDER 40

ADD FIELD "drop_program" OF "drop_program" AS character 
  DESCRIPTION "Stores the name of the Drop Program.                                                                                                        "
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Drop Program"
  POSITION 12
  MAX-WIDTH 24
  VIEW-AS ""
  COLUMN-LABEL "Drop Program"
  HELP "Enter the name of this Drop Program."
  ORDER 30

ADD FIELD "wh_num" OF "drop_program" AS character 
  DESCRIPTION "Stores the Warehouse Number for the Drop Program.                                                                                           "
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 13
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Whse"
  HELP "Enter the Warehouse Number for this Drop Program."
  ORDER 20

ADD FIELD "co_num" OF "drop_program" AS character 
  DESCRIPTION "Stores the company that the Drop Program resides in.                                                                                        "
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 14
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Company"
  HELP "Enter the company that this Drop Program belongs to."
  ORDER 10

ADD INDEX "drop_program" ON "drop_program" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "drop_program" ASCENDING 

ADD TABLE "drop_program_timeslot"
