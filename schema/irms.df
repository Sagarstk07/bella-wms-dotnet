  AREA "misc64_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "prim_pick" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "prim_pick_type" ASCENDING 

ADD INDEX "co_wh_replen_abs" ON "binmst" 
  AREA "misc64_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "replen_abs_num" ASCENDING 

ADD INDEX "co_wh_zone_abc_cube_bin" ON "binmst" 
  AREA "misc64_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "wh_zone" ASCENDING 
  INDEX-FIELD "abc" ASCENDING 
  INDEX-FIELD "cube" ASCENDING 
  INDEX-FIELD "bin_num" ASCENDING 

ADD INDEX "co_wh_zone_aisle_bin" ON "binmst" 
  AREA "misc64_idx"
  UNIQUE
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "wh_zone" ASCENDING 
  INDEX-FIELD "aisle" ASCENDING 
  INDEX-FIELD "bin_num" ASCENDING 

ADD TABLE "bkmst"
  AREA "misc128_dat"
  LABEL "Backup Schedule Table"
  DESCRIPTION "This table should have only one row. This will be displayed to
the user as a matrix, with cells for every day of the week for
each of: backup database, backup logs (ai), rebuild indexes.
"
  DUMP-NAME "bkmst"

ADD FIELD "wed_in" OF "bkmst" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL ""
  POSITION 2
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Wednesday  index rebuild."
  ORDER 180
  MANDATORY

