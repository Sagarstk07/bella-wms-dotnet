  INITIAL ""
  LABEL "Time Stamp"
  POSITION 6
  MAX-WIDTH 32
  ORDER 30

ADD FIELD "custom_data" OF "system_lock" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 7
  MAX-WIDTH 510
  EXTENT 5
  ORDER 60

ADD INDEX "owner_lock" ON "system_lock" 
  AREA "misc256_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "owner" ASCENDING 
  INDEX-FIELD "lock" ASCENDING 

ADD TABLE "task"
