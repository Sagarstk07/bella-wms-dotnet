  HELP "Enter"
  ORDER 70

ADD FIELD "custom1" OF "virtual_lock" AS character 
  FORMAT "x(8)"
  INITIAL ?
  POSITION 4
  MAX-WIDTH 16
  HELP "Enter"
  ORDER 60

