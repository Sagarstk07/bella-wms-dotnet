  DESCRIPTION "Describes the program that contains the field.                                                                                              "
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Field ID"
  POSITION 2
  MAX-WIDTH 39
  COLUMN-LABEL "Field ID"
  HELP "Enter the lookup pgm for the field."
  ORDER 60

