ADD FIELD "country" OF "custaddr" AS character 
  FORMAT "x(20)"
  INITIAL "USA"
  LABEL "Country"
  POSITION 16
  MAX-WIDTH 40
  HELP "Country"
  ORDER 95

ADD FIELD "city" OF "custaddr" AS character 
