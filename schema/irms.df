  MANDATORY

ADD FIELD "stage" OF "dockmstr" AS character 
  DESCRIPTION "Stage Code, whatever."
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Stage"
  POSITION 8
  MAX-WIDTH 12
  HELP "The staging area for this shipping dock."
  ORDER 90

ADD FIELD "row_status" OF "dockmstr" AS logical 
  DESCRIPTION "Active or Inactive."
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 9
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this shipping dock active?"
  ORDER 130
  MANDATORY

ADD FIELD "route_now" OF "dockmstr" AS character 
  FORMAT "X(8)"
  INITIAL ""
  LABEL "Current Route"
  POSITION 10
  MAX-WIDTH 16
  HELP "The route currently being serviced by this shipping dock."
