ADD TABLE "inv_prob"
  AREA "misc128_dat"
  LABEL "Inventory Problems"
  DESCRIPTION "Contains discrepancy records."
  DUMP-NAME "inv_prob"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_invprb.t" CRC "?" 

ADD FIELD "wh_num" OF "inv_prob" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 50
  MANDATORY

ADD FIELD "trans_type" OF "inv_prob" AS character 
  FORMAT "x(2)"
  INITIAL ?
  LABEL "Transaction Type"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "trans type"
  VALMSG "Transaction type must be defined first ."
  HELP "This transaction type (you don't want to modify this...)."
  ORDER 30

ADD FIELD "trans_num" OF "inv_prob" AS integer 
  DESCRIPTION "This is a link into the transactions table, that tells us which transaction generated this discrepancy."
  FORMAT ">>>>>>>>9"
  INITIAL ?
  LABEL "Transaction Number"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "trans #"
  HELP "Transaction number."
  ORDER 20
  MANDATORY

ADD FIELD "printed" OF "inv_prob" AS logical 
  DESCRIPTION "When this record has been printed, it is ready to be deleted."
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Printed"
  POSITION 5
  MAX-WIDTH 1
  ORDER 180
  MANDATORY

ADD FIELD "pallet_id" OF "inv_prob" AS character 
  DESCRIPTION "Pallet where stuff was actually processed. Use only when relevant."
  FORMAT "x(17)"
  INITIAL ?
  LABEL "Pallet Id"
  POSITION 6
  MAX-WIDTH 34
  ORDER 80

ADD FIELD "lot" OF "inv_prob" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Lot"
  POSITION 7
  MAX-WIDTH 48
  HELP "Lot Number."
  ORDER 130

ADD FIELD "item_num" OF "inv_prob" AS character 
  DESCRIPTION "Catalog number, may be more than one for each abs_number."
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Catalog Number"
  POSITION 8
  MAX-WIDTH 48
  COLUMN-LABEL "item num"
  VALMSG "Item must be defined first."
  HELP "Enter this item's catalog number."
  ORDER 140
  MANDATORY

ADD FIELD "inv_prob_id" OF "inv_prob" AS integer 
  DESCRIPTION "Just so we have a key into this table's rows."
  FORMAT ">>>>>>9"
  INITIAL ?
  LABEL "Inv Problem Id"
  POSITION 9
  MAX-WIDTH 4
  COLUMN-LABEL "id"
  HELP "DO NOT EDIT THIS FIELD -- assigned automatically at creation."
  ORDER 10
  MANDATORY

ADD FIELD "exp_qty" OF "inv_prob" AS decimal 
  FORMAT ">>>,>>9.99"
  INITIAL ?
  LABEL "Expected Qty"
  POSITION 10
  MAX-WIDTH 25
  HELP "Expected Quantity."
  DECIMALS 2
  ORDER 160

ADD FIELD "exp_pallet" OF "inv_prob" AS character 
  DESCRIPTION "Pallet where stuff should have been processed. Use only when relevant."
  FORMAT "x(17)"
  INITIAL ?
  LABEL "Pallet Id"
  POSITION 11
  MAX-WIDTH 34
  ORDER 90

ADD FIELD "exp_bin" OF "inv_prob" AS character 
  DESCRIPTION "Location where stuff should have been processed. Not relevant for receivals. "
  FORMAT "x(10)"
  INITIAL ?
  LABEL "Expected Location"
  POSITION 12
  MAX-WIDTH 20
  ORDER 70

ADD FIELD "custom_data" OF "inv_prob" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 13
  MAX-WIDTH 510
  EXTENT 5
  ORDER 190

ADD FIELD "co_num" OF "inv_prob" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 14
  MAX-WIDTH 8
  VALMSG "Company must be defined in the Company Master table first."
  HELP "Enter the company number."
  ORDER 40

ADD FIELD "case_qty" OF "inv_prob" AS integer 
  FORMAT ">>,>>9"
  INITIAL "1"
  LABEL "Outer Pack"
  POSITION 15
  MAX-WIDTH 4
  ORDER 170

ADD FIELD "bin_num" OF "inv_prob" AS character 
  FORMAT "x(10)"
  INITIAL ?
  LABEL "Location"
  POSITION 16
  MAX-WIDTH 20
  VALMSG "Location needs to be defined first."
  HELP "Location where problem exists."
  ORDER 60

ADD FIELD "actual_qty" OF "inv_prob" AS decimal 
  FORMAT ">>>,>>9.99"
  INITIAL ?
  LABEL "Actual Qty"
  POSITION 17
  MAX-WIDTH 28
  HELP "The actual quantity for this item."
  DECIMALS 2
  ORDER 150

ADD FIELD "abs_num" OF "inv_prob" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Absolute Item Number"
  POSITION 18
  MAX-WIDTH 48
  COLUMN-LABEL "abs num"
  VALMSG "Item must be defined first."
  HELP "Enter the company-wide unique code for this item."
  ORDER 100
  MANDATORY

ADD INDEX "co_wh_type_trans" ON "inv_prob" 
  AREA "misc128_idx"
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "trans_type" ASCENDING 
  INDEX-FIELD "trans_num" ASCENDING 

ADD INDEX "co_wh_bin_abs_type" ON "inv_prob" 
  AREA "misc128_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "bin_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "trans_type" ASCENDING 

ADD INDEX "co_wh_trans" ON "inv_prob" 
  AREA "misc128_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "trans_num" ASCENDING 

ADD INDEX "id" ON "inv_prob" 
  AREA "misc128_idx"
  UNIQUE
  INDEX-FIELD "inv_prob_id" ASCENDING 

ADD TABLE "inventory"
  AREA "misc64_dat"
  LABEL "Inventory Table"
  DESCRIPTION "Contains all active inventory."
  DUMP-NAME "inventor"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_invent.t" CRC "?" 
  TABLE-TRIGGER "Delete" NO-OVERRIDE PROCEDURE "d_invent.t" CRC "?" 
  TABLE-TRIGGER "Write" NO-OVERRIDE PROCEDURE "w_invent.t" CRC "?" 

ADD FIELD "cycle_cnum" OF "inventory" AS integer 
  DESCRIPTION "Enter the current cycle count number.                                                                                                       "
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Current Count Number"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "Count No."
  VALMSG "Enter the current cycle count number."
  HELP "Enter the current cycle count number."
  ORDER 380

ADD FIELD "wh_num" OF "inventory" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 3
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "vendor_id" OF "inventory" AS character 
  FORMAT "X(9)"
  INITIAL ""
  LABEL "Vendor ID"
  POSITION 4
  MAX-WIDTH 18
  HELP "Vendor ID"
  ORDER 260
  MANDATORY

ADD FIELD "uom" OF "inventory" AS character 
  DESCRIPTION "UOM e.g.: EA, BX, CT"
  FORMAT "X(4)"
  INITIAL ""
  LABEL "Unit of Measure"
  POSITION 5
  MAX-WIDTH 8
  COLUMN-LABEL "uom"
  HELP "Enter the Unit of Measure for this movement."
  ORDER 70

ADD FIELD "truck_id" OF "inventory" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Truck Id"
  POSITION 6
  MAX-WIDTH 40
  HELP "ID for the truck which brought this inventory."
  ORDER 140

ADD FIELD "total_qty" OF "inventory" AS decimal 
  FORMAT "->>>,>>9.99"
  INITIAL "0"
  LABEL "Total (includes reserved)"
  POSITION 7
  MAX-WIDTH 17
  HELP "Total quantity of this item in this bin."
  DECIMALS 2
  ORDER 110

ADD FIELD "task_id" OF "inventory" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  LABEL "Task Id"
  POSITION 8
  MAX-WIDTH 4
  ORDER 230

ADD FIELD "suggested_bin" OF "inventory" AS character 
  FORMAT "x(10)"
  INITIAL ?
  LABEL "Location"
  POSITION 9
  MAX-WIDTH 20
  HELP "Putaway location."
  ORDER 240

ADD FIELD "stock_stat" OF "inventory" AS character 
  DESCRIPTION "Allocatable stock, empty; all other codes, unallocatable."
  FORMAT "X"
  INITIAL ""
  LABEL "Stock Status"
  POSITION 10
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""OK"", "" "", ""Overage"", ""O"", ""Inv. Hold/Damage"", ""I"",
""Trans. Hold/Damage"", ""T"", ""Scrap"", ""S"", ""Liquidation"", ""L"", ""Return to
Vendor"", ""R"", ""Work In Progress"", ""W"", ""Q/A Hold"", ""Q"", ""Returns Hold"",
""H"", ""Customs Hold"", ""C"""
  HELP "The status of this stock item."
  ORDER 370
  MANDATORY

ADD FIELD "rtn_pallet_full" OF "inventory" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 11
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  HELP "Return Pallet Full?"
  ORDER 210

ADD FIELD "rtn_category" OF "inventory" AS character 
  DESCRIPTION "Used only for liquidation items."
  FORMAT "X(4)"
  INITIAL ?
  LABEL "Returns Category"
  POSITION 12
  MAX-WIDTH 8
  HELP "Return category for this stock."
  ORDER 200

ADD FIELD "reserved_qty" OF "inventory" AS decimal 
  FORMAT "->>>,>>9.99"
  INITIAL "0"
  LABEL "Reserved"
  POSITION 13
  MAX-WIDTH 17
  HELP "Quantity of this item that is allocated for picking."
  DECIMALS 2
  ORDER 120

ADD FIELD "qa_release_id" OF "inventory" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "QA Release ID"
  POSITION 14
  MAX-WIDTH 4
  ORDER 340

ADD FIELD "po_suffix" OF "inventory" AS character 
  FORMAT "X(2)"
  INITIAL ""
  LABEL "PO Suffix"
  POSITION 15
  MAX-WIDTH 4
  ORDER 280

ADD FIELD "po_number" OF "inventory" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "PO Number"
  POSITION 16
  MAX-WIDTH 20
  ORDER 270

ADD FIELD "pallet_id" OF "inventory" AS character 
  FORMAT "x(17)"
  INITIAL ""
  LABEL "Pallet Id"
  POSITION 17
  MAX-WIDTH 34
  COLUMN-LABEL "pallet"
  ORDER 40

ADD FIELD "order_suffix" OF "inventory" AS character 
  FORMAT "X(2)"
  INITIAL ?
  LABEL "Order Suffix"
  POSITION 18
  MAX-WIDTH 4
  ORDER 330

ADD FIELD "order" OF "inventory" AS character 
  FORMAT "x(10)"
  INITIAL ?
  LABEL "Order"
  POSITION 19
  MAX-WIDTH 20
  ORDER 320

ADD FIELD "ns_comment" OF "inventory" AS character 
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Non-Stock Comment"
  POSITION 20
  MAX-WIDTH 60
  HELP "Enter a descriptive comment for this non-stock item."
  ORDER 60

ADD FIELD "lot" OF "inventory" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Lot"
  POSITION 21
  MAX-WIDTH 48
  HELP "Lot Number."
  ORDER 150

ADD FIELD "item_cost" OF "inventory" AS decimal 
  FORMAT "$>>>,>>9.99"
  INITIAL "0"
  LABEL "Cost"
  POSITION 22
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 290

ADD FIELD "id" OF "inventory" AS integer 
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Id"
  POSITION 23
  MAX-WIDTH 4
  COLUMN-LABEL "id"
  HELP "DO NOT EDIT THIS FIELD."
  ORDER 10
  MANDATORY

ADD FIELD "expiration" OF "inventory" AS date 
  DESCRIPTION "Used for lot-controlled items."
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Expiration Date"
  POSITION 24
  MAX-WIDTH 4
  HELP "Expiration date for this inventory."
  ORDER 100

ADD FIELD "emp_num" OF "inventory" AS character 
  DESCRIPTION "Employee number."
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Employee Number"
  POSITION 25
  MAX-WIDTH 12
  COLUMN-LABEL ""
  HELP "Employee who received this inventory."
  ORDER 250

ADD FIELD "date_time" OF "inventory" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Received"
  POSITION 26
  MAX-WIDTH 32
  ORDER 90
  FIELD-TRIGGER "Assign" OVERRIDE PROCEDURE "datetim.t" CRC "?" 

ADD FIELD "cycle_level" OF "inventory" AS character 
  DESCRIPTION """system"" or ""wave"""
  FORMAT "X(8)"
  INITIAL ""
  LABEL "Cycle Count Level"
  POSITION 27
  MAX-WIDTH 16
  HELP "Type of cycle count for this item (don't modify)."
  ORDER 170

ADD FIELD "cycle_id" OF "inventory" AS integer 
  FORMAT ">>>>>>9"
  INITIAL ?
  POSITION 28
  MAX-WIDTH 4
  HELP "DO NOT EDIT THIS FIELD."
  ORDER 190

ADD FIELD "cycle_flag" OF "inventory" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Cycle Flag"
  POSITION 29
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  ORDER 160
  MANDATORY

ADD FIELD "cycle_emp_num" OF "inventory" AS character 
  DESCRIPTION "So that different emps will do 1st and 2nd cycle count."
  FORMAT "x(6)"
  INITIAL ?
  LABEL "Employee Number"
  POSITION 30
  MAX-WIDTH 12
  COLUMN-LABEL "emp #"
  HELP "Employee who last cycle counted this item."
  ORDER 180

ADD FIELD "custom_data" OF "inventory" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 31
  MAX-WIDTH 510
  EXTENT 5
  ORDER 360

ADD FIELD "cross_docking" OF "inventory" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Cross Docking"
  POSITION 32
  MAX-WIDTH 1
  ORDER 310

ADD FIELD "co_num" OF "inventory" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 33
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 20

ADD FIELD "country_code" OF "inventory" AS character 
  FORMAT "XX"
  INITIAL ""
  LABEL "Country Code"
  POSITION 34
  MAX-WIDTH 4
  HELP "Country of origin."
  ORDER 300

ADD FIELD "case_qty" OF "inventory" AS integer 
  FORMAT ">>,>>9"
  INITIAL "1"
  LABEL "Outer Pack"
  POSITION 35
  MAX-WIDTH 4
  COLUMN-LABEL "o/p"
  ORDER 130

ADD FIELD "cargo_control" OF "inventory" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Cargo Control"
  POSITION 36
  MAX-WIDTH 48
  ORDER 350

ADD FIELD "bin_num" OF "inventory" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Location"
  POSITION 37
  MAX-WIDTH 20
  HELP "Inventory location."
  ORDER 80
  MANDATORY

ADD FIELD "attributes" OF "inventory" AS character 
  DESCRIPTION "Additional attributes (probably don't display this field)."
  FORMAT "x(8)"
  INITIAL ?
  POSITION 38
  MAX-WIDTH 16
  HELP "Additional attributes (used for receiving)."
  ORDER 220

ADD FIELD "abs_num" OF "inventory" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Item Number"
  POSITION 39
  MAX-WIDTH 48
  HELP "Enter the company-wide unique code for this item."
  ORDER 50
  MANDATORY

ADD INDEX "co_wh_abs_fifo" ON "inventory" 
  AREA "misc64_idx"
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "date_time" ASCENDING 

ADD INDEX "cargocontrol" ON "inventory" 
  AREA "misc64_idx"
  INDEX-FIELD "cargo_control" ASCENDING 

