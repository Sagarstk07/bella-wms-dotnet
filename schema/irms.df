  WORD
  INDEX-FIELD "ship_name" ASCENDING 

ADD INDEX "shipzip" ON "ordhdr" 
  AREA "misc32_idx"
  INDEX-FIELD "ship_zip" ASCENDING 

ADD INDEX "wave_group" ON "ordhdr" 
  AREA "misc32_idx"
  INDEX-FIELD "wave_group" ASCENDING 

ADD TABLE "ordhdr_status"
  AREA "misc256_dat"
  LABEL "Order Header Status lookup"
  DESCRIPTION "A lookup table which contains the valid ""status"" levels for
whole orders (compare with orddtl_status).
"
  DUMP-NAME "ordhdr_s"

ADD FIELD "sequence" OF "ordhdr_status" AS integer 
  FORMAT "->>9"
  INITIAL "0"
  LABEL "Status Sequence"
  POSITION 2
  MAX-WIDTH 4
  COLUMN-LABEL "sequence"
  VALMSG "Please enter a non-zero value."
  HELP "Please enter the sequence value for this status."
  ORDER 30
  MANDATORY

ADD FIELD "name" OF "ordhdr_status" AS character 
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Status Name"
  POSITION 3
  MAX-WIDTH 24
  COLUMN-LABEL "name"
  VALMSG "Please enter a name for this status."
  HELP "Please enter a name for this status."
  ORDER 10
  MANDATORY

ADD FIELD "custom_data" OF "ordhdr_status" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 4
  MAX-WIDTH 510
  EXTENT 5
  ORDER 40

ADD FIELD "code" OF "ordhdr_status" AS character 
  FORMAT "X"
  INITIAL ""
  LABEL "Status Code"
  POSITION 5
  MAX-WIDTH 2
  COLUMN-LABEL "code"
  VALMSG "Please enter a Status Code."
  HELP "Please enter a Status Code."
  ORDER 20
  MANDATORY

ADD INDEX "code" ON "ordhdr_status" 
  AREA "misc256_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "code" ASCENDING 

ADD INDEX "name" ON "ordhdr_status" 
  AREA "misc256_idx"
  UNIQUE
  INDEX-FIELD "name" ASCENDING 

ADD INDEX "sequence" ON "ordhdr_status" 
  AREA "misc256_idx"
  UNIQUE
  INDEX-FIELD "sequence" ASCENDING 

ADD TABLE "package_type"
  AREA "unused_dat"
  LABEL "Package Type"
  DESCRIPTION "Stores different kinds of packages known to the system (box, envelope, etc.)"
  DUMP-NAME "pkg_type"

ADD FIELD "short_name" OF "package_type" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "Short Name"
  POSITION 2
  MAX-WIDTH 20
  ORDER 20

ADD FIELD "package_code" OF "package_type" AS character 
  DESCRIPTION "1-character code for the package type."
  FORMAT "X"
  INITIAL ?
  LABEL "Package Code"
  POSITION 3
  MAX-WIDTH 2
  ORDER 10

ADD FIELD "description" OF "package_type" AS character 
  FORMAT "X(30)"
  INITIAL ?
  LABEL "Description"
  POSITION 4
  MAX-WIDTH 60
  ORDER 30

ADD INDEX "code" ON "package_type" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "package_code" ASCENDING 

ADD TABLE "palletdet"
  AREA "misc128_dat"
  LABEL "Pallet Detail Table"
  DESCRIPTION "Used during receival, to build pallets for put-away."
  DUMP-NAME "palletde"

ADD FIELD "uom" OF "palletdet" AS character 
  DESCRIPTION "UOM e.g.: EA, BX, CT"
  FORMAT "X(4)"
  INITIAL ?
  LABEL "Unit of Measure"
  POSITION 2
  MAX-WIDTH 8
  COLUMN-LABEL "uom"
  HELP "Enter the Unit of Measure for this item."
  ORDER 120

ADD FIELD "truck_id" OF "palletdet" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Truck Id"
  POSITION 3
  MAX-WIDTH 40
  HELP "ID for the truck which brought this inventory."
  ORDER 150

ADD FIELD "stock_stat" OF "palletdet" AS character 
  FORMAT "X"
  INITIAL ""
  LABEL "Stock Status"
  POSITION 4
  MAX-WIDTH 2
  HELP "The status of this stock item."
  ORDER 90

ADD FIELD "row_status" OF "palletdet" AS character 
  FORMAT "X"
  INITIAL "O"
  LABEL "Status"
  POSITION 5
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS 
    ""Open"", ""O"",
    ""Active"", ""A"",
    ""Complete"", ""C"""
  COLUMN-LABEL "status"
  HELP "The status for this putaway item."
  ORDER 160
  MANDATORY

ADD FIELD "quantity" OF "palletdet" AS decimal 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Quantity"
  POSITION 6
  MAX-WIDTH 17
  HELP "Quantity."
  DECIMALS 2
  ORDER 50

ADD FIELD "pick_id" OF "palletdet" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "Pick Id"
  POSITION 7
  MAX-WIDTH 20
  ORDER 15

ADD FIELD "pallet_num" OF "palletdet" AS integer 
  DESCRIPTION "Unique pallet identifier supplied by the system (sequence pallet_num)."
  FORMAT "ZZZZZZZZZ9"
  INITIAL "0"
  LABEL "Pallet Number"
  POSITION 8
  MAX-WIDTH 4
  HELP "Don't edit this field; it's assigned by the system."
  ORDER 10
  MANDATORY

ADD FIELD "ns_comment" OF "palletdet" AS character 
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Non-Stock Comment"
  POSITION 9
  MAX-WIDTH 60
  HELP "Enter a descriptive comment for this non-stock item."
  ORDER 40

ADD FIELD "lot" OF "palletdet" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Lot"
  POSITION 10
  MAX-WIDTH 48
  HELP "Lot Number."
  ORDER 30

ADD FIELD "emp_num" OF "palletdet" AS character 
  DESCRIPTION "Employee number (e.g.: for ""R"" pallet, employee who received this)."
  FORMAT "x(5)"
  INITIAL ""
  LABEL "Employee Number"
  POSITION 11
  MAX-WIDTH 10
  HELP "Employee number."
  ORDER 70
  MANDATORY

ADD FIELD "date_time" OF "palletdet" AS character 
  DESCRIPTION "Don't edit this field."
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Date and Time"
  POSITION 12
  MAX-WIDTH 32
  HELP "Time stamp."
  ORDER 60
  FIELD-TRIGGER "Assign" OVERRIDE PROCEDURE "datetim.t" CRC "?" 

ADD FIELD "custom_data" OF "palletdet" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 13
  MAX-WIDTH 510
  EXTENT 5
  ORDER 140

ADD FIELD "case_qty" OF "palletdet" AS integer 
  FORMAT ">>,>>9"
  INITIAL "1"
  LABEL "Outer Pack"
  POSITION 14
  MAX-WIDTH 4
  COLUMN-LABEL "o/p"
  ORDER 130

ADD FIELD "bin_num" OF "palletdet" AS character 
  DESCRIPTION "Location ""reserved"" for this putaway."
  FORMAT "x(10)"
  INITIAL ?
  LABEL "Location"
  POSITION 15
  MAX-WIDTH 20
  ORDER 80

ADD FIELD "abs_num" OF "palletdet" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Absolute Item Number"
  POSITION 16
  MAX-WIDTH 48
  COLUMN-LABEL "abs num"
  HELP "Absolute number of item on pallet."
  ORDER 20
  MANDATORY

ADD INDEX "pallet_abs" ON "palletdet" 
  AREA "misc128_idx"
  PRIMARY
  INDEX-FIELD "pallet_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 

ADD INDEX "abs" ON "palletdet" 
  AREA "misc128_idx"
  INDEX-FIELD "abs_num" ASCENDING 

ADD TABLE "palletmst"
  AREA "misc128_dat"
  LABEL "Pallet Master table"
  DESCRIPTION "Track unique pallets."
  DUMP-NAME "palletms"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_pallet.t" CRC "?" 

ADD FIELD "wh_zone" OF "palletmst" AS character 
  FORMAT "XX"
  INITIAL ?
  LABEL "Warehouse Zone"
  POSITION 2
  MAX-WIDTH 13
  HELP "Zone (for receipts)"
  ORDER 50

ADD FIELD "wh_num" OF "palletmst" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 3
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "tracking_id" OF "palletmst" AS character 
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Tracking ID"
  POSITION 4
  MAX-WIDTH 60
  HELP "Enter the Tracking Number."
  ORDER 45

ADD FIELD "row_status" OF "palletmst" AS character 
  DESCRIPTION "Open, Active, Complete"
  FORMAT "X"
  INITIAL "O"
  LABEL "Status"
  POSITION 5
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS 
    ""Open"", ""O"",
    ""Active"", ""A"",
    ""Complete"", ""C"""
  COLUMN-LABEL "status"
  HELP "The status of this pallet."
  ORDER 110
  MANDATORY

ADD FIELD "pallet_type" OF "palletmst" AS character 
  DESCRIPTION "pallet types as of 2apr95
RN = normal receipt, RB = receive back-orders, RO = receive overage, RD = receive damaged
SN = normal shipping"
  FORMAT "x(2)"
  INITIAL ""
  LABEL "Pallet Type"
  POSITION 6
  MAX-WIDTH 4
  VIEW-AS ""
  HELP "This pallet's type."
  ORDER 70
  MANDATORY

ADD FIELD "pallet_num" OF "palletmst" AS integer 
  DESCRIPTION "Unique pal id (sequence pallet_num) will be used for SCM."
  FORMAT "ZZZZZZZZZ9"
  INITIAL "0"
  LABEL "Pallet Number"
  POSITION 7
  MAX-WIDTH 4
  HELP "Don't edit this field; it's assigned by the system."
  ORDER 10
  MANDATORY

ADD FIELD "pallet_id" OF "palletmst" AS character 
  DESCRIPTION "Pallet id. In All-phase, it's a pre-printed ""license plate"" label. Anyway, it's unique inside a warehouse."
  FORMAT "x(17)"
  INITIAL ""
  LABEL "Pallet Id"
  POSITION 8
  MAX-WIDTH 34
  COLUMN-LABEL "pallet"
  HELP "Enter the pallet id."
  ORDER 40

ADD FIELD "full" OF "palletmst" AS logical 
  DESCRIPTION "When this field is true, no more receivals will be put on this pallet."
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Skid Full"
  POSITION 9
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this pallet full?"
  ORDER 60
  MANDATORY

ADD FIELD "custom_data" OF "palletmst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 510
  EXTENT 5
  ORDER 100

ADD FIELD "co_num" OF "palletmst" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 11
  MAX-WIDTH 8
  VALMSG "Company must be defined in the Company Master table first."
  HELP "Enter the company number."
  ORDER 20

ADD FIELD "cart_id" OF "palletmst" AS character 
  DESCRIPTION "Used to store the cart id during cart picking operations involving the"
  FORMAT "x(17)"
  INITIAL ?
  LABEL "Cart ID"
  POSITION 12
  MAX-WIDTH 34
  HELP "Cart ID"
  ORDER 80

ADD FIELD "cart_bin" OF "palletmst" AS character 
  DESCRIPTION "Used to store the bin within the cart during cart picking operations i"
  FORMAT "x(10)"
  INITIAL ?
  LABEL "Cart Bin"
  POSITION 13
  MAX-WIDTH 20
  HELP "Cart Bin"
  ORDER 90

ADD INDEX "co_wh_pallet" ON "palletmst" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  DESCRIPTION "Enforce uniqueness for pallet id."
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "pallet_id" ASCENDING 

ADD INDEX "co_wh_cartid_cartbin_pallet" ON "palletmst" 
  AREA "misc128_idx"
  UNIQUE
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "cart_id" ASCENDING 
  INDEX-FIELD "cart_bin" ASCENDING 
  INDEX-FIELD "pallet_id" ASCENDING 

ADD INDEX "co_wh_tracking" ON "palletmst" 
  AREA "misc128_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "tracking_id" ASCENDING 

ADD INDEX "num" ON "palletmst" 
  AREA "misc128_idx"
  UNIQUE
  DESCRIPTION "Enforce uniqueness of the pallet_num field."
  INDEX-FIELD "pallet_num" ASCENDING 

ADD TABLE "parameters"
  AREA "misc128_dat"
  LABEL "System Parameters"
  DESCRIPTION "This table has parameters for system level (co_num eq 0,
wh_num eq 0), company level (co_num ne 0, wh_num eq 0) and
warehouse level (co_num ne 0, wh_num ne 0). IRMS will be
shipped with the system level defaults set. Other defaults
"
  DUMP-NAME "paramete"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_param.t" CRC "?" 
  TABLE-TRIGGER "Delete" NO-OVERRIDE PROCEDURE "d_param.t" CRC "?" 
  TABLE-TRIGGER "Write" NO-OVERRIDE PROCEDURE "w_param.t" CRC "?" 

ADD FIELD "wh_type" OF "parameters" AS character 
  DESCRIPTION "Warehouse type: RF-based or Paper-based."
  FORMAT "X"
  INITIAL "R"
  LABEL "Warehouse Type"
  POSITION 2
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS RF-based, ""R"" , Paper-based, ""P""
  "
  HELP "RF or Paper based warehouse?"
  ORDER 30
  MANDATORY

ADD FIELD "wh_num" OF "parameters" AS character 
  DESCRIPTION "Warehouse Number  (company 0, warehouse 0 is used for the initial system-wide defaults)."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 3
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "shp_hold_flag" OF "parameters" AS character 
  DESCRIPTION "If yes, only ship complete orders. If no, allow shipping partial orders."
  FORMAT "X"
  INITIAL "Y"
  LABEL "Hold to Complete"
  POSITION 4
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Yes"", ""Y"", ""No"", ""N"""
  HELP "Hold Order until it is complete?"
  ORDER 180
  MANDATORY

ADD FIELD "shp_force_flag" OF "parameters" AS character 
  DESCRIPTION "If yes, allow people to pick and ship more than what was ordered (for example, so that we pick and ship a complete pack)."
  FORMAT "X"
  INITIAL "N"
  LABEL "Allow Force Shipping"
  POSITION 5
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Yes"", ""Y"", ""No"", ""N"""
  HELP "Allow Force Shipping?"
  ORDER 190
  MANDATORY

ADD FIELD "row_status" OF "parameters" AS logical 
  DESCRIPTION "Parameters: active or inactive (this will be ignored in the case of th"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 6
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Should IRMS use this set of parameters?"
  ORDER 220
  MANDATORY

ADD FIELD "rcv_rma_prefix" OF "parameters" AS character 
  DESCRIPTION "Prefix to distinguish a R/T used for RMA"
  FORMAT "X(2)"
  INITIAL "R"
  LABEL "RMA Prefix"
  POSITION 7
  MAX-WIDTH 4
  HELP "Prefix for R/Ts used for returns"
  ORDER 70

ADD FIELD "rcv_qty_check" OF "parameters" AS character 
  DESCRIPTION "Check the quantity received at each line or at the end of the whole receipt."
  FORMAT "X"
  INITIAL "L"
  LABEL "Line Item Qty Check"
  POSITION 8
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Each line"", ""L"", ""End of Receipt"", ""E""
"
  HELP "Check quantity received at each line or at end of receipt?"
  ORDER 50
  MANDATORY

ADD FIELD "rcv_pallet_id_flag" OF "parameters" AS character 
  DESCRIPTION "Pallet Id, either Pre-printed or System-assigned."
  FORMAT "X"
  INITIAL "S"
  LABEL "Pallet Id Flag"
  POSITION 9
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""System-Assigned"", ""S"", ""Pre-printed"", ""P""
"
  HELP "Pallet ""license plates"": pre-printed or assigned by IRMS?"
  ORDER 40
  MANDATORY

ADD FIELD "rcv_back_orders" OF "parameters" AS character 
  DESCRIPTION "Decision on processing back orders at the receiving dock is made automatically or manually."
  FORMAT "X"
  INITIAL "A"
  LABEL "Back Orders Processing"
  POSITION 10
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Automatic"", ""A"", ""Manual"", ""M"""
  HELP "Decision on how to process back orders: automatic or manual?"
  ORDER 60
  MANDATORY

ADD FIELD "pic_release_time" OF "parameters" AS character 
  DESCRIPTION "Order release cutoff time (only meaningful when order releases are done automatically)."
  FORMAT "99:99"
  INITIAL "1600"
  LABEL "Order Release Cutoff"
  POSITION 11
  MAX-WIDTH 10
  VIEW-AS "VIEW-AS FILL-IN"
  HELP "Enter a cutoff time for automatic order release."
  ORDER 110
  MANDATORY
  FIELD-TRIGGER "Assign" NO-OVERRIDE PROCEDURE "time.t" CRC "?" 

ADD FIELD "pic_release_flag" OF "parameters" AS character 
  DESCRIPTION "Release orders automatically (based on the cutoff time), or manually?"
  FORMAT "X"
  INITIAL "M"
  LABEL "Order Release Flag"
  POSITION 12
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Auto"", ""A"", ""Manual"", ""M"""
  HELP "Release orders: automatically or manually?"
  ORDER 100
  MANDATORY

ADD FIELD "pic_label_flag" OF "parameters" AS character 
  DESCRIPTION "Pick labels: pre-printed (by supervisor) or on-demand (on location)?"
  FORMAT "X"
  INITIAL "P"
  LABEL "Print Pick Labels"
  POSITION 13
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Pre-printed"", ""P"", ""On-demand"", ""O"""
  HELP "Pick labels: pre-printed or on-demand?"
  ORDER 140
  MANDATORY

ADD FIELD "pic_hold_types" OF "parameters" AS character 
  DESCRIPTION "Types of orders to hold (one character per type)."
  FORMAT "x(8)"
  INITIAL ""
  POSITION 14
  MAX-WIDTH 16
  HELP "Types of orders to hold (one character per type)."
  ORDER 130
  MANDATORY

ADD FIELD "pic_hold_lines" OF "parameters" AS integer 
  DESCRIPTION "Hold any order with more than this number of lines."
  FORMAT ">>9"
  INITIAL "25"
  LABEL "Large Orders To Hold"
  POSITION 15
  MAX-WIDTH 4
  VIEW-AS "VIEW-AS FILL-IN"
  VALMSG "Enter a positive number."
  HELP "Hold any order with more than this number of lines."
  ORDER 120

ADD FIELD "pic_from_dock" OF "parameters" AS character 
  DESCRIPTION "Allow picking from the ""STG"" locations, that is, from stuff that hasn't been put-away yet?"
  FORMAT "X"
  INITIAL "N"
  LABEL "Pick From Dock"
  POSITION 16
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Yes"", ""Y"", ""No"", ""N"""
  HELP "Allow picking from the receiving dock?"
  ORDER 150
  MANDATORY

ADD FIELD "phys_adj_code_out" OF "parameters" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Phys Adj Out"
  POSITION 17
  MAX-WIDTH 12
  ORDER 310

ADD FIELD "phys_adj_code_in" OF "parameters" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Phys Adj In"
  POSITION 18
  MAX-WIDTH 12
  ORDER 300

ADD FIELD "phys_adj" OF "parameters" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Phys. Adj"
  POSITION 19
  MAX-WIDTH 1
  ORDER 270

ADD FIELD "physical_flag" OF "parameters" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Physical In Progress"
  POSITION 20
  MAX-WIDTH 1
  HELP "Is there a physical inventory in progress?"
  ORDER 200

ADD FIELD "pac_type" OF "parameters" AS character 
  DESCRIPTION """Pick-to-pack"" means pick directly into the boxes where the stuff will be shipped. ""Pick-to-tote"" means pick into some other container, then take the stuff to a packing station to be boxed."
  FORMAT "X"
  INITIAL "P"
  LABEL "Packing Type"
  POSITION 21
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Pick-to-pack"", ""P"", ""Pick-to-tote"", ""T"""
  HELP "Pick-to-pack or pick-to-tote?"
  ORDER 160
  MANDATORY

ADD FIELD "pac_list_flag" OF "parameters" AS character 
  DESCRIPTION "Packing list generated by box, by order, or by customer."
  FORMAT "X"
  INITIAL "B"
  LABEL "Packing List By"
  POSITION 22
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Box"", ""B"", ""Order"", ""O"", ""Customer"", ""C"""
  HELP "Packing list: by box, by order, or by customer?"
  ORDER 170
  MANDATORY

ADD FIELD "mat_repl_flag" OF "parameters" AS character 
  DESCRIPTION "Replenishment requests made on demand, or else replenishment is done as a batch processing, probably at night."
  FORMAT "X"
  INITIAL "O"
  LABEL "Replenishment"
  POSITION 23
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""On Demand"", ""O"", ""Batch"", ""B"""
  HELP "Start replenishments on demand, or as a separate batch process?"
  ORDER 90
  MANDATORY

ADD FIELD "mat_put_away" OF "parameters" AS character 
  DESCRIPTION "This field indicates if the warehouse uses random or directed put away."
  FORMAT "X"
  INITIAL "D"
  LABEL "Material Put Away"
  POSITION 24
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""Directed"", ""D"", ""Non-directed"", ""N"""
  HELP "Put Away: Directed or Non-Directed?"
  ORDER 80
  MANDATORY

ADD FIELD "emp_num" OF "parameters" AS character 
  DESCRIPTION "Added by trigger, for audit trail"
  FORMAT "x(5)"
  INITIAL ""
  LABEL "Employee Number"
  POSITION 25
  MAX-WIDTH 10
  HELP "Employee who last modified these parameters"
  ORDER 230

ADD FIELD "display_phys_qty" OF "parameters" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Display Qty"
  POSITION 26
  MAX-WIDTH 1
  ORDER 250

ADD FIELD "display_cycle_qty" OF "parameters" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Display C.C."
  POSITION 27
  MAX-WIDTH 1
  ORDER 240

ADD FIELD "date_time" OF "parameters" AS character 
  DESCRIPTION "Time stamp for this particular activity."
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Time Stamp"
  POSITION 28
  MAX-WIDTH 32
  HELP "Last time these parameters were modified"
  ORDER 320

ADD FIELD "cycle_adj_code_out" OF "parameters" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "CC Adj Out"
  POSITION 29
  MAX-WIDTH 12
  ORDER 290

ADD FIELD "cycle_adj_code_in" OF "parameters" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "CC Adj In"
  POSITION 30
  MAX-WIDTH 12
  ORDER 280

ADD FIELD "cycle_adj" OF "parameters" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "C.C. Adj"
  POSITION 31
  MAX-WIDTH 1
  ORDER 260

ADD FIELD "custom_data" OF "parameters" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 32
  MAX-WIDTH 510
  EXTENT 5
  ORDER 330

ADD FIELD "co_num" OF "parameters" AS character 
  DESCRIPTION "Company Number (company 0, warehouse 0 is used for the initial system-wide defaults)."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 33
  MAX-WIDTH 8
  VALMSG "Company must be defined in Company Master table first."
  HELP "Enter the company number."
  ORDER 10
  MANDATORY

ADD FIELD "comments" OF "parameters" AS character 
  DESCRIPTION "Just a scratchpad so that we can store pertinent comments (for instance, if this record was re-created from defaults, when did this happen?)."
  FORMAT "x(65)"
  INITIAL ""
  LABEL "Comments"
  POSITION 34
  MAX-WIDTH 130
  HELP "You may enter any comments here, if you wish."
  ORDER 210

ADD INDEX "co_wh" ON "parameters" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  DESCRIPTION "Unique index by company and warehouse numbers."
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 

ADD TABLE "parcel_rate"
  AREA "unused_dat"
  LABEL "Parcel Rate Master"
  DESCRIPTION "This table will used to calculate or retrieve the shipping rate for a particular carrier based on order weight and to-zone."
  DUMP-NAME "parcel_r"

ADD FIELD "zone" OF "parcel_rate" AS character 
  FORMAT "X(3)"
  INITIAL ""
  LABEL "Zone"
  POSITION 2
  MAX-WIDTH 6
  HELP "Zone."
  ORDER 50

ADD FIELD "wh_num" OF "parcel_rate" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 3
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20

ADD FIELD "rate_type" OF "parcel_rate" AS character 
  FORMAT "X"
  INITIAL "P"
  LABEL "Rate Type"
  POSITION 4
  MAX-WIDTH 2
  VIEW-AS "view-as radio-set radio-buttons
""Absolute"",""A"", ""Per Weight"",""P"""
  ORDER 90

ADD FIELD "rate" OF "parcel_rate" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Rate"
  POSITION 5
  MAX-WIDTH 17
  HELP "Rate."
  DECIMALS 2
  ORDER 80

ADD FIELD "max_weight" OF "parcel_rate" AS integer 
  DESCRIPTION "Upper boundary for this rate."
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Maximum Weight"
  POSITION 6
  MAX-WIDTH 4
  HELP "Maximum Weight"
  ORDER 70

ADD FIELD "co_num" OF "parcel_rate" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 7
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10

ADD FIELD "carrier_service" OF "parcel_rate" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "Carrier Service"
  POSITION 8
  MAX-WIDTH 20
  ORDER 40

ADD FIELD "carrier_id" OF "parcel_rate" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Carrier Id"
  POSITION 9
  MAX-WIDTH 12
  HELP "Carrier ID"
  ORDER 30
  MANDATORY

ADD INDEX "co_wh_carrier_service_zone_weigh" ON "parcel_rate" 
  AREA "unused_idx"
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "carrier_id" ASCENDING 
  INDEX-FIELD "carrier_service" ASCENDING 
  INDEX-FIELD "zone" ASCENDING 
  INDEX-FIELD "max_weight" ASCENDING 

ADD TABLE "parcel_value"
  AREA "unused_dat"
