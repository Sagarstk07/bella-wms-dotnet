  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Check Quantity"
  POSITION 29
  MAX-WIDTH 1
  HELP "Check inventory quantity in the locations for this zone?"
  ORDER 270
  MANDATORY

ADD FIELD "bin_num" OF "binmst" AS character 
  FORMAT "x(10)"
