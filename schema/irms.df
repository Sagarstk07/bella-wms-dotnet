ADD TABLE "qc_inspection"
  AREA "unused_dat"
  LABEL "QC Inspection"
  DESCRIPTION "Quality Control Inspection configurations.                     "
  DUMP-NAME "qcinspec"

ADD FIELD "char_3" OF "qc_inspection" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 2
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 100

ADD FIELD "char_2" OF "qc_inspection" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 3
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 90

ADD FIELD "char_1" OF "qc_inspection" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 4
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 80

ADD FIELD "extended_pull" OF "qc_inspection" AS integer 
  DESCRIPTION "Stores the extended inspection pull quantity.                                                                                               "
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Extended Pull"
  POSITION 5
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Ext. Pull"
  HELP "Enter the extended inspection pull quantity."
  ORDER 70

ADD FIELD "regular_pull" OF "qc_inspection" AS integer 
  DESCRIPTION "Stores the standard inspection pull quantity.                                                                                               "
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Regular Pull"
  POSITION 6
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Reg. Pull"
  HELP "Enter the standard inspection pull quantity."
  ORDER 60

ADD FIELD "max_rec_cartons" OF "qc_inspection" AS integer 
  DESCRIPTION "Stores the maximum number of receiving cartons required to qualify.                                                                         "
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Max Rec Cartons"
  POSITION 7
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Max Rec Cartons"
  HELP "Enter the maximum number of receiving cartons required."
  ORDER 50

ADD FIELD "min_rec_cartons" OF "qc_inspection" AS integer 
  DESCRIPTION "Stores the minimum number of receiving cartons required to qualify.                                                                         "
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Min Rec Cartons"
  POSITION 8
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Min Rec Cartons"
  HELP "Enter the minimum number of receiving cartons required."
  ORDER 40

ADD FIELD "inspection_code" OF "qc_inspection" AS character 
  DESCRIPTION "Stores the Inspection Code for the record.                                                                                                  "
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Inspection Code"
  POSITION 9
  MAX-WIDTH 20
  VIEW-AS ""
  COLUMN-LABEL "Inspect Code"
  HELP "Enter the Inspection Code for this record."
  ORDER 30

ADD FIELD "wh_num" OF "qc_inspection" AS character 
  DESCRIPTION "Stores the Warehouse Number for the record.                                                                                                 "
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 10
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Whse"
  HELP "Enter the Warehouse Number for this record."
  ORDER 20

ADD FIELD "co_num" OF "qc_inspection" AS character 
  DESCRIPTION "Stores the company that the record resides in.                                                                                              "
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 11
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Company"
  HELP "Enter the company that this record belongs to."
  ORDER 10

ADD INDEX "inspection_code" ON "qc_inspection" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "inspection_code" ASCENDING 

ADD INDEX "min_max" ON "qc_inspection" 
  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "min_rec_cartons" ASCENDING 
  INDEX-FIELD "max_rec_cartons" ASCENDING 

ADD TABLE "query_store"
  AREA "unused_dat"
  DESCRIPTION "Holds query information.                                       "
  DUMP-NAME "querst"

ADD FIELD "description" OF "query_store" AS character 
  DESCRIPTION "Describes the purpose of the query.                                                                                                         "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Description"
  POSITION 2
  MAX-WIDTH 16
  HELP "Enter the description for this query."
  ORDER 40

ADD FIELD "table_list" OF "query_store" AS character 
  DESCRIPTION "Describes the table list to be used in the query.                                                                                           "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Table List"
  POSITION 3
  MAX-WIDTH 16
  HELP "Enter the table list to be used in the query."
  ORDER 30

ADD FIELD "field_list" OF "query_store" AS character 
  DESCRIPTION "Describes the fields pulled back in the query.                                                                                              "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Field List"
  POSITION 4
  MAX-WIDTH 16
  HELP "Enter the fields to be displayed."
  ORDER 20

ADD FIELD "query_string" OF "query_store" AS character 
  DESCRIPTION "Describes the query that will be used.                                                                                                      "
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Query String"
  POSITION 5
  MAX-WIDTH 16
  HELP "Enter the query string to be used."
  ORDER 10

ADD INDEX "main_key" ON "query_store" 
  AREA "unused_idx"
  PRIMARY
  INDEX-FIELD "table_list" ASCENDING 

ADD TABLE "rblayout_cols"
  AREA "misc128_dat"
  DESCRIPTION "Describes the layout of report builder reports.                "
  DUMP-NAME "rblyt"

ADD FIELD "default_value" OF "rblayout_cols" AS character 
  DESCRIPTION "Describes the default value for this column.                                                                                                "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Default Value"
  POSITION 2
  MAX-WIDTH 48
  HELP "Enter the default value to be displayed for this column."
  ORDER 70

ADD FIELD "ReportName" OF "rblayout_cols" AS character 
  DESCRIPTION "Describes the report name for this report.                                                                                                  "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Report Name"
  POSITION 3
  MAX-WIDTH 52
  HELP "Enter the report name for this report."
  ORDER 60

ADD FIELD "field_index" OF "rblayout_cols" AS integer 
  DESCRIPTION "Describes which column this field is displayed in.                                                                                          "
  FORMAT "999"
  INITIAL "0"
  LABEL "Field Index"
  POSITION 4
  MAX-WIDTH 4
  HELP "Enter the display index of the field."
  ORDER 50

ADD FIELD "field_totals" OF "rblayout_cols" AS character 
  DESCRIPTION "Describes the field to be totalled.                                                                                                         "
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Field Totals"
  POSITION 5
  MAX-WIDTH 26
  HELP "Enter the fields to be totalled."
  ORDER 40

ADD FIELD "field_title" OF "rblayout_cols" AS character 
  DESCRIPTION "Describes the field title to be displayed for the column.                                                                                   "
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Field Title"
  POSITION 6
  MAX-WIDTH 26
  HELP "Enter the field title to be displayed."
  ORDER 30

ADD FIELD "field_id" OF "rblayout_cols" AS character 
  DESCRIPTION "Describes a column being displayed in the report builder.                                                                                   "
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Field ID"
  POSITION 7
  MAX-WIDTH 52
  HELP "Enter the field id for this column."
  ORDER 20

ADD FIELD "ReportID" OF "rblayout_cols" AS integer 
  DESCRIPTION "Describes the report id.                                                                                                                    "
  FORMAT ">>>>>>>9"
  INITIAL "0"
  LABEL "Report ID"
  POSITION 8
  MAX-WIDTH 4
  HELP "Enter the report id."
  ORDER 10

ADD INDEX "main_sort" ON "rblayout_cols" 
  AREA "misc128_idx"
  PRIMARY
  INDEX-FIELD "ReportID" ASCENDING 
  INDEX-FIELD "ReportName" ASCENDING 
  INDEX-FIELD "field_index" ASCENDING 

