ADD FIELD "custom_data" OF "venddetail" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 12
  MAX-WIDTH 510
  EXTENT 5
  ORDER 140

ADD FIELD "co_num" OF "venddetail" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 13
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10

ADD FIELD "country_code" OF "venddetail" AS character 
  FORMAT "XX"
  INITIAL ""
  LABEL "Country Code"
  POSITION 14
  MAX-WIDTH 4
