  MANDATORY

ADD FIELD "custom_data" OF "ship_zone" AS character 
  FORMAT "x(50)"
  INITIAL ?
  LABEL ""
  POSITION 4
  MAX-WIDTH 510
  COLUMN-LABEL ""
  HELP "Enter custom data."
