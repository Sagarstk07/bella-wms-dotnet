  ORDER 110

ADD FIELD "loc_type" OF "binmst" AS character 
  DESCRIPTION """Stage"", ""T"",
""Shelf"", ""S"",
""Pallet"", ""P"",
""Flow Rack"", ""F"",
""Bulk"", ""B"",
""Department"", ""D"",
""Carousel"",""C"""
  FORMAT "x"
  INITIAL "P"
  LABEL "Location Type"
  POSITION 23
  MAX-WIDTH 2
  HELP "The type for this location."
  ORDER 60
  MANDATORY

ADD FIELD "height" OF "binmst" AS integer 
  FORMAT ">,>>9"
  INITIAL "0"
  LABEL "Height"
  POSITION 24
  MAX-WIDTH 4
  HELP "This location's height in inches."
  ORDER 160

ADD FIELD "depth" OF "binmst" AS integer 
  FORMAT ">,>>9"
  INITIAL "0"
