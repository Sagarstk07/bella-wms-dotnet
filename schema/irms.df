  ORDER 60

ADD FIELD "ReportName" OF "rblayout_group" AS character 
  DESCRIPTION "Describes the report name.                                                                                                                  "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Report Name"
  POSITION 3
  MAX-WIDTH 48
  HELP "Enter the report name."
  ORDER 50

