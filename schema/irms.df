  HELP "Enter the company number."
  ORDER 10

ADD FIELD "carrier_now" OF "dockmstr" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Current Carrier"
  POSITION 17
  MAX-WIDTH 12
  HELP "Carrier currently using this dock."
