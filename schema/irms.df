ADD TABLE "ABC"
  AREA "misc128_dat"
  LABEL "ABC Stratification"
  DESCRIPTION "Table has data that is used to periodically stratify the inventory."
  DUMP-NAME "abc"

ADD FIELD "wh_num" OF "ABC" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "recalc_type" OF "ABC" AS character 
  FORMAT "X"
  INITIAL ""
  LABEL "Recalc Type"
  POSITION 3
  MAX-WIDTH 2
  ORDER 180

ADD FIELD "recalc_timeframe" OF "ABC" AS character 
  DESCRIPTION "Days, Weeks, Months"
  FORMAT "X"
  INITIAL "M"
  LABEL "Recalculation Time-frame"
  POSITION 4
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS 
  ""Days"", ""D"",
  ""Weeks"", ""W"",
  ""Months"", ""M"""
  HELP "Enter the time frame."
  ORDER 160
  MANDATORY

ADD FIELD "recalc_last" OF "ABC" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Last Recalculation"
  POSITION 5
  MAX-WIDTH 4
  HELP "Last time the stratification was automatically done."
  ORDER 170

ADD FIELD "recalc_interval" OF "ABC" AS integer 
  FORMAT ">>9"
  INITIAL "1"
  LABEL "Recalculation Interval"
  POSITION 6
  MAX-WIDTH 4
  VALMSG "Please enter a value for the interval, greater than zero."
  HELP "Interval between recalculations."
  ORDER 150
  MANDATORY

ADD FIELD "O_dollar_percent" OF "ABC" AS decimal 
  FORMAT ">>%"
  INITIAL "0"
  LABEL "Other Percent By Dollar"
  POSITION 7
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 60

ADD FIELD "O_count_percent" OF "ABC" AS decimal 
  FORMAT ">>%"
  INITIAL "20"
  LABEL "Other Percent By Count"
  POSITION 8
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 100

ADD FIELD "o_count_loc" OF "ABC" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Other Count Loc"
  POSITION 9
  MAX-WIDTH 4
  ORDER 230

ADD FIELD "O_count_interval" OF "ABC" AS integer 
  FORMAT ">>9"
  INITIAL "360"
  LABEL "Other Interval"
  POSITION 10
  MAX-WIDTH 4
  ORDER 140

ADD FIELD "C_dollar_percent" OF "ABC" AS decimal 
  FORMAT ">>9%"
  INITIAL "10"
  LABEL "C Percent By Dollar"
  POSITION 11
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 50

ADD FIELD "C_count_percent" OF "ABC" AS decimal 
  FORMAT ">>9%"
  INITIAL "65"
  LABEL "C Percent By Count"
  POSITION 12
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 90

ADD FIELD "c_count_loc" OF "ABC" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "C Count Loc"
  POSITION 13
  MAX-WIDTH 4
  ORDER 220

ADD FIELD "C_count_interval" OF "ABC" AS integer 
  FORMAT ">>9"
  INITIAL "180"
  LABEL "C Interval"
  POSITION 14
  MAX-WIDTH 4
  ORDER 130

ADD FIELD "custom_data" OF "ABC" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 15
  MAX-WIDTH 510
  EXTENT 5
  ORDER 240

ADD FIELD "co_num" OF "ABC" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 16
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10
  MANDATORY

ADD FIELD "count_type" OF "ABC" AS character 
  FORMAT "X"
  INITIAL ""
  LABEL "Count Type"
  POSITION 17
  MAX-WIDTH 2
  ORDER 190

ADD FIELD "B_dollar_percent" OF "ABC" AS decimal 
  FORMAT ">>9%"
  INITIAL "20"
  LABEL "B Percent By Dollar"
  POSITION 18
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 40

ADD FIELD "B_count_percent" OF "ABC" AS decimal 
  FORMAT ">>9%"
  INITIAL "10"
  LABEL "B Percent By Count"
  POSITION 19
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 80

ADD FIELD "b_count_loc" OF "ABC" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "B Count Loc"
  POSITION 20
  MAX-WIDTH 4
  ORDER 210

ADD FIELD "B_count_interval" OF "ABC" AS integer 
  FORMAT ">>9"
  INITIAL "90"
  LABEL "B Interval"
  POSITION 21
  MAX-WIDTH 4
  ORDER 120

ADD FIELD "A_dollar_percent" OF "ABC" AS decimal 
  FORMAT ">>%"
  INITIAL "70"
  LABEL "A Percent By Dollar"
  POSITION 22
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 30

ADD FIELD "A_count_percent" OF "ABC" AS decimal 
  FORMAT ">>%"
  INITIAL "5"
  LABEL "A Percent By Count"
  POSITION 23
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 70

ADD FIELD "a_count_loc" OF "ABC" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "A Count Locations"
  POSITION 24
  MAX-WIDTH 4
  ORDER 200

ADD FIELD "A_count_interval" OF "ABC" AS integer 
  FORMAT ">>9"
  INITIAL "45"
  LABEL "A Interval"
  POSITION 25
  MAX-WIDTH 4
  ORDER 110

ADD INDEX "abc_co_wh_timestamp" ON "ABC" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "recalc_last" ASCENDING 

ADD TABLE "app_menu"
  AREA "misc128_dat"
  DESCRIPTION "Application menu entries.                                      "
  DUMP-NAME "appmen"

ADD FIELD "char3" OF "app_menu" AS character 
  DESCRIPTION "Describes misc char3.                                                                                                                       "
  FORMAT "x(8)"
  INITIAL ""
  LABEL "char3"
  POSITION 2
  MAX-WIDTH 16
  HELP "Enter the misc char3."
  ORDER 80

ADD FIELD "char2" OF "app_menu" AS character 
  DESCRIPTION "Describes the misc char2 field.                                                                                                             "
  FORMAT "x(8)"
  INITIAL ""
  LABEL "char2"
  POSITION 3
  MAX-WIDTH 16
  HELP "Enter the misc char2 field."
  ORDER 70

ADD FIELD "char1" OF "app_menu" AS character 
  DESCRIPTION "Describes misc char field.                                                                                                                  "
  FORMAT "x(8)"
  INITIAL ""
  LABEL "char1"
  POSITION 4
  MAX-WIDTH 16
  HELP "Enter misc char 1"
  ORDER 60

ADD FIELD "icon_name" OF "app_menu" AS character 
  DESCRIPTION "Describes the icon for the menu entry.                                                                                                      "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Icon Name"
  POSITION 5
  MAX-WIDTH 22
  HELP "Enter the icon for this menu entry."
  ORDER 50

ADD FIELD "group_name" OF "app_menu" AS character 
  DESCRIPTION "Describes the group name for the menu entry.                                                                                                "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Group"
  POSITION 6
  MAX-WIDTH 18
  HELP "Enter the group name."
  ORDER 40

ADD FIELD "assembly_name" OF "app_menu" AS character 
  DESCRIPTION "Describes the assembly name that holds the form.                                                                                            "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Assembly Name"
  POSITION 7
  MAX-WIDTH 31
  HELP "Enter the assembly name that holds the form."
  ORDER 30

ADD FIELD "form_name" OF "app_menu" AS character 
  DESCRIPTION "Describes the form name of the menu.                                                                                                        "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Form Name"
  POSITION 8
  MAX-WIDTH 59
  HELP "Enter the form name."
  ORDER 20

ADD FIELD "menu_name" OF "app_menu" AS character 
  DESCRIPTION "Describes the menu name for the application.                                                                                                "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Application"
  POSITION 9
  MAX-WIDTH 28
  HELP "Enter the menu name for the application."
  ORDER 10

ADD INDEX "main_key" ON "app_menu" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "menu_name" ASCENDING 
  INDEX-FIELD "form_name" ASCENDING 
  INDEX-FIELD "assembly_name" ASCENDING 

ADD TABLE "assessorial"
  AREA "unused_dat"
  LABEL "Assessorial"
  DESCRIPTION "Holds detail information for customer order lines. This detail may be customization, kitting, special handling, etc."
  DUMP-NAME "assessor"
  TABLE-TRIGGER "CREATE" OVERRIDE PROCEDURE "n_access.t" CRC "?" 

ADD FIELD "work_station" OF "assessorial" AS character 
  DESCRIPTION "Work Station. This field is not validated, being a freeform alternative to using departments."
  FORMAT "X(10)"
  INITIAL ?
  LABEL "Work Station"
  POSITION 2
  MAX-WIDTH 20
  HELP "Work Station"
  ORDER 90

ADD FIELD "value_added" OF "assessorial" AS decimal 
  DESCRIPTION "Value added."
  FORMAT "->,>>>,>>9.99"
  INITIAL ?
  LABEL "Value"
  POSITION 3
  MAX-WIDTH 17
  HELP "Added cost or price."
  DECIMALS 2
  ORDER 120

ADD FIELD "qty2" OF "assessorial" AS decimal 
  DESCRIPTION "Second quantity (for human consumption; meaning depends on the type of accessorial)."
  FORMAT "->,>>>,>>9.99"
  INITIAL ?
  LABEL "Quantity 2"
  POSITION 4
  MAX-WIDTH 17
  HELP "Second quantity"
  DECIMALS 2
  ORDER 110

ADD FIELD "qty1" OF "assessorial" AS decimal 
  DESCRIPTION "First quantity (for human consumption, meaning depends on the accessorial type)."
  FORMAT "->,>>>,>>9.99"
  INITIAL ?
  LABEL "Quantity 1"
  POSITION 5
  MAX-WIDTH 17
  HELP "First quantity."
  DECIMALS 2
  ORDER 100

ADD FIELD "order_id" OF "assessorial" AS integer 
  DESCRIPTION "ordhdr.id"
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  LABEL "Order Id"
  POSITION 6
  MAX-WIDTH 4
  HELP "Order Id"
  ORDER 20

ADD FIELD "line_status" OF "assessorial" AS character 
  FORMAT "X"
  INITIAL "O"
  LABEL "Status"
  POSITION 7
  MAX-WIDTH 2
  ORDER 140

ADD FIELD "line_sequence" OF "assessorial" AS integer 
  DESCRIPTION "orddtl.line_sequence"
  FORMAT ">>>,>>9"
  INITIAL ?
  LABEL "Line Sequence"
  POSITION 8
  MAX-WIDTH 4
  HELP "Order Line Sequence."
  ORDER 40

ADD FIELD "line" OF "assessorial" AS integer 
  DESCRIPTION "Order Line"
  FORMAT ">>>,>>9"
  INITIAL ?
  LABEL "Order Line"
  POSITION 9
  MAX-WIDTH 4
  HELP "Order Line"
  ORDER 30

ADD FIELD "id" OF "assessorial" AS integer 
  DESCRIPTION "Unique id for this record."
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "Id"
  POSITION 10
  MAX-WIDTH 4
  ORDER 10

ADD FIELD "description" OF "assessorial" AS character 
  DESCRIPTION "Description (human readable) for this accessorial"
  FORMAT "X(50)"
  INITIAL ?
  LABEL "Description"
  POSITION 11
  MAX-WIDTH 100
  HELP "Description"
  ORDER 60

ADD FIELD "dept_num" OF "assessorial" AS integer 
  DESCRIPTION "Department Number."
  FORMAT ">>>,>>9"
  INITIAL ?
  LABEL "Department"
  POSITION 12
  MAX-WIDTH 4
  HELP "Department Number."
  ORDER 80
  MANDATORY

ADD FIELD "custom_data" OF "assessorial" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 13
  MAX-WIDTH 510
  HELP "Customization data."
  EXTENT 5
  ORDER 130

ADD FIELD "code" OF "assessorial" AS character 
  DESCRIPTION "Accessorial code"
  FORMAT "X(8)"
  INITIAL ?
  LABEL "Code"
  POSITION 14
  MAX-WIDTH 16
  HELP "Accessorial code"
  ORDER 50

ADD FIELD "abs_num" OF "assessorial" AS character 
  FORMAT "x(24)"
  INITIAL ?
  LABEL "Item"
  POSITION 15
  MAX-WIDTH 48
  HELP "SKU associated to this accessorial."
  ORDER 70

ADD INDEX "order_line_sequence_id" ON "assessorial" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "order_id" ASCENDING 
  INDEX-FIELD "line" ASCENDING 
  INDEX-FIELD "line_sequence" ASCENDING 
  INDEX-FIELD "id" ASCENDING 

ADD INDEX "assessorial_id" ON "assessorial" 
  AREA "unused_idx"
  UNIQUE
  DESCRIPTION "Enforce uniqueness"
  INDEX-FIELD "id" ASCENDING 

ADD TABLE "assessorial_code"
  AREA "unused_dat"
  LABEL "Assessorial Code"
  DESCRIPTION "Validates and controls the behavior of the different assessorial lines in an order."
  DUMP-NAME "ass_code"

ADD FIELD "wh_num" OF "assessorial_code" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ?
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "row_status" OF "assessorial_code" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Status"
  POSITION 3
  MAX-WIDTH 1
  HELP "Turn this assessorial on or off."
  ORDER 130

ADD FIELD "req_work_station" OF "assessorial_code" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Require Work Station"
  POSITION 4
  MAX-WIDTH 1
  HELP "Require Work Station?"
  ORDER 60

ADD FIELD "req_value" OF "assessorial_code" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Require Value"
  POSITION 5
  MAX-WIDTH 1
  HELP "Require value?"
  ORDER 90

ADD FIELD "req_qty2" OF "assessorial_code" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Require Second Qty"
  POSITION 6
  MAX-WIDTH 1
  HELP "Require second quantity?"
  ORDER 110

ADD FIELD "req_qty1" OF "assessorial_code" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Require First Qty"
  POSITION 7
  MAX-WIDTH 1
  HELP "Require first quantity?"
  ORDER 100

ADD FIELD "req_description" OF "assessorial_code" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Require Description"
  POSITION 8
  MAX-WIDTH 1
  HELP "Require description?"
  ORDER 80

ADD FIELD "req_dept_num" OF "assessorial_code" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Require Department"
  POSITION 9
  MAX-WIDTH 1
  HELP "Require department?"
  ORDER 70

ADD FIELD "req_abs_num" OF "assessorial_code" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Require Item"
  POSITION 10
  MAX-WIDTH 1
  HELP "Require item?"
  ORDER 50

ADD FIELD "description" OF "assessorial_code" AS character 
  DESCRIPTION "Description (human readable) for this accessorial code"
  FORMAT "X(20)"
  INITIAL ?
  LABEL "Description"
  POSITION 11
  MAX-WIDTH 40
  HELP "Description"
  ORDER 40

ADD FIELD "custom_data" OF "assessorial_code" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 12
  MAX-WIDTH 510
  HELP "Customization data."
  EXTENT 5
  ORDER 120

ADD FIELD "co_num" OF "assessorial_code" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ?
  LABEL "Company"
  POSITION 13
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10
  MANDATORY

ADD FIELD "code" OF "assessorial_code" AS character 
  DESCRIPTION "Accessorial code"
  FORMAT "X(8)"
  INITIAL ?
  LABEL "Code"
  POSITION 14
  MAX-WIDTH 16
  HELP "Accessorial code"
  ORDER 30

ADD INDEX "co_wh_code" ON "assessorial_code" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "code" ASCENDING 

ADD TABLE "barcodedtl"
  AREA "unused_dat"
  LABEL "Barcode Detail"
  DUMP-NAME "barcddtl"

ADD FIELD "value_start" OF "barcodedtl" AS integer 
  DESCRIPTION "Start of the attribute's value in the barcode."
  FORMAT ">>9"
  INITIAL ?
  LABEL "Value Start"
  POSITION 2
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "value_length" OF "barcodedtl" AS integer 
  DESCRIPTION "Length of the value of this attribute in the barcode."
  FORMAT ">>9"
  INITIAL ?
  LABEL "Value Length"
  POSITION 3
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "custom_data" OF "barcodedtl" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  LABEL "Custom Data"
  POSITION 4
  MAX-WIDTH 510
  EXTENT 5
  ORDER 60

ADD FIELD "barcode_id" OF "barcodedtl" AS character 
  DESCRIPTION "Unique identifier, entered by the user."
  FORMAT "X(8)"
  INITIAL ?
  LABEL "Barcode Id"
  POSITION 5
  MAX-WIDTH 16
  ORDER 10

ADD FIELD "attribute_name" OF "barcodedtl" AS character 
  FORMAT "X(8)"
  INITIAL ""
  LABEL "Attribute name"
  POSITION 6
  MAX-WIDTH 16
  ORDER 20

ADD FIELD "attribute_desc" OF "barcodedtl" AS character 
  FORMAT "X(30)"
  INITIAL ?
  LABEL "Attribute Description"
  POSITION 7
  MAX-WIDTH 60
  ORDER 30

ADD INDEX "id_name" ON "barcodedtl" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "barcode_id" ASCENDING 
  INDEX-FIELD "attribute_name" ASCENDING 

ADD TABLE "barcodemst"
  AREA "unused_dat"
  LABEL "Barcode Master"
  DUMP-NAME "barcdmst"

ADD FIELD "vendor_item_start" OF "barcodemst" AS integer 
  DESCRIPTION "Start of the vendor item in this barcode."
  FORMAT ">>9"
  INITIAL ?
  LABEL "Vendor Item Start"
  POSITION 2
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "vendor_item_length" OF "barcodemst" AS integer 
  DESCRIPTION "Length of the vendor item in this barcode."
  FORMAT ">>9"
  INITIAL ?
  LABEL "Vendor Item Length"
  POSITION 3
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "vendor_id" OF "barcodemst" AS character 
  FORMAT "X(9)"
  INITIAL ""
  LABEL "Vendor ID"
  POSITION 4
  MAX-WIDTH 18
  HELP "Vendor ID"
  ORDER 20

ADD FIELD "quantity_style" OF "barcodemst" AS character 
  DESCRIPTION "How to decode the quantity: EA (eaches), DZ (dozens), DZ-EA (dozens and eaches)..."
  FORMAT "X(8)"
  INITIAL ?
  LABEL "Quantity Style"
  POSITION 5
  MAX-WIDTH 16
  ORDER 100

ADD FIELD "quantity_start" OF "barcodemst" AS integer 
  DESCRIPTION "Start of the quantity in this barcode"
  FORMAT ">>9"
  INITIAL ?
  LABEL "Quantity Start"
  POSITION 6
  MAX-WIDTH 4
  ORDER 80

ADD FIELD "quantity_length" OF "barcodemst" AS integer 
  DESCRIPTION "Length of the quantity in this barcode."
  FORMAT ">>9"
  INITIAL ?
  LABEL "Quantity Length"
  POSITION 7
  MAX-WIDTH 4
  ORDER 90

ADD FIELD "po_start" OF "barcodemst" AS integer 
  DESCRIPTION "Start of the PO in this barcode."
  FORMAT ">>9"
  INITIAL ?
  LABEL "PO Start"
  POSITION 8
  MAX-WIDTH 4
  ORDER 110

ADD FIELD "custom_data" OF "barcodemst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  LABEL "Custom Data"
  POSITION 9
  MAX-WIDTH 510
  EXTENT 5
  ORDER 120

ADD FIELD "barcode_length" OF "barcodemst" AS integer 
  DESCRIPTION "Length of this barcode, in characters"
  FORMAT ">>9"
  INITIAL ?
  LABEL "Barcode Length"
  POSITION 10
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "barcode_id" OF "barcodemst" AS character 
  DESCRIPTION "Unique identifier, entered by the user."
  FORMAT "X(8)"
  INITIAL ?
  LABEL "Barcode Id"
  POSITION 11
  MAX-WIDTH 16
  ORDER 10

ADD FIELD "abs_num_start" OF "barcodemst" AS integer 
  DESCRIPTION "Start of the IRMS item code in this barcode."
  FORMAT ">>9"
  INITIAL ?
  LABEL "Abs Num Start"
  POSITION 12
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "abs_num_length" OF "barcodemst" AS integer 
  DESCRIPTION "Length of the IRMS item code in this barcode"
  FORMAT ">>9"
  INITIAL ?
  LABEL "Abs Num Length"
  POSITION 13
  MAX-WIDTH 4
  ORDER 70

ADD INDEX "barcodeid" ON "barcodemst" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "barcode_id" ASCENDING 

ADD INDEX "length" ON "barcodemst" 
  AREA "unused_idx"
  INDEX-FIELD "barcode_length" ASCENDING 

ADD INDEX "vendor" ON "barcodemst" 
  AREA "unused_idx"
  INDEX-FIELD "vendor_id" ASCENDING 

ADD TABLE "batch_group"
  AREA "unused_dat"
  DESCRIPTION "Lists all batch groups in the system."
  DUMP-NAME "btchgrp"

ADD FIELD "description" OF "batch_group" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Description"
  POSITION 2
  MAX-WIDTH 60
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the description."
  ORDER 80

ADD FIELD "char_3" OF "batch_group" AS character 
  DESCRIPTION "Custom Data"
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 3
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter custom data."
  ORDER 70

ADD FIELD "char_2" OF "batch_group" AS character 
  DESCRIPTION "Custom Data"
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 4
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter custom data."
  ORDER 60

ADD FIELD "char_1" OF "batch_group" AS character 
  DESCRIPTION "Custom Data"
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 5
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter custom data."
  ORDER 50

ADD FIELD "active" OF "batch_group" AS logical 
  DESCRIPTION "Used to determine an active status of this batch group."
  FORMAT "Y/N"
  INITIAL "yes"
  LABEL "Active"
  POSITION 6
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "A"
  HELP "Enter whether or not this is currently active."
  ORDER 40

ADD FIELD "batch_group" OF "batch_group" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Batch Group"
  POSITION 7
  MAX-WIDTH 30
  VIEW-AS ""
  COLUMN-LABEL "Group"
  HELP "Enter the batch group name."
  ORDER 30

ADD FIELD "wh_num" OF "batch_group" AS character 
  DESCRIPTION "Warehouse Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 8
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Whse"
  HELP "Enter the warehouse number."
  ORDER 20

ADD FIELD "co_num" OF "batch_group" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 9
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Comp"
  HELP "Enter the company number."
  ORDER 10

ADD INDEX "mainkey" ON "batch_group" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  DESCRIPTION "Main Index"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "batch_group" ASCENDING 

ADD INDEX "activekey" ON "batch_group" 
  AREA "unused_idx"
  DESCRIPTION "Active Index"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "active" ASCENDING 
  INDEX-FIELD "batch_group" ASCENDING 

ADD TABLE "batch_job"
  AREA "unused_dat"
  DESCRIPTION "Batch Job Master Record"
  DUMP-NAME "btchjb"

ADD FIELD "char_3" OF "batch_job" AS character 
  DESCRIPTION "Custom Data"
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 2
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter custom data."
  ORDER 250

ADD FIELD "char_2" OF "batch_job" AS character 
  DESCRIPTION "Custom Data"
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 3
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter custom data."
  ORDER 240

ADD FIELD "char_1" OF "batch_job" AS character 
  DESCRIPTION "Custom Data"
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 4
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter custom data."
  ORDER 230

ADD FIELD "internal_proc" OF "batch_job" AS character 
  DESCRIPTION "Name of the internal procedure within the persistent procedure to run for this batch job."
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Internal Procedure Name"
  POSITION 5
  MAX-WIDTH 80
  VIEW-AS ""
  COLUMN-LABEL "Internal Proc"
  HELP "Enter the name of the internal procedure to run."
  ORDER 220

ADD FIELD "run_persistent" OF "batch_job" AS logical 
  DESCRIPTION "Is this batch job run inside a persistent procedure."
  FORMAT "Y/N"
  INITIAL "no"
  LABEL "Persistent"
  POSITION 6
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter whether or not the launch program is run persistent."
  ORDER 210

ADD FIELD "run_type" OF "batch_job" AS character 
  DESCRIPTION "Describes the type of batch job."
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Run Type"
  POSITION 7
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the type of batch job."
  ORDER 200

ADD FIELD "priority" OF "batch_job" AS integer 
  DESCRIPTION "Describes the priority of this batch job."
  FORMAT ">>>>>9"
  INITIAL "0"
  LABEL "Priority"
  POSITION 8
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the priority of this batch job."
  ORDER 190

ADD FIELD "sched_time" OF "batch_job" AS integer 
  DESCRIPTION "Describes the time this batch job is scheduled for."
  FORMAT ">>>>>9"
  INITIAL "0"
  LABEL "Scheduled Time"
  POSITION 9
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Sched. Time"
  HELP "Enter the scheduled time of this batch job."
  ORDER 180

ADD FIELD "sched_date" OF "batch_job" AS date 
  DESCRIPTION "Describes the scheduled date of this batch job."
  FORMAT "99/99/9999"
  INITIAL "TODAY"
  LABEL "Scheduled Date"
  POSITION 10
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Sched. Date"
  HELP "Enter the scheduled date of this batch job."
  ORDER 170

ADD FIELD "day_of_week" OF "batch_job" AS character 
  DESCRIPTION "Describes the day of the week the job is scheduled for."
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Day Of Week"
  POSITION 11
  MAX-WIDTH 30
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the day of the week the job is scheduled for."
  ORDER 160

ADD FIELD "day_of_month" OF "batch_job" AS character 
  DESCRIPTION "Describes the day of the month the job is scheduled for."
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Day Of Month"
  POSITION 12
  MAX-WIDTH 30
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the day of the month the job is scheduled for."
  ORDER 150

ADD FIELD "emp_num" OF "batch_job" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Employee Number"
  POSITION 13
  MAX-WIDTH 12
  VIEW-AS ""
  COLUMN-LABEL "Employee"
  HELP "Enter this user's number."
  ORDER 140

ADD FIELD "printer_id" OF "batch_job" AS character 
  DESCRIPTION "Printer ID, as known to IRMS (unique)."
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Printer Id"
  POSITION 14
  MAX-WIDTH 30
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter an unique identifier for this printer."
  ORDER 130

ADD FIELD "run_time" OF "batch_job" AS integer 
  DESCRIPTION "Describes the total time to run the batch job."
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Run Time"
  POSITION 15
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the time it took to run this batch job."
  ORDER 120

ADD FIELD "end_time" OF "batch_job" AS integer 
  DESCRIPTION "Describes the time that this batch job finished."
  FORMAT ">>>>>9"
  INITIAL "0"
  LABEL "Finish Time"
  POSITION 16
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the finish time of this batch job."
  ORDER 110

ADD FIELD "end_date" OF "batch_job" AS date 
  DESCRIPTION "Describes the date that the batch job finished."
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Finish Date"
  POSITION 17
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the finish date of the batch job."
  ORDER 100

ADD FIELD "launch_pgm" OF "batch_job" AS character 
  DESCRIPTION "Describes the program that will be run for this batch job."
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Program"
  POSITION 18
  MAX-WIDTH 80
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the name of the program to run."
  ORDER 90

ADD FIELD "description" OF "batch_job" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Description"
  POSITION 19
  MAX-WIDTH 60
  VIEW-AS ""
  COLUMN-LABEL "Description"
  HELP "Enter the description."
  ORDER 80

ADD FIELD "start_time" OF "batch_job" AS integer 
  DESCRIPTION "Describes the time that this batch job started."
  FORMAT ">>>>>9"
  INITIAL "0"
  LABEL "Start Time"
  POSITION 20
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the start time of this batch job."
  ORDER 70

ADD FIELD "start_date" OF "batch_job" AS date 
  DESCRIPTION "Describes the date that this batch job ran."
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Start Date"
  POSITION 21
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the run date of this batch job."
  ORDER 60

ADD FIELD "batch_status" OF "batch_job" AS character 
  DESCRIPTION "Describes the status of the selected batch job."
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Status"
  POSITION 22
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "Status"
  HELP "Enter the status of the batch job."
  ORDER 50

ADD FIELD "batch_group" OF "batch_job" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Batch Group"
  POSITION 23
  MAX-WIDTH 30
  VIEW-AS ""
  COLUMN-LABEL "Group"
  HELP "Enter the batch group name."
  ORDER 40

ADD FIELD "job_number" OF "batch_job" AS integer 
  DESCRIPTION "Describes the job number associated with the batch job."
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "Job Number"
  POSITION 24
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the job number for this batch job."
  ORDER 30

ADD FIELD "wh_num" OF "batch_job" AS character 
  DESCRIPTION "Warehouse Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 25
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Whse"
  HELP "Enter the warehouse number."
  ORDER 20

ADD FIELD "co_num" OF "batch_job" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 26
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Comp"
  HELP "Enter the company number."
  ORDER 10

ADD INDEX "mainkey" ON "batch_job" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  DESCRIPTION "Main Index"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "batch_group" ASCENDING 
  INDEX-FIELD "job_number" ASCENDING 

