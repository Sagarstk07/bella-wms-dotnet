  DESCRIPTION "PO Line number, kept here because we need it in the receival transaction."
  FORMAT ">>>9"
  INITIAL "0"
  POSITION 26
  MAX-WIDTH 4
  ORDER 240

ADD FIELD "percent_fill" OF "rtdet" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL ?
  LABEL "Percent Fill"
  POSITION 27
  MAX-WIDTH 19
  DECIMALS 2
  ORDER 400

ADD FIELD "packing_list" OF "rtdet" AS logical 
  DESCRIPTION "Set to true if this is a packing list RT"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 28
  MAX-WIDTH 1
  ORDER 390
  MANDATORY

ADD FIELD "packer" OF "rtdet" AS character 
  DESCRIPTION "Packer Id. The only reason why this is here is because we need it when we create the stock receipt transaction."
  FORMAT "X(14)"
  INITIAL ""
  POSITION 29
  MAX-WIDTH 28
  ORDER 270

ADD FIELD "ordered_qty" OF "rtdet" AS decimal 
  DESCRIPTION "Original ordered quantity, for documentation purposes."
  FORMAT "->>,>>9.99"
  INITIAL ?
  LABEL "Quantity Ordered"
  POSITION 30
  MAX-WIDTH 17
  HELP "Quantity ordered."
  DECIMALS 2
  ORDER 115

ADD FIELD "lot" OF "rtdet" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Lot"
  POSITION 31
  MAX-WIDTH 48
  HELP "Lot Number."
  ORDER 180

ADD FIELD "line_sequence" OF "rtdet" AS integer 
  DESCRIPTION "This is a sub-sequence for the po-line. It is used with kits. This is here just because we will need this datawhen we create the stock receipt transaction."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Seq"
  POSITION 32
  MAX-WIDTH 4
  COLUMN-LABEL "Sq"
  HELP "Enter the PO line sequence number."
  ORDER 250

ADD FIELD "line_num" OF "rtdet" AS integer 
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Line Number"
  POSITION 33
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "line_indicator" OF "rtdet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "X"
  INITIAL ""
  POSITION 34
  MAX-WIDTH 2
  ORDER 360

ADD FIELD "item_num" OF "rtdet" AS character 
  DESCRIPTION "NAED number (All-Phase)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Alternate Item Number"
  POSITION 35
  MAX-WIDTH 48
  VALMSG "Please enter this item's catalog number."
  HELP "Enter this item's catalog number."
  ORDER 70
  MANDATORY

ADD FIELD "item_desc" OF "rtdet" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Item Description"
  POSITION 36
  MAX-WIDTH 60
  COLUMN-LABEL "desc"
  HELP "Description for this item."
  ORDER 200

ADD FIELD "item_cost" OF "rtdet" AS decimal 
  FORMAT "$>>>,>>9.99"
  INITIAL "0"
  LABEL "Cost"
  POSITION 37
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 150

ADD FIELD "exp_quantity" OF "rtdet" AS decimal 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Expected Quantity"
  POSITION 38
  MAX-WIDTH 17
  HELP "Quantity expected"
  DECIMALS 2
  ORDER 110

ADD FIELD "delivery" OF "rtdet" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Delivery"
  POSITION 39
  MAX-WIDTH 4
  HELP "Estimated delivery date."
  ORDER 280

ADD FIELD "custom_data" OF "rtdet" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 40
  MAX-WIDTH 510
  EXTENT 5
  ORDER 410

ADD FIELD "co_num" OF "rtdet" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 41
  MAX-WIDTH 8
  VALMSG "Company must be defined in the Company Master table first."
  HELP "Enter the company number."
  ORDER 20

ADD FIELD "comments" OF "rtdet" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Comments"
  POSITION 42
  MAX-WIDTH 60
  COLUMN-LABEL "comments"
  HELP "Comments for this RT line."
  ORDER 190

ADD FIELD "case_qty" OF "rtdet" AS integer 
  FORMAT ">>,>>9"
  INITIAL "0"
  LABEL "Outer Pack"
  POSITION 43
  MAX-WIDTH 4
  COLUMN-LABEL "o/p"
  HELP "Outer pack quantity for this RT line."
  ORDER 170

ADD FIELD "bo_quantity" OF "rtdet" AS decimal 
  DESCRIPTION "Back-order quantity for this item. May be smaller, equal or larger than the quantity field. 0 means no back-orders. (See also: bo_count)"
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "B/O Quantity"
  POSITION 44
  MAX-WIDTH 17
  HELP "Quantity."
  DECIMALS 2
  ORDER 130

ADD FIELD "bo_count" OF "rtdet" AS integer 
  DESCRIPTION "The number of back orders for this line item. See also bo_quantity.
"
  FORMAT ">>9"
  INITIAL "0"
  LABEL "B/O Count"
  POSITION 45
  MAX-WIDTH 4
  HELP "The number of back orders for this item."
  ORDER 120

ADD FIELD "asn_flag" OF "rtdet" AS logical 
  DESCRIPTION "This is received from the mainframe. It is set to true if this is an EDI (electronic data i...) transaction, that is, paperless."
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 46
  MAX-WIDTH 1
  HELP "Is this an EDI transaction?"
  ORDER 260
  MANDATORY

ADD FIELD "act_quantity" OF "rtdet" AS decimal 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Actual Quantity"
  POSITION 47
  MAX-WIDTH 17
  HELP "Quantity received"
  DECIMALS 2
  ORDER 100

ADD FIELD "abs_num" OF "rtdet" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Absolute Item Number"
  POSITION 48
  MAX-WIDTH 48
  COLUMN-LABEL "abs num"
  VALMSG "Item must be defined first."
  HELP "Enter the company-wide unique code for this item."
  ORDER 60
  MANDATORY

ADD FIELD "work_order_num" OF "rtdet" AS character 
  DESCRIPTION "The manufacturer work order number."
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Work Order Number"
  POSITION 49
  MAX-WIDTH 20
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 480

ADD FIELD "lpn_create_date" OF "rtdet" AS date 
  DESCRIPTION "The created date for the LPN carton."
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "LPN Create Date"
  POSITION 50
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Create Date"
  HELP "Enter the created date for the LPN carton."
  ORDER 470

ADD FIELD "po_description" OF "rtdet" AS character 
  DESCRIPTION "Purchase Order Description"
  FORMAT "x(30)"
  INITIAL ""
  LABEL "PO Description"
  POSITION 51
  MAX-WIDTH 60
  VIEW-AS ""
  COLUMN-LABEL "PO Description"
  HELP "Purchase Order Description"
  ORDER 500

ADD FIELD "reason_code" OF "rtdet" AS character 
  DESCRIPTION "Return Reason Code"
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Reason Code"
  POSITION 52
  MAX-WIDTH 20
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Reason Code"
  ORDER 490

ADD FIELD "rt_uom" OF "rtdet" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "RT UOM"
  POSITION 53
  MAX-WIDTH 8
  HELP "Receiving (PO) UOM (ERP po-line.uom). BEL-1144."
  ORDER 510

ADD FIELD "rt_qty" OF "rtdet" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "RT Qty"
  POSITION 54
  MAX-WIDTH 19
  HELP "Expected receiving qty in RT UOM (ERP asn_line_dtl.quantity). BEL-1144."
  DECIMALS 2
  ORDER 520

ADD FIELD "uom_cnv" OF "rtdet" AS decimal 
  FORMAT ">>>,>>9.99999999"
  INITIAL "0"
  LABEL "UOM Conv"
  POSITION 55
  MAX-WIDTH 19
  HELP "UOM conversion factor RT to inventory (ERP po-line-dtl.uom-cnv). BEL-1144."
  DECIMALS 8
  ORDER 530

