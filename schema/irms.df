  PRIMARY
  INDEX-FIELD "carton_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 

ADD TABLE "cartonmst"
  AREA "misc64_dat"
  LABEL "Carton Master Table"
  DESCRIPTION "Record information about cartons. Contents of cartons go in
cartondtl
"
  DUMP-NAME "cartonm"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_carton.t" CRC "?" 

