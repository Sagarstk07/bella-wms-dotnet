ADD FIELD "addr" OF "cmpmst" AS character 
  DESCRIPTION "Address."
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Address"
  POSITION 10
  MAX-WIDTH 124
  COLUMN-LABEL "Addr"
  HELP "Enter the company's address."
  EXTENT 2
  ORDER 30

ADD FIELD "ad_pass_type" OF "cmpmst" AS character 
  DESCRIPTION "Active Directory Type FDM4 for base implmentation and other company name for third party. ie) Centrify"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "AD Type"
  POSITION 11
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "AD Type"
  ORDER 130

ADD FIELD "ad_method" OF "cmpmst" AS character 
  DESCRIPTION "Active Directroy Method. ldaps vs ldap"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "AD Method"
  POSITION 12
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "AD Method"
  ORDER 120

ADD FIELD "ad_domain_name" OF "cmpmst" AS character 
  DESCRIPTION "Active Directory Domain Name ie) fdm4.com"
  FORMAT "x(15)"
  INITIAL ""
  LABEL "AD Domain"
  POSITION 13
  MAX-WIDTH 30
  VIEW-AS ""
  COLUMN-LABEL "AD Domain"
  ORDER 110

ADD FIELD "max_login_attempts" OF "cmpmst" AS integer 
  DESCRIPTION "The maximum allowed number of unsuccessful login attempts before an employee is locked. "
  FORMAT "->,>>>,>>9"
  INITIAL "-1"
  LABEL "Max Login Attempts"
  POSITION 14
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Attempts"
  HELP "Enter the max allowed number of unsuccessful login attempts."
  ORDER 100

ADD FIELD "login_lockout_time" OF "cmpmst" AS integer 
  DESCRIPTION "The time (in seconds) that a user will be locked out after failing login validation the max number of times."
  FORMAT "->,>>>,>>9"
  INITIAL "600"
  LABEL "Login Lock Time"
  POSITION 15
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Lock Time"
  HELP "Enter the time in seconds that a user will be locked out."
  ORDER 90

ADD INDEX "co_num" ON "cmpmst" 
  AREA "misc64_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 

ADD TABLE "comdet"
  AREA "misc128_dat"
  LABEL "Communication Details Table"
  DESCRIPTION "This table has information that is used by the interface programs."
  DUMP-NAME "comdet"

ADD FIELD "version" OF "comdet" AS character 
  DESCRIPTION "(Will be used for validation.)"
  FORMAT "X(2)"
  INITIAL "31"
  POSITION 2
  MAX-WIDTH 84
  HELP "The version number for this record format."
  ORDER 20
  MANDATORY

ADD FIELD "validate" OF "comdet" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 3
  MAX-WIDTH 1
  ORDER 120

ADD FIELD "user_notes" OF "comdet" AS character 
  FORMAT "x(2000)"
  INITIAL ""
  LABEL "User Notes"
  POSITION 4
  MAX-WIDTH 4000
  VIEW-AS "view-as editor size-chars 30 by 5 scrollbar-vertical"
  ORDER 140

ADD FIELD "system_notes" OF "comdet" AS character 
  FORMAT "x(2000)"
  INITIAL ""
  LABEL "System Notes"
  POSITION 5
  MAX-WIDTH 4000
  VIEW-AS "view-as editor size-chars 30 by 5 scrollbar-vertical"
  ORDER 130

ADD FIELD "record_type" OF "comdet" AS character 
  FORMAT "X(6)"
  INITIAL ""
  LABEL "Record Type"
  POSITION 6
  MAX-WIDTH 12
  HELP "Record type."
  ORDER 10
  MANDATORY

ADD FIELD "procedure_name" OF "comdet" AS character 
  FORMAT "x(20)"
  INITIAL ?
  LABEL "Procedure Name"
  POSITION 7
  MAX-WIDTH 40
  HELP "Name of the procedure for this record."
  ORDER 80

ADD FIELD "num_decimals" OF "comdet" AS integer 
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Decimals"
  POSITION 8
  MAX-WIDTH 4
  ORDER 100

ADD FIELD "field_start" OF "comdet" AS integer 
  DESCRIPTION "Offset field within input string. Negative, if offset counted from the end of the string."
  FORMAT "->,>>9"
  INITIAL "0"
  LABEL "Starting Position"
  POSITION 9
  MAX-WIDTH 4
  HELP "Starting Position of this field in input string."
  ORDER 40
  MANDATORY

ADD FIELD "field_position" OF "comdet" AS integer 
  DESCRIPTION "DON'T RELY ON THIS FIELD; IT MAY GO AWAY!"
  FORMAT ">,>>9"
  INITIAL "0"
  POSITION 10
  MAX-WIDTH 4
  HELP "Field position, used as a help when creating the data"
  ORDER 50

ADD FIELD "field_name" OF "comdet" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Field Name"
  POSITION 11
  MAX-WIDTH 30
  ORDER 30
  MANDATORY

ADD FIELD "field_length" OF "comdet" AS integer 
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Field Length"
  POSITION 12
  MAX-WIDTH 4
  HELP "Length of this field in the input string."
  ORDER 60
  MANDATORY

ADD FIELD "data_type" OF "comdet" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Data Type"
  POSITION 13
  MAX-WIDTH 30
  ORDER 110

ADD FIELD "custom_data" OF "comdet" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 14
  MAX-WIDTH 510
  EXTENT 5
  ORDER 150

ADD FIELD "add_in_reply" OF "comdet" AS logical 
  DESCRIPTION "Field added in the reply record (error code, error message)"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 15
  MAX-WIDTH 1
  HELP "Field added in IRMS reply."
  ORDER 90

ADD FIELD "active" OF "comdet" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  POSITION 16
  MAX-WIDTH 1
  HELP "Process this field?"
  ORDER 70
  MANDATORY

ADD INDEX "version_type_start" ON "comdet" 
  AREA "misc128_idx"
  PRIMARY
  INDEX-FIELD "version" ASCENDING 
  INDEX-FIELD "record_type" ASCENDING 
  INDEX-FIELD "field_start" ASCENDING 

ADD INDEX "version_type_active_reply_start" ON "comdet" 
  AREA "misc128_idx"
  INDEX-FIELD "version" ASCENDING 
  INDEX-FIELD "record_type" ASCENDING 
  INDEX-FIELD "active" ASCENDING 
  INDEX-FIELD "add_in_reply" ASCENDING 
  INDEX-FIELD "field_start" ASCENDING 

ADD INDEX "version_type_name" ON "comdet" 
  AREA "misc128_idx"
  UNIQUE
  INDEX-FIELD "version" ASCENDING 
  INDEX-FIELD "record_type" ASCENDING 
  INDEX-FIELD "field_name" ASCENDING 

ADD TABLE "comm_doc_source"
  AREA "misc64_dat"
  DESCRIPTION "Reference table defining API communication document sources."
  DUMP-NAME "comm_doc_source"

ADD FIELD "co_num" OF "comm_doc_source" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "co_num"
  POSITION 2
  MAX-WIDTH 8
  COLUMN-LABEL "co_num"
  ORDER 10

ADD FIELD "wh_num" OF "comm_doc_source" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "wh_num"
  POSITION 3
  MAX-WIDTH 8
  COLUMN-LABEL "wh_num"
  ORDER 20

ADD FIELD "doc_source" OF "comm_doc_source" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Doc Source"
  POSITION 4
  MAX-WIDTH 20
  COLUMN-LABEL "Doc Source"
  HELP "Enter the document source code."
  ORDER 30

ADD FIELD "description" OF "comm_doc_source" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Description"
  POSITION 5
  MAX-WIDTH 80
  COLUMN-LABEL "Description"
  ORDER 40

ADD INDEX "id" ON "comm_doc_source" 
  AREA "misc64_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "doc_source" ASCENDING 

ADD TABLE "comm_doc_type"
  AREA "misc64_dat"
  DESCRIPTION "Reference table defining API communication document types and their processing configuration."
  DUMP-NAME "comm_doc_type"

ADD FIELD "co_num" OF "comm_doc_type" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "co_num"
  POSITION 2
  MAX-WIDTH 8
  COLUMN-LABEL "co_num"
  ORDER 10

ADD FIELD "wh_num" OF "comm_doc_type" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "wh_num"
  POSITION 3
  MAX-WIDTH 8
  COLUMN-LABEL "wh_num"
  ORDER 20

ADD FIELD "doc_source" OF "comm_doc_type" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Doc Source"
  POSITION 4
  MAX-WIDTH 20
  COLUMN-LABEL "Doc Source"
  HELP "Enter the document source code."
  ORDER 30

ADD FIELD "doc_type" OF "comm_doc_type" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Doc Type"
  POSITION 5
  MAX-WIDTH 40
  COLUMN-LABEL "Doc Type"
  HELP "Enter the document type code."
  ORDER 40

ADD FIELD "description" OF "comm_doc_type" AS character 
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Description"
  POSITION 6
  MAX-WIDTH 80
  COLUMN-LABEL "Description"
  ORDER 50

ADD FIELD "doc_id_type" OF "comm_doc_type" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "Doc ID Type"
  POSITION 7
  MAX-WIDTH 32
  COLUMN-LABEL "Doc ID Type"
  HELP "Label used to identify the doc_id field (e.g. Order #, Event ID)."
  ORDER 60

ADD FIELD "process_manager" OF "comm_doc_type" AS character 
  FORMAT "x(16)"
  INITIAL ""
  LABEL "Process Manager"
  POSITION 8
  MAX-WIDTH 32
  COLUMN-LABEL "Process Manager"
  HELP "Log file prefix used by the cron job managing this document type."
  ORDER 70

ADD FIELD "process_program" OF "comm_doc_type" AS character 
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Process Program"
  POSITION 9
  MAX-WIDTH 120
  COLUMN-LABEL "Process Program"
  HELP "Enter the program that processes this document type."
  ORDER 80

ADD FIELD "active" OF "comm_doc_type" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 10
  MAX-WIDTH 1
  COLUMN-LABEL "Active"
  ORDER 90

ADD FIELD "retry_count_limit" OF "comm_doc_type" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Retry Count Limit"
  POSITION 11
  MAX-WIDTH 4
  COLUMN-LABEL "Retry Limit"
  HELP "Number of retries before transitioning to an error state."
  ORDER 100

ADD FIELD "start_hour" OF "comm_doc_type" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Start Hour"
  POSITION 12
  MAX-WIDTH 4
  COLUMN-LABEL "Start Hour"
  HELP "Hour that processing begins (0-23)."
  ORDER 110

ADD FIELD "end_hour" OF "comm_doc_type" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "End Hour"
  POSITION 13
  MAX-WIDTH 4
  COLUMN-LABEL "End Hour"
  HELP "Hour that processing ends (0-23)."
  ORDER 120

ADD FIELD "start_minute" OF "comm_doc_type" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Start Minute"
  POSITION 14
  MAX-WIDTH 4
  COLUMN-LABEL "Start Min"
  HELP "Minute that processing begins (0-59)."
  ORDER 130

ADD FIELD "end_minute" OF "comm_doc_type" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "End Minute"
  POSITION 15
  MAX-WIDTH 4
  COLUMN-LABEL "End Min"
  HELP "Minute that processing ends (0-59)."
  ORDER 140

ADD FIELD "empty_interval" OF "comm_doc_type" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Empty Interval"
  POSITION 16
  MAX-WIDTH 4
  COLUMN-LABEL "Empty Int"
  HELP "Seconds to pause after encountering no records."
  ORDER 150

ADD FIELD "process_interval" OF "comm_doc_type" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Process Interval"
  POSITION 17
  MAX-WIDTH 4
  COLUMN-LABEL "Proc Int"
  HELP "Seconds to pause after completing a record's processing."
  ORDER 160

ADD FIELD "logging_level" OF "comm_doc_type" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Logging Level"
  POSITION 18
  MAX-WIDTH 4
  COLUMN-LABEL "Log Level"
  HELP "Higher values produce more verbose log output."
  ORDER 170

ADD FIELD "archive_days" OF "comm_doc_type" AS integer 
  FORMAT "->,>>>,>>9"
  INITIAL "-1"
  LABEL "Archive Days"
  POSITION 19
  MAX-WIDTH 4
  COLUMN-LABEL "Archive Days"
  HELP "Days to retain clob data (-1 = retain forever)."
  ORDER 180

ADD FIELD "maximum_processes" OF "comm_doc_type" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "1"
  LABEL "Maximum Processes"
  POSITION 20
  MAX-WIDTH 4
  COLUMN-LABEL "Max Proc"
  HELP "Maximum concurrent processes for this document type."
  ORDER 190

ADD INDEX "id" ON "comm_doc_type" 
  AREA "misc64_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "doc_source" ASCENDING 
  INDEX-FIELD "doc_type" ASCENDING 

ADD INDEX "by-source" ON "comm_doc_type" 
  AREA "misc64_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "doc_source" ASCENDING 

ADD TABLE "comm_endpoint"
  AREA "misc64_dat"
  DUMP-NAME "comm_endpoint"

ADD FIELD "host_source" OF "comm_endpoint" AS character 
  DESCRIPTION "The host source for this endpoint."
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Host Source"
  POSITION 2
  MAX-WIDTH 16
  ORDER 10

ADD FIELD "record_type" OF "comm_endpoint" AS character 
  DESCRIPTION "The record type for this endpoint."
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Record Type"
  POSITION 3
  MAX-WIDTH 12
  ORDER 20

ADD FIELD "version" OF "comm_endpoint" AS character 
  DESCRIPTION "The version of this endpoint."
  FORMAT "x(2)"
  INITIAL ""
  LABEL "Version"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "comm_endpoint" OF "comm_endpoint" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Comm Endpoint"
  POSITION 5
  MAX-WIDTH 20
  ORDER 40

ADD FIELD "active" OF "comm_endpoint" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Active"
  POSITION 6
  MAX-WIDTH 1
  ORDER 50

ADD INDEX "source_type_version" ON "comm_endpoint" 
  AREA "misc64_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "host_source" ASCENDING 
  INDEX-FIELD "record_type" ASCENDING 
  INDEX-FIELD "version" ASCENDING 

ADD TABLE "comment"
  AREA "misc128_dat"
  LABEL "Comments Table"
  DESCRIPTION "Hold multi-line comments for orders and RTs."
  DUMP-NAME "comment"
  TABLE-TRIGGER "Create" OVERRIDE PROCEDURE "n_commen.t" CRC "?" 

ADD FIELD "type" OF "comment" AS character 
  DESCRIPTION "Order, RT, etc..."
  FORMAT "x(2)"
  INITIAL "O"
  LABEL "Comment Type"
  POSITION 2
  MAX-WIDTH 4
  VIEW-AS "view-as radio-set radio-buttons
""Order"", ""O"", ""R/T"", ""R"""
  HELP "Comment Type"
  ORDER 20

ADD FIELD "line_sequence" OF "comment" AS integer 
  DESCRIPTION "Used for orddtl.line_sequence"
  FORMAT ">,>>9"
  INITIAL "0"
  LABEL "Line Sequence"
  POSITION 3
  MAX-WIDTH 4
  HELP "Line Sequence"
  ORDER 50

ADD FIELD "line" OF "comment" AS integer 
  DESCRIPTION "orddtl.line, rtdet.line_num, Zero for header comments"
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Line"
  POSITION 4
  MAX-WIDTH 4
  HELP "Line."
  ORDER 40

ADD FIELD "id" OF "comment" AS integer 
  FORMAT ">,>>>,>>>,>>9"
  INITIAL "0"
  LABEL "Parent ID"
  POSITION 5
  MAX-WIDTH 4
  HELP "ID of order or RT for this comment"
  ORDER 30

ADD FIELD "custom_data" OF "comment" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 510
  EXTENT 5
  ORDER 90

ADD FIELD "comment_text" OF "comment" AS character 
  DESCRIPTION "One line of comments"
  FORMAT "x(80)"
  INITIAL ""
  LABEL "Comment Text"
  POSITION 7
  MAX-WIDTH 160
  HELP "Comment text."
  ORDER 70

ADD FIELD "comment_num" OF "comment" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  POSITION 8
  MAX-WIDTH 4
  HELP "Field assigned automatically. Don't modify!"
  ORDER 10
  MANDATORY

ADD FIELD "comment_line" OF "comment" AS integer 
  DESCRIPTION "Comment sequence number to allow more than one line of comments to each entity."
  FORMAT ">,>>9"
  INITIAL "0"
  LABEL "Comment Line"
  POSITION 9
  MAX-WIDTH 4
  HELP "Comment Line."
  ORDER 60

ADD FIELD "attributes" OF "comment" AS character 
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Attributes"
  POSITION 10
  MAX-WIDTH 100
  HELP "Attribute list."
  ORDER 80

ADD INDEX "type_id_line_seq_cline" ON "comment" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "type" ASCENDING 
  INDEX-FIELD "id" ASCENDING 
  INDEX-FIELD "line" ASCENDING 
  INDEX-FIELD "line_sequence" ASCENDING 
  INDEX-FIELD "comment_line" ASCENDING 

ADD INDEX "comment_num" ON "comment" 
  AREA "misc128_idx"
  UNIQUE
  DESCRIPTION "enforce uniqueness"
  INDEX-FIELD "comment_num" ASCENDING 

ADD TABLE "comment_attribute"
  AREA "unused_dat"
  LABEL "Comment Attribute"
  DUMP-NAME "commattr"

ADD FIELD "row_status" OF "comment_attribute" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Active"
  POSITION 2
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  ORDER 50
  MANDATORY

ADD FIELD "description" OF "comment_attribute" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Description"
  POSITION 3
  MAX-WIDTH 60
  ORDER 20

ADD FIELD "custom_data" OF "comment_attribute" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 4
  MAX-WIDTH 510
  EXTENT 5
  ORDER 40

ADD FIELD "code" OF "comment_attribute" AS character 
  FORMAT "x(2)"
  INITIAL ""
  LABEL "Attribute"
  POSITION 5
  MAX-WIDTH 4
  ORDER 10

ADD INDEX "code-key" ON "comment_attribute" 
  AREA "unused_idx"
  PRIMARY
  INDEX-FIELD "code" ASCENDING 

ADD TABLE "commst"
  AREA "misc128_dat"
  LABEL "Communications Master"
  DESCRIPTION "Containst master record information for each of the record
formats used by the interface"
  DUMP-NAME "commst"

ADD FIELD "version" OF "commst" AS character 
  DESCRIPTION "(Will be used for validation.)"
  FORMAT "X(2)"
  INITIAL "31"
  POSITION 2
  MAX-WIDTH 4
  HELP "The version number for this record format."
  ORDER 20
  MANDATORY

ADD FIELD "user_notes" OF "commst" AS character 
  FORMAT "x(2000)"
  INITIAL ""
  LABEL "User Notes"
  POSITION 3
  MAX-WIDTH 4000
  VIEW-AS "view-as editor size-chars 30 by 5 scrollbar-vertical"
  ORDER 180

ADD FIELD "upload" OF "commst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 4
  MAX-WIDTH 1
  HELP "Is this an upload format?"
  ORDER 60
  MANDATORY

ADD FIELD "trans_type" OF "commst" AS character 
  DESCRIPTION "Used for uploads (IRMS CLIENT)."
  FORMAT "x(2)"
  INITIAL ?
  LABEL "Transaction Type"
  POSITION 5
  MAX-WIDTH 4
  VALMSG "Transaction type which triggers this upload"
  HELP "Transaction type which triggers this upload."
  ORDER 70

ADD FIELD "trailer" OF "commst" AS character 
  FORMAT "x(6)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 12
  HELP "Name of the trailer format (for multiple-record uploads)."
  ORDER 140

ADD FIELD "system_notes" OF "commst" AS character 
  FORMAT "x(2000)"
  INITIAL ""
  LABEL "System Notes"
  POSITION 7
  MAX-WIDTH 4000
  VIEW-AS "view-as editor size-chars 30 by 5 scrollbar-vertical"
  ORDER 170

ADD FIELD "store_procedure" OF "commst" AS character 
  FORMAT "x(30)"
  INITIAL ?
  LABEL "Store Procedure"
  POSITION 8
  MAX-WIDTH 60
  HELP "Procedure used to store the data to database."
  ORDER 150

ADD FIELD "record_type" OF "commst" AS character 
  FORMAT "X(6)"
  INITIAL ""
  LABEL "Record Type"
  POSITION 9
  MAX-WIDTH 12
  HELP "Record type."
  ORDER 10
  MANDATORY

ADD FIELD "record_length" OF "commst" AS integer 
  DESCRIPTION "If there is a number here, interface will assure record is this long."
  FORMAT ">>,>>9"
  INITIAL ?
  LABEL "Record Length"
  POSITION 10
  MAX-WIDTH 4
  HELP "Total record length (or ? if N/A)."
  ORDER 30

ADD FIELD "procedure_name" OF "commst" AS character 
  DESCRIPTION "Server: procedure that writes to database; client finalizing procedure"
  FORMAT "x(20)"
  INITIAL ?
  LABEL "Procedure Name"
  POSITION 11
  MAX-WIDTH 40
  HELP "Name of the procedure to write this record format."
  ORDER 120

ADD FIELD "multiple" OF "commst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 12
  MAX-WIDTH 1
  HELP "Multiple-record format?"
  ORDER 130
  MANDATORY

ADD FIELD "last_sent_time" OF "commst" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Time Last Sent"
  POSITION 13
  MAX-WIDTH 32
  HELP "Time last record of this type was processed."
  ORDER 90

ADD FIELD "last_sent_number" OF "commst" AS decimal 
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "Last Number Sent"
  POSITION 14
  MAX-WIDTH 15
  HELP "Number of last message of this type processed."
  DECIMALS 0
  ORDER 80
  MANDATORY

ADD FIELD "last_ack_time" OF "commst" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Time Last Acknowledged"
  POSITION 15
  MAX-WIDTH 32
  HELP "Time last record of this type was acknowledged."
  ORDER 110

ADD FIELD "last_ack_number" OF "commst" AS decimal 
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "Last Number Acknowledged"
  POSITION 16
  MAX-WIDTH 15
  HELP "Number of last message of this type which was acknowledged."
  DECIMALS 0
  ORDER 100
  MANDATORY

ADD FIELD "end_marker" OF "commst" AS character 
  FORMAT "X"
  INITIAL ?
  LABEL "End Marker"
  POSITION 17
  MAX-WIDTH 2
  HELP "If non-null, IRMS will insert this as last character in record."
  ORDER 40

ADD FIELD "custom_data" OF "commst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 18
  MAX-WIDTH 510
  EXTENT 5
  ORDER 190

ADD FIELD "comments" OF "commst" AS character 
  DESCRIPTION "Freeform comments, to be used as desired, or left blank if there is no"
  FORMAT "x(50)"
  INITIAL ?
  POSITION 19
  MAX-WIDTH 100
  HELP "Comments."
  ORDER 160

ADD FIELD "active" OF "commst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 20
  MAX-WIDTH 1
  HELP "Is this record format processed by IRMS?"
  ORDER 50
  MANDATORY

ADD INDEX "type_version" ON "commst" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "record_type" ASCENDING 
  INDEX-FIELD "version" ASCENDING 

ADD INDEX "active_upload_trans_type" ON "commst" 
  AREA "misc128_idx"
  INDEX-FIELD "active" ASCENDING 
  INDEX-FIELD "upload" ASCENDING 
  INDEX-FIELD "trans_type" ASCENDING 

ADD INDEX "version_type" ON "commst" 
  AREA "misc128_idx"
  UNIQUE
  INDEX-FIELD "version" ASCENDING 
  INDEX-FIELD "record_type" ASCENDING 

ADD TABLE "consolidation_ref"
  AREA "misc128_dat"
  DUMP-NAME "consolidation_ref"

