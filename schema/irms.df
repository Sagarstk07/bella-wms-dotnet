  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Inventory ID"
  HELP "Enter the Inventory ID that the LPN is matched to."
  ORDER 90

ADD FIELD "row_status" OF "lpn" AS character 
  DESCRIPTION "Describes whether or not the LPN is in flux in the warehouse.                                                                               "
  FORMAT "x(4)"
  INITIAL "I"
  LABEL "Status"
  POSITION 11
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "Status"
  HELP "Enter (I)nactive or (A)ctive to set the state of the LPN."
  ORDER 80

ADD FIELD "abs_num" OF "lpn" AS character 
  DESCRIPTION "Describes the item that is contained in the LPN carton.                                                                                     "
  FORMAT "x(24)"
