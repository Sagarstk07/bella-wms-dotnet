ADD FIELD "description" OF "countrymst" AS character 
  FORMAT "X(40)"
  INITIAL ""
  LABEL "Description"
  POSITION 2
  MAX-WIDTH 80
  HELP "Country name."
  ORDER 20

ADD FIELD "custom_data" OF "countrymst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 3
  MAX-WIDTH 510
  EXTENT 5
  ORDER 30

ADD FIELD "country_code" OF "countrymst" AS character 
  FORMAT "XX"
  INITIAL ""
  LABEL "Country Code"
  POSITION 4
  MAX-WIDTH 4
  VALMSG "Please enter a Country Code."
  HELP "Please enter a Country Code."
  ORDER 10
  MANDATORY

ADD INDEX "country-code" ON "countrymst" 
  AREA "misc128_idx"
  PRIMARY
  INDEX-FIELD "country_code" ASCENDING 

ADD TABLE "cust_item"
  AREA "unused_dat"
  LABEL "Customer Item Cross-reference."
  DESCRIPTION "Table is a cross-reference of item numbers, if we need to use a customer's item number instead of our own."
  DUMP-NAME "cust_ite"

ADD FIELD "wh_num" OF "cust_item" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "row_status" OF "cust_item" AS logical 
  DESCRIPTION "active or inactive"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 3
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this customer item code active?"
  ORDER 80
  MANDATORY

ADD FIELD "cust_item" OF "cust_item" AS character 
  DESCRIPTION "Customer's item number."
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Customer's Item Number"
  POSITION 4
  MAX-WIDTH 48
  VALMSG "Please enter the company-wide code for this item."
  HELP "Enter the customer's code for this item."
  ORDER 50
  MANDATORY

ADD FIELD "cust_code" OF "cust_item" AS character 
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Customer Id"
  POSITION 5
  MAX-WIDTH 24
  VALMSG "Please enter a code for this customer."
  HELP "Customer code."
  ORDER 30
  MANDATORY

ADD FIELD "custom_data" OF "cust_item" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 510
  EXTENT 5
  ORDER 70

ADD FIELD "co_num" OF "cust_item" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 7
  MAX-WIDTH 8
  VALMSG "Company must be defined in Company Master table first."
  HELP "Enter the company number."
  ORDER 10

ADD FIELD "abs_num" OF "cust_item" AS character 
  DESCRIPTION "Company-wide absolute number."
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Item Number"
  POSITION 8
  MAX-WIDTH 48
  VALMSG "Please enter the company-wide code for this item."
  HELP "Enter the company-wide unique code for this item."
  ORDER 40
  MANDATORY

ADD INDEX "co_wh_cust_abs" ON "cust_item" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "cust_code" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 

ADD INDEX "co_wh_cust_custitem" ON "cust_item" 
  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "cust_code" ASCENDING 
  INDEX-FIELD "cust_item" ASCENDING 

ADD TABLE "cust_rule_sel"
  AREA "unused_dat"
  LABEL "Customer Rule Select"
  DESCRIPTION "Holds sets of rules for customers."
  DUMP-NAME "custrul"
  TABLE-TRIGGER "CREATE" OVERRIDE PROCEDURE "n_cust_rule_sel.t" CRC "?" 

ADD FIELD "co_num" OF "cust_rule_sel" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the company."
  ORDER 10

ADD FIELD "wh_num" OF "cust_rule_sel" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 3
  MAX-WIDTH 8
  HELP "Enter the warehouse id ('*' for all warehouses)."
  ORDER 15

ADD FIELD "cust_number" OF "cust_rule_sel" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Customer"
  POSITION 4
  MAX-WIDTH 20
  HELP "Enter the customer's unique Customer Number (ID Number)."
  ORDER 20

ADD FIELD "type" OF "cust_rule_sel" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Rule Type"
  POSITION 5
  MAX-WIDTH 40
  COLUMN-LABEL "Type"
  HELP "Enter the type for this rule."
  ORDER 30

ADD FIELD "priority" OF "cust_rule_sel" AS integer 
  FORMAT ">,>>9"
  INITIAL "1"
  LABEL "Priority"
  POSITION 6
  MAX-WIDTH 10
  HELP "Enter the priority of this rule type."
  ORDER 40

ADD FIELD "type_level" OF "cust_rule_sel" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Type Level"
  POSITION 7
  MAX-WIDTH 40
  COLUMN-LABEL "Level"
  HELP "Enter the level in which to apply the type."
  ORDER 50

ADD FIELD "rule_value" OF "cust_rule_sel" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Rule Value"
  POSITION 8
  MAX-WIDTH 60
  COLUMN-LABEL "Value"
  HELP "Enter the value for this rule type."
  ORDER 60

ADD FIELD "impact_file" OF "cust_rule_sel" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Impact File"
  POSITION 9
  MAX-WIDTH 60
  HELP "Enter the impact file for this rule."
  ORDER 70

ADD FIELD "impact_id" OF "cust_rule_sel" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Impact id"
  POSITION 10
  MAX-WIDTH 60
  HELP "Enter the impact id of impact file for this rule."
  ORDER 80

ADD FIELD "weight_impact" OF "cust_rule_sel" AS decimal 
  FORMAT "->>>,>>9.9999"
  INITIAL "0"
  LABEL "Weight"
  POSITION 11
  MAX-WIDTH 26
  HELP "Enter the impact on weight for this rule value."
  DECIMALS 4
  ORDER 90

ADD FIELD "volume_impact" OF "cust_rule_sel" AS decimal 
  FORMAT "->>>,>>9.9999"
  INITIAL "0"
  LABEL "Volume"
  POSITION 12
  MAX-WIDTH 26
  HELP "Enter the impact on volume for this rule value."
  DECIMALS 4
  ORDER 100

ADD FIELD "check_point" OF "cust_rule_sel" AS character 
  DESCRIPTION "Can be used to group rules."
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Check Point"
  POSITION 13
  MAX-WIDTH 30
  HELP "Enter the point in which to apply this rule."
  ORDER 110

ADD FIELD "id" OF "cust_rule_sel" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "id"
  POSITION 14
  MAX-WIDTH 20
  HELP "Enter the unique id. Generated automatically by create trig."
  ORDER 120

ADD INDEX "co-wh-cust-type-pri" ON "cust_rule_sel" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "cust_number" ASCENDING 
  INDEX-FIELD "type" ASCENDING 
  INDEX-FIELD "priority" ASCENDING 
  INDEX-FIELD "type_level" ASCENDING 
  INDEX-FIELD "impact_file" ASCENDING 

ADD INDEX "id" ON "cust_rule_sel" 
  AREA "unused_idx"
  UNIQUE
  INDEX-FIELD "id" ASCENDING 

ADD TABLE "custaddr"
