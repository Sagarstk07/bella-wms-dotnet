  COLUMN-LABEL "Allow Full Case"
  HELP "Will this location allow both primary and full case picks?"
  ORDER 380

ADD FIELD "cycle_level" OF "binmst" AS character 
  DESCRIPTION "system or wave                                                                                                                              "
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Cycle Count Level"
  POSITION 37
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "Level"
