ADD TABLE "carrier"
  AREA "misc64_dat"
  LABEL "Carrier Master"
  DESCRIPTION "Carriers table."
  DUMP-NAME "carrier"

ADD FIELD "ftp_protocol" OF "carrier" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Protocol"
  POSITION 2
  MAX-WIDTH 20
  VIEW-AS ""
  COLUMN-LABEL "Protocol"
  HELP "Select FTP Protocol."
  ORDER 520

ADD FIELD "blend_pick_ship_lbl" OF "carrier" AS logical 
  DESCRIPTION "Determines if the hybrid label will replace the standard labels"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Blended Label"
  POSITION 3
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "Blend Lbl"
  ORDER 510

ADD FIELD "packlist_prg" OF "carrier" AS character 
  DESCRIPTION "This will store the packlist program to use for this carrier."
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Packlist Program"
  POSITION 4
  MAX-WIDTH 80
  VIEW-AS ""
  COLUMN-LABEL "Packlist Prg"
  HELP "Stores the packlist program"
  ORDER 500

ADD FIELD "parcel_carrier" OF "carrier" AS logical 
  DESCRIPTION "Enter if this carrier is a parcel carrier.                                                                                                  "
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Parcel Carrier"
  POSITION 5
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "PC"
  VALMSG "Enter if this carrier is a parcel carrier."
  HELP "Enter if this carrier is a parcel carrier."
  ORDER 490

ADD FIELD "notify_email_list" OF "carrier" AS character 
  DESCRIPTION "Stores an email address list of recipients for carrier related info.                                                                        "
  FORMAT "x(256)"
  INITIAL ""
  LABEL "Email Notification List"
  POSITION 6
  MAX-WIDTH 512
  VIEW-AS ""
  COLUMN-LABEL "Email Notify List"
  HELP "Enter an email address list of recipients for notifications."
  ORDER 480

ADD FIELD "cutoff_time" OF "carrier" AS integer 
  DESCRIPTION "This field represents the cutoff time for the carrier.                                                                                      "
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "Cutoff Time"
  POSITION 7
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "COT"
  VALMSG "Enter the Cutoff Time."
  HELP "Enter the Cutoff Time."
  ORDER 470

ADD FIELD "ship_system_params" OF "carrier" AS character 
  DESCRIPTION "Parameter Values                                                                                                                            "
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Values"
  POSITION 8
  MAX-WIDTH 1220
  VIEW-AS ""
  COLUMN-LABEL "Values"
  VALMSG "Enter the parameter values."
  HELP "Enter the parameter values."
  EXTENT 10
  ORDER 460

ADD FIELD "dockclose_prg" OF "carrier" AS character 
  DESCRIPTION "Dockclose Program                                                                                                                           "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Dockclose Program"
  POSITION 9
  MAX-WIDTH 80
  VIEW-AS ""
  COLUMN-LABEL "Dockclose!Prg"
  VALMSG "Enter the Dockclose Program to use with this carrier."
  HELP "Enter the Dockclose Program to use with this carrier."
  ORDER 450

ADD FIELD "ship_prg" OF "carrier" AS character 
  DESCRIPTION "Ship Program                                                                                                                                "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Ship Program"
  POSITION 10
  MAX-WIDTH 80
  VIEW-AS ""
  COLUMN-LABEL "Ship!Prg"
  VALMSG "Enter the Shipping Program to use with this carrier."
  HELP "Enter the Shipping Program to use with this carrier."
  ORDER 440

ADD FIELD "label_prg" OF "carrier" AS character 
  DESCRIPTION "Label Program                                                                                                                               "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Label Program"
  POSITION 11
  MAX-WIDTH 80
  VIEW-AS ""
  COLUMN-LABEL "Label!Prg"
  VALMSG "Enter the Label Program to use for this carrier."
  HELP "Enter the Label Program to use for this carrier."
  ORDER 430

ADD FIELD "rate_prg" OF "carrier" AS character 
  DESCRIPTION "Rate program                                                                                                                                "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Rate Program"
  POSITION 12
  MAX-WIDTH 80
  VIEW-AS ""
  COLUMN-LABEL "Rate!Prg"
  VALMSG "Enter the Rate Program to use with this carrier."
  HELP "Enter the Rate Program to use with this carrier."
  ORDER 420

ADD FIELD "ship_system" OF "carrier" AS character 
  DESCRIPTION "Ship System                                                                                                                                 "
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Ship System"
  POSITION 13
  MAX-WIDTH 20
