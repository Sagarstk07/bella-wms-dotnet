ADD TABLE "wave"
  AREA "misc64_dat"
  LABEL "Wave Table"
  DESCRIPTION "Contain information about ""waves"" (which are a collection of
orders released for picking together)."
  DUMP-NAME "wave"

ADD FIELD "wh_num" OF "wave" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "weight" OF "wave" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Weight"
  POSITION 3
  MAX-WIDTH 17
  HELP "Weight for this wave"
  DECIMALS 2
  ORDER 70

ADD FIELD "wave_status" OF "wave" AS character 
  FORMAT "X"
  INITIAL "O"
  LABEL "Status"
  POSITION 4
  MAX-WIDTH 2
  ORDER 220

ADD FIELD "task_id" OF "wave" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  LABEL "Task Id"
  POSITION 5
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "single_line_orders" OF "wave" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "Single Line Orders"
  POSITION 6
  MAX-WIDTH 4
  HELP "Number of single-line orders in a wave."
  ORDER 140

ADD FIELD "ship_weight" OF "wave" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Ship Weight"
  POSITION 7
  MAX-WIDTH 17
  HELP "Weight for this wave"
  DECIMALS 2
  ORDER 190

ADD FIELD "ship_price" OF "wave" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Ship Price"
  POSITION 8
  MAX-WIDTH 17
  HELP "Price of the wave at ship time."
  DECIMALS 2
  ORDER 130

ADD FIELD "ship_date_time" OF "wave" AS character 
  DESCRIPTION "Time stamp for this particular activity."
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Ship Time"
  POSITION 9
  MAX-WIDTH 32
  ORDER 110

ADD FIELD "ship_cube" OF "wave" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Ship Cube"
  POSITION 10
  MAX-WIDTH 17
  HELP "Total cube for this wave"
  DECIMALS 2
  ORDER 180

ADD FIELD "order_count" OF "wave" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Orders"
  POSITION 11
  MAX-WIDTH 4
  HELP "Number of orders in this wave."
  ORDER 60

ADD FIELD "line_count" OF "wave" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Lines"
  POSITION 12
  MAX-WIDTH 4
  HELP "Number of order lines in this wave"
  ORDER 50

ADD FIELD "host_batch" OF "wave" AS character 
  DESCRIPTION "Host-assigned wave id."
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Host Wave"
  POSITION 13
  MAX-WIDTH 20
  HELP "Host-assigned wave id."
  ORDER 160

ADD FIELD "emp_num" OF "wave" AS character 
  DESCRIPTION "Employee who associated the wave to a cart."
  FORMAT "x(5)"
  INITIAL ""
  LABEL "Employee Number"
  POSITION 14
  MAX-WIDTH 10
  COLUMN-LABEL ""
  HELP "Employee who associated this wave to a cart."
  ORDER 170

ADD FIELD "drop_price" OF "wave" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Drop Price"
  POSITION 15
  MAX-WIDTH 17
  HELP "Price of the wave at drop time."
  DECIMALS 2
  ORDER 120

ADD FIELD "drop_date_time" OF "wave" AS character 
  DESCRIPTION "Time stamp for this particular activity."
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Drop Time"
  POSITION 16
  MAX-WIDTH 32
  ORDER 90

ADD FIELD "custom_data" OF "wave" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 17
  MAX-WIDTH 510
  EXTENT 5
  ORDER 210

ADD FIELD "cube" OF "wave" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Cube"
  POSITION 18
  MAX-WIDTH 17
  HELP "Total cube for this wave"
  DECIMALS 2
  ORDER 80

ADD FIELD "co_num" OF "wave" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 19
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10
  MANDATORY

ADD FIELD "cart" OF "wave" AS character 
  DESCRIPTION "Used to associate a wave to a cart (multipel waves can be associated to a cart, but only one cart can be associated to a wave)."
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Cart"
  POSITION 20
  MAX-WIDTH 40
  HELP "Cart used for this wave"
  ORDER 150

ADD FIELD "batch" OF "wave" AS integer 
  DESCRIPTION "This number is generated by sequence, and it uniquely identifies a batch of orders. It is used for reprint purposes. It is printed on the pick label, but not barcoded."
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Order Batch"
  POSITION 21
  MAX-WIDTH 4
  HELP "Don't change this field."
  ORDER 30

ADD FIELD "active_date_time" OF "wave" AS character 
  DESCRIPTION "Time stamp for this particular activity."
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Active Time"
  POSITION 22
  MAX-WIDTH 32
  ORDER 100

ADD INDEX "co_wh_wave" ON "wave" 
  AREA "misc64_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "batch" ASCENDING 

ADD INDEX "co_wh_cart_status" ON "wave" 
  AREA "misc64_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "cart" ASCENDING 
  INDEX-FIELD "wave_status" ASCENDING 

ADD INDEX "co_wh_hostbatch" ON "wave" 
  AREA "misc64_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "host_batch" ASCENDING 

ADD INDEX "co_wh_status_batch" ON "wave" 
  AREA "misc64_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "wave_status" ASCENDING 
  INDEX-FIELD "batch" ASCENDING 

ADD INDEX "wave" ON "wave" 
  AREA "misc64_idx"
  INDEX-FIELD "batch" ASCENDING 

ADD TABLE "wh_zone"
  AREA "misc128_dat"
  LABEL "Warehouse Zone"
  DESCRIPTION "All warehouse zones known to IRMS."
  DUMP-NAME "wh_zone"

ADD FIELD "pick_level" OF "wh_zone" AS integer 
  DESCRIPTION "Used for Zone Heirarchy pick creation prioritizing."
  FORMAT ">>9"
  INITIAL "1"
  LABEL "Pick Level"
  POSITION 2
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Pick Lvl"
  HELP "Enter the Pick Level of this Warehouse Zone."
  ORDER 190

ADD FIELD "fulfillment_zone" OF "wh_zone" AS logical 
  DESCRIPTION "Stores whether the zone is a fulfillment zone or not.                                                                                       "
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Fulfillment Zone"
  POSITION 3
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "Fulfillment"
  HELP "Enter Yes if this zone is a fulfillment zone."
  ORDER 180

ADD FIELD "replen_scale" OF "wh_zone" AS integer 
  DESCRIPTION "Contains the # of replen levels to which it can pull from.                                                                                  "
  FORMAT ">>9"
  INITIAL "999"
  LABEL "Replen Scale"
  POSITION 4
  MAX-WIDTH 6
  COLUMN-LABEL "Repl Scale"
  HELP "Enter the Replen Scale for this Warehouse Zone."
  ORDER 170

ADD FIELD "replen_level" OF "wh_zone" AS integer 
  DESCRIPTION "Used for Zone Heirarchy replenishment priorities.                                                                                           "
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Replen Level"
  POSITION 5
  MAX-WIDTH 6
  COLUMN-LABEL "Repl Lvl"
  HELP "Enter the Replenishment Level of this Warehouse Zone."
  ORDER 160

ADD FIELD "piece_label_proc" OF "wh_zone" AS character 
  DESCRIPTION "Stores the internal procedure name for a piece label override.                                                                              "
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Piece Label Proc"
  POSITION 6
  MAX-WIDTH 40
  HELP "Enter the internal procedure name for a piece label override."
  ORDER 150

ADD FIELD "label_printer" OF "wh_zone" AS character 
  DESCRIPTION "enter the printer for label print jobs                                                                                                      "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "label printer"
  POSITION 7
  MAX-WIDTH 60
  VIEW-AS ""
  COLUMN-LABEL ""
  VALMSG "enter the printer for label print jobs"
  HELP "enter the printer for label print jobs"
  ORDER 140

ADD FIELD "laser_printer" OF "wh_zone" AS character 
  DESCRIPTION "enter the printer for laser print jobs                                                                                                      "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "laser printer"
  POSITION 8
  MAX-WIDTH 60
  VIEW-AS ""
  COLUMN-LABEL ""
  VALMSG "enter the printer for laser print jobs"
  HELP "enter the printer for laser print jobs"
  ORDER 130

ADD FIELD "zone_type" OF "wh_zone" AS character 
  FORMAT "XX"
  INITIAL ""
  LABEL "Zone Type"
  POSITION 9
  MAX-WIDTH 4
  HELP "The type for this zone."
  ORDER 70

ADD FIELD "zone_desc" OF "wh_zone" AS character 
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Zone Description"
  POSITION 10
  MAX-WIDTH 120
  HELP "Enter a description for this zone."
  ORDER 60

ADD FIELD "wh_zone" OF "wh_zone" AS character 
  FORMAT "XX"
  INITIAL ""
  LABEL "Warehouse Zone"
  POSITION 11
  MAX-WIDTH 15
  HELP "The name for this zone."
  ORDER 30
  MANDATORY

ADD FIELD "wh_num" OF "wh_zone" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 12
  MAX-WIDTH 11
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "pick_sequence" OF "wh_zone" AS integer 
  FORMAT "999"
  INITIAL ?
  LABEL "Pick Sequence"
  POSITION 13
  MAX-WIDTH 4
  HELP "Used for sorting picks in warehouse scan order."
  ORDER 90

ADD FIELD "last_aisle" OF "wh_zone" AS integer 
  DESCRIPTION "A zone is defined by its starting and ending aisles."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Last Aisle"
  POSITION 14
  MAX-WIDTH 4
  HELP "The higest aisle number for this zone."
  ORDER 50
  MANDATORY

ADD FIELD "first_aisle" OF "wh_zone" AS integer 
  DESCRIPTION "A zone is defined by its starting and ending aisles."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "First Aisle"
  POSITION 15
  MAX-WIDTH 4
  HELP "The lowest aisle number for this zone."
  ORDER 40
  MANDATORY

ADD FIELD "custom_data" OF "wh_zone" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 16
  MAX-WIDTH 510
  EXTENT 5
  ORDER 120

ADD FIELD "co_num" OF "wh_zone" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 17
  MAX-WIDTH 9
  HELP "Enter the company number."
  ORDER 10

ADD FIELD "control_pick_area" OF "wh_zone" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Control Pick Area"
  POSITION 18
  MAX-WIDTH 20
  ORDER 80

ADD FIELD "carousel_type" OF "wh_zone" AS character 
  DESCRIPTION "Documentation only, for now (White, etc)."
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Carousel Type"
  POSITION 19
  MAX-WIDTH 20
  HELP "Carousel Type"
  ORDER 100

ADD FIELD "allow_putaway" OF "wh_zone" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Allow Put-Away"
  POSITION 20
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  HELP "Allow putaway to this zone?"
  ORDER 110

ADD INDEX "co_wh_sequence" ON "wh_zone" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "pick_sequence" ASCENDING 

ADD INDEX "co_wh_name" ON "wh_zone" 
  AREA "misc128_idx"
  UNIQUE
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "wh_zone" ASCENDING 

ADD TABLE "whmst"
  AREA "misc64_dat"
  LABEL "Warehouse Master"
  DESCRIPTION "Master warehouse table.
"
  DUMP-NAME "whmst"

ADD FIELD "overflow" OF "whmst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Overflow"
  POSITION 2
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX                                             "
  HELP "Is this an overflow warehouse?"
  ORDER 340

ADD FIELD "zip" OF "whmst" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Zip Code"
  POSITION 3
  MAX-WIDTH 20
  COLUMN-LABEL "zip"
  HELP "Enter the Zip Code"
  ORDER 70

ADD FIELD "ytd_phy_unit_var" OF "whmst" AS decimal 
  DESCRIPTION "Year to date average variance on the number of units as perphysical in"
  FORMAT ">>9.99%"
  INITIAL "100"
  LABEL "YTD Phys Inventory Variance"
  POSITION 4
  MAX-WIDTH 17
  HELP "This is the average YTD error per physical inventory."
  DECIMALS 2
  ORDER 150

ADD FIELD "ytd_phy_dollar_var" OF "whmst" AS decimal 
  DESCRIPTION "Year to date average error on dollar amounts, as per physical inventories."
  FORMAT "$->>>,>>9.99"
  INITIAL "0"
  LABEL "YTD Phys Count Dollar Variance"
  POSITION 5
  MAX-WIDTH 17
  HELP "This is the average YTD error on dollar amounts per physical."
  DECIMALS 2
  ORDER 160

ADD FIELD "wh_num" OF "whmst" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 6
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "wh_desc" OF "whmst" AS character 
  DESCRIPTION "warehouse description"
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Warehouse Description"
  POSITION 7
  MAX-WIDTH 60
  COLUMN-LABEL "Warehouse Name"
  HELP "Enter this warehouse's description."
  ORDER 30

ADD FIELD "state" OF "whmst" AS character 
  DESCRIPTION "State"
  FORMAT "XX"
  INITIAL ""
  LABEL "State"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "State"
  HELP "Enter the standard State abbreviation."
  ORDER 60

ADD FIELD "row_status" OF "whmst" AS logical 
  DESCRIPTION "Warehouse: Active or Inactive."
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Active"
  POSITION 9
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this warehouse active?"
  ORDER 330
  MANDATORY

ADD FIELD "region" OF "whmst" AS character 
  FORMAT "x(5)"
  INITIAL ""
  LABEL "Warehouse Region"
  POSITION 10
  MAX-WIDTH 10
  COLUMN-LABEL "region"
  HELP "Enter the Region for this warehouse."
  ORDER 90

ADD FIELD "rcv_zone_hold" OF "whmst" AS character 
  DESCRIPTION "The default warehouse zone for damaged (used at receiving)."
  FORMAT "XX"
  INITIAL "P"
  LABEL "Warehouse Zone"
  POSITION 11
  MAX-WIDTH 4
  HELP "Enter the default wh zone where to store unallocatable stock."
  ORDER 110
  MANDATORY

ADD FIELD "rcv_zone_default" OF "whmst" AS character 
  DESCRIPTION "Zone used as a default for receivals in this warehouse."
  FORMAT "XX"
  INITIAL ""
  LABEL "Default Receiving Zone"
  POSITION 12
  MAX-WIDTH 4
  HELP "Enter the default zone for receivals"
  ORDER 100
  MANDATORY

ADD FIELD "qa_instructions" OF "whmst" AS character 
  FORMAT "X(55)"
  INITIAL ""
  LABEL "Q/A Instructions"
  POSITION 13
  MAX-WIDTH 110
  HELP "Q/A Instructions"
  ORDER 180

ADD FIELD "qa_inspection" OF "whmst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Q/A Inspection"
  POSITION 14
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Q/A Inspection required"
  ORDER 170

ADD FIELD "pm_irms" OF "whmst" AS character 
  FORMAT "X(5)"
  INITIAL "IRMS"
  LABEL "P.M."
  POSITION 15
  MAX-WIDTH 10
  HELP "Parcel Management Specifier"
  ORDER 220

ADD FIELD "net_port" OF "whmst" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Net Port"
  POSITION 16
  MAX-WIDTH 4
  ORDER 310

ADD FIELD "net_host" OF "whmst" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Net Host"
  POSITION 17
  MAX-WIDTH 60
  ORDER 290

ADD FIELD "net_addr" OF "whmst" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Net Address"
  POSITION 18
  MAX-WIDTH 60
  ORDER 300

ADD FIELD "last_physical" OF "whmst" AS date 
  DESCRIPTION "The physical inventory where we obtained the accuracy data."
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Last Physical"
  POSITION 19
  MAX-WIDTH 4
  HELP "Date of the Last Physical Inventory."
  ORDER 140

ADD FIELD "custom_data" OF "whmst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 20
  MAX-WIDTH 510
  EXTENT 5
  ORDER 320

ADD FIELD "cs_stage" OF "whmst" AS character 
  FORMAT "x(10)"
  INITIAL "COUNTER"
  LABEL "Counter Sales Stage"
  POSITION 21
  MAX-WIDTH 20
  HELP "Counter Sales staging area."
  ORDER 120

ADD FIELD "co_num" OF "whmst" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 22
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10

ADD FIELD "country" OF "whmst" AS character 
  FORMAT "x(20)"
  INITIAL "USA"
  LABEL "Country"
  POSITION 23
  MAX-WIDTH 40
  HELP "Country"
  ORDER 80

ADD FIELD "consolidate_where" OF "whmst" AS character 
  FORMAT "X"
  INITIAL ""
  LABEL "Consolidation Area"
  POSITION 24
  MAX-WIDTH 2
  VIEW-AS "view-as radio-set radio-buttons ""Packing"", ""P"", ""Shipping"", ""S"""
  HELP "Where/when to consolidate an order."
  ORDER 210

ADD FIELD "consolidate" OF "whmst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Consolidate"
  POSITION 25
  MAX-WIDTH 1
  HELP "Consolidate orders?"
  ORDER 200

ADD FIELD "cod_zip" OF "whmst" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "COD Postal Code"
  POSITION 26
  MAX-WIDTH 20
  HELP "Remit-to COD postal code"
  ORDER 270

ADD FIELD "cod_state" OF "whmst" AS character 
  FORMAT "XX"
  INITIAL ""
  LABEL "COD State"
  POSITION 27
  MAX-WIDTH 4
  HELP "Remit-to COD state"
  ORDER 260

ADD FIELD "cod_name" OF "whmst" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "COD Name"
  POSITION 28
  MAX-WIDTH 60
  HELP "Remit-to COD name"
  ORDER 230

ADD FIELD "cod_country" OF "whmst" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "COD Country"
  POSITION 29
  MAX-WIDTH 40
  HELP "Remit-to COD country"
  ORDER 280

ADD FIELD "cod_city" OF "whmst" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "COD City"
  POSITION 30
  MAX-WIDTH 40
  HELP "Remit-to COD city"
  ORDER 250

ADD FIELD "cod_addr" OF "whmst" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "COD Address"
  POSITION 31
  MAX-WIDTH 310
  HELP "Remit-to COD address"
  EXTENT 5
  ORDER 240

ADD FIELD "city" OF "whmst" AS character 
  DESCRIPTION "City."
  FORMAT "x(20)"
  INITIAL ""
  LABEL "City"
  POSITION 32
  MAX-WIDTH 40
  COLUMN-LABEL "City"
  HELP "Enter the city where the warehouse is located."
  ORDER 50

ADD FIELD "carrier_id" OF "whmst" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Default Carrier"
  POSITION 33
  MAX-WIDTH 12
  HELP "The default carrier for this warehouse."
  ORDER 190
  MANDATORY

ADD FIELD "bo_bin" OF "whmst" AS character 
  FORMAT "x(10)"
  INITIAL "BKORD"
  LABEL "Back-order receival stage"
  POSITION 34
  MAX-WIDTH 20
  HELP "Place where receivals are staged when filling back-orders"
  ORDER 130
  MANDATORY

ADD FIELD "addr" OF "whmst" AS character 
  DESCRIPTION "Address."
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Address"
  POSITION 35
  MAX-WIDTH 124
  COLUMN-LABEL "Addr"
  HELP "Enter this warehouse's address."
  EXTENT 2
  ORDER 40

ADD INDEX "co_wh" ON "whmst" 
  AREA "misc64_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 

.
