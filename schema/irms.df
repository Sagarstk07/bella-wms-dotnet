ADD TABLE "parcel_zip"
  AREA "unused_dat"
  LABEL "Parcel Zip Zone Lookup"
  DUMP-NAME "parc_zip"

ADD FIELD "zone" OF "parcel_zip" AS character 
  FORMAT "x(3)"
  INITIAL ?
  POSITION 2
  MAX-WIDTH 6
  ORDER 40
  MANDATORY

ADD FIELD "to_zip" OF "parcel_zip" AS character 
  FORMAT "x(10)"
  INITIAL ""
  POSITION 3
  MAX-WIDTH 20
  ORDER 30

ADD FIELD "n_days" OF "parcel_zip" AS integer 
  FORMAT ">>9"
  INITIAL ?
  POSITION 4
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "min_days" OF "parcel_zip" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL ?
  POSITION 5
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "max_days" OF "parcel_zip" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 4
  ORDER 70

ADD FIELD "guaranteed_del_time" OF "parcel_zip" AS character 
  FORMAT "99:99"
  INITIAL "23:59"
  POSITION 7
  MAX-WIDTH 10
  ORDER 80

ADD FIELD "from_zip" OF "parcel_zip" AS character 
