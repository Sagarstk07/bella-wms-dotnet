ADD TABLE "syspar_def"
  AREA "misc32_dat"
  LABEL "System Parameter Definition"
  DUMP-NAME "syspar_d"

ADD FIELD "user_settable" OF "syspar_def" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 2
  MAX-WIDTH 1
  ORDER 30
  MANDATORY

ADD FIELD "type_id" OF "syspar_def" AS integer 
  DESCRIPTION "Identifies a parameter type internally"
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Parameter Type ID"
  POSITION 3
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "text_values" OF "syspar_def" AS character 
  DESCRIPTION "Values associated with each text."
  FORMAT "X(2000)"
  INITIAL ""
  POSITION 4
  MAX-WIDTH 4000
  VIEW-AS "VIEW-AS EDITOR inner-chars 50 inner-lines 5"
  ORDER 100

ADD FIELD "parameter_id" OF "syspar_def" AS integer 
  DESCRIPTION "Unique ID for this parameter"
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Parameter ID"
  POSITION 5
  MAX-WIDTH 4
  ORDER 20
  MANDATORY

ADD FIELD "options" OF "syspar_def" AS character 
  DESCRIPTION "Associated parameters for value"
  FORMAT "X(2000)"
  INITIAL ""
  POSITION 6
  MAX-WIDTH 4000
  VIEW-AS "VIEW-AS EDITOR inner-chars 50 inner-lines 5"
  ORDER 140

ADD FIELD "one_time" OF "syspar_def" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 7
  MAX-WIDTH 1
  ORDER 40
  MANDATORY

ADD FIELD "name" OF "syspar_def" AS character 
  DESCRIPTION "Name to display on screen."
  FORMAT "X(20)"
  INITIAL ""
  POSITION 8
  MAX-WIDTH 49
  ORDER 120

ADD FIELD "mandatory" OF "syspar_def" AS logical 
  DESCRIPTION "Value is required for the system to work"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 9
  MAX-WIDTH 1
  ORDER 50
  MANDATORY

ADD FIELD "description" OF "syspar_def" AS character 
  DESCRIPTION "Descriptive question"
  FORMAT "X(2500)"
  INITIAL ""
  POSITION 10
  MAX-WIDTH 5000
  VIEW-AS "view-as editor size 50 by 4 scrollbar-horizontal scrollbar-vertical"
  ORDER 130

ADD FIELD "default_value" OF "syspar_def" AS character 
  DESCRIPTION "Initial value"
  FORMAT "X(25)"
  INITIAL ""
  POSITION 11
  MAX-WIDTH 50
  ORDER 110

ADD FIELD "data_type" OF "syspar_def" AS character 
  DESCRIPTION "The type of data stored."
  FORMAT "X(20)"
  INITIAL ""
  POSITION 12
  MAX-WIDTH 40
  ORDER 60
  MANDATORY

ADD FIELD "custom_data" OF "syspar_def" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 13
  MAX-WIDTH 510
  EXTENT 5
  ORDER 150

ADD FIELD "column_widget" OF "syspar_def" AS character 
  DESCRIPTION "Radio-set, fill-in..."
  FORMAT "X(20)"
  INITIAL ""
  POSITION 14
  MAX-WIDTH 40
  ORDER 80

ADD FIELD "column_text" OF "syspar_def" AS character 
  DESCRIPTION "Descriptive text shown on screen.."
  FORMAT "X(2000)"
  INITIAL ""
  POSITION 15
  MAX-WIDTH 4000
  VIEW-AS "VIEW-AS EDITOR inner-chars 50 inner-lines 5"
  ORDER 90

ADD FIELD "column_format" OF "syspar_def" AS character 
  DESCRIPTION "A display format (e.g.: X(2))."
  FORMAT "X(25)"
  INITIAL ""
  POSITION 16
  MAX-WIDTH 50
  ORDER 70

ADD INDEX "type_id" ON "syspar_def" 
  AREA "misc32_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "type_id" ASCENDING 
  INDEX-FIELD "parameter_id" ASCENDING 

ADD INDEX "id" ON "syspar_def" 
  AREA "misc32_idx"
  UNIQUE
  INDEX-FIELD "parameter_id" ASCENDING 

ADD INDEX "typeid" ON "syspar_def" 
  AREA "misc32_idx"
  INDEX-FIELD "type_id" ASCENDING 

