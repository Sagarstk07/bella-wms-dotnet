  LABEL "PO Number"
  POSITION 9
  MAX-WIDTH 20
  ORDER 30

ADD FIELD "wh_num" OF "consolidation_ref" AS character 
  DESCRIPTION "Warehouse Number.                                                                                                                           "
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 10
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Warehouse"
  HELP "Enter the Warehouse Number."
  ORDER 20

ADD FIELD "co_num" OF "consolidation_ref" AS character 
  DESCRIPTION "Company Number                                                                                                                              "
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 11
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Company"
  HELP "Enter the company number."
  ORDER 10

