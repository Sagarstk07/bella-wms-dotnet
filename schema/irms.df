  FORMAT "X"
  INITIAL "D"
  LABEL "Time Frame"
  POSITION 3
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS 
  ""Days"", ""D"",
  ""Weeks"", ""W"",
  ""Months"", ""M"",
  ""Years"", ""Y"""
  HELP "Enter the time frame."
  ORDER 40
  MANDATORY

ADD FIELD "row_status" OF "file_retent" AS logical 
  DESCRIPTION "active or inactive"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 4
  MAX-WIDTH 1
