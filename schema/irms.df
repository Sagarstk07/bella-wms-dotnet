ADD FIELD "ship_system" OF "ship_system" AS character 
  DESCRIPTION "Ship System                                                                                                                                 "
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Ship System"
  POSITION 4
  MAX-WIDTH 20
  VIEW-AS ""
  COLUMN-LABEL "Ship!Sys"
  VALMSG "Enter the Ship System ID."
  HELP "Enter the Ship System ID."
  ORDER 10
  MANDATORY

ADD INDEX "main" ON "ship_system" 
  AREA "misc64_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "ship_system" ASCENDING 

ADD TABLE "ship_zone"
  AREA "unused_dat"
  LABEL "Ship Zone Master"
