ADD FIELD "weight_impact" OF "rule_value" AS decimal 
  FORMAT "->>>,>>9.9999"
  INITIAL "0"
  LABEL "Weight"
  POSITION 6
  MAX-WIDTH 26
  HELP "Enter the impact on weight for this rule value."
  DECIMALS 4
  ORDER 40

ADD FIELD "volume_impact" OF "rule_value" AS decimal 
  FORMAT "->>>,>>9.9999"
  INITIAL "0"
  LABEL "Volume"
  POSITION 7
  MAX-WIDTH 26
  HELP "Enter the impact on volume for this rule value."
  DECIMALS 4
  ORDER 50

ADD INDEX "co-wh-type-value" ON "rule_value" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "type" ASCENDING 
  INDEX-FIELD "rule_value" ASCENDING 

