  FORMAT "x(24)"
  INITIAL ?
  LABEL "Item Number"
  POSITION 34
  MAX-WIDTH 48
  HELP "Item for primary pick"
  ORDER 90

ADD FIELD "abc" OF "binmst" AS character 
  FORMAT "X"
  INITIAL ""
  LABEL "Location Class"
  POSITION 35
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS ""A"",    ""A"",
                ""B"",    ""B"", 
                ""C"",    ""C"",
                ""none"", "" ""
 HORIZONTAL"
  COLUMN-LABEL ""
  VALMSG "Please enter A, B, or C."
  HELP "Enter A, B, or C"
  ORDER 260

ADD FIELD "full_case_from_split" OF "binmst" AS logical 
  DESCRIPTION "Determines whether or not this location will allow both primary and case picks."
