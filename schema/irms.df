ADD TABLE "trans_type"
  AREA "misc128_dat"
  LABEL "Transaction Type"
  DESCRIPTION "Contains information about all transaction types that can be
entered into the ""transaction"" table."
  DUMP-NAME "trans_ty"

ADD FIELD "retention_period" OF "trans_type" AS integer 
  DESCRIPTION "negative - retain forever, 0 - use default transactions file retention period"
  FORMAT ">,>>9"
  INITIAL "0"
  LABEL ""
  POSITION 2
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the retention period for this transaction type."
  ORDER 80

ADD FIELD "timeframe" OF "trans_type" AS character 
  DESCRIPTION "d - days, w - weeks, m - months, y - years"
  FORMAT "x"
  INITIAL ""
  LABEL "Time Frame"
  POSITION 3
  MAX-WIDTH 2
  VIEW-AS ""
  COLUMN-LABEL "Interval"
  HELP "Enter the time frame of the retention period for trans type."
  ORDER 70

ADD FIELD "upload" OF "trans_type" AS logical 
  DESCRIPTION "This holds the default characteristic of this transaction type WRT uploads to the mainframe. See also the field row_status; a transaction is uploaded only if its type is marked for uploading AND is also active (i.e.: row_status eq true)."
  FORMAT "yes/no"
  FORMAT-SA "U"
  INITIAL "no"
  POSITION 4
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Send this kind of transaction to the mainframe?"
  ORDER 30
  MANDATORY

ADD FIELD "trans_type" OF "trans_type" AS character 
  DESCRIPTION "The key, unique."
  FORMAT "x(2)"
  INITIAL ""
  LABEL "Transaction Type"
  POSITION 5
  MAX-WIDTH 4
  VALMSG "Please enter a transaction type."
  HELP "Enter a transaction type."
  ORDER 10
  MANDATORY

ADD FIELD "trans_name" OF "trans_type" AS character 
  DESCRIPTION "Descriptive name for this transaction type."
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Transaction Name"
  POSITION 6
  MAX-WIDTH 42
  VALMSG "Please enter a name for this transaction type."
  HELP "Enter a name for this transaction type."
  ORDER 20
  MANDATORY

ADD FIELD "row_status" OF "trans_type" AS logical 
  DESCRIPTION "This is a quick way to temporarily deactivate a transaction type. If i"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 7
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "This transaction type will be ignored if not marked active."
  ORDER 60
  MANDATORY

ADD FIELD "custom_data" OF "trans_type" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 8
  MAX-WIDTH 510
  EXTENT 5
  ORDER 50

ADD INDEX "trans_type" ON "trans_type" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "trans_type" ASCENDING 

ADD TABLE "transactions"
  AREA "transactions_dat"
  LABEL "Activity Log"
  DESCRIPTION "Everything important that happens in WMS generates entries in
this table. The data here is what goes into activity reports.
This data is purged periodically, but this is potentially the
largest and most active table in the database.
"
  DUMP-NAME "trans"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_trans.t" CRC "?" 

ADD FIELD "link_id" OF "transactions" AS character 
  DESCRIPTION "Stores the link id of the associated data.                                                                                                  "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Link Id"
  POSITION 2
  MAX-WIDTH 60
  VIEW-AS ""
  COLUMN-LABEL "Link Id"
  HELP "Enter the link id associated to this transaction."
  ORDER 630

ADD FIELD "lpn_scanid" OF "transactions" AS character 
  DESCRIPTION "Describes the LPN id that is used for scanning, composite field.                                                                            "
  FORMAT "x(24)"
  INITIAL ""
  LABEL "LPN ScanID"
  POSITION 3
  MAX-WIDTH 19
  VIEW-AS ""
  COLUMN-LABEL "LPN ScanID"
  HELP "Enter the LPN Scannable ID."
  ORDER 620

ADD FIELD "rec_carton_id" OF "transactions" AS character 
  DESCRIPTION "Enter the receiving carton id.                                                                                                              "
  FORMAT "x(32)"
  INITIAL ""
  LABEL "Rec Carton ID"
  POSITION 4
  MAX-WIDTH 64
  HELP "Enter the receiving carton id."
  ORDER 610

ADD FIELD "wh_num" OF "transactions" AS character 
  DESCRIPTION "Warehouse"
  FORMAT "x(4)"
  INITIAL ?
  LABEL "Warehouse"
  POSITION 5
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 50

ADD FIELD "void" OF "transactions" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Void"
  POSITION 6
  MAX-WIDTH 1
  ORDER 540

ADD FIELD "uom" OF "transactions" AS character 
  DESCRIPTION "UOM e.g.: EA, BX, CT"
  FORMAT "X(4)"
  INITIAL ?
  LABEL "Unit of Measure"
  POSITION 7
  MAX-WIDTH 8
  VALMSG "Please enter an UOM code"
  HELP "Enter an UOM code."
  ORDER 290

ADD FIELD "truck_id" OF "transactions" AS character 
  FORMAT "x(20)"
  INITIAL ?
  LABEL "Truck Id"
  POSITION 8
  MAX-WIDTH 40
  HELP "ID for the truck which brought this inventory."
  ORDER 490

ADD FIELD "trans_type" OF "transactions" AS character 
  FORMAT "x(2)"
  INITIAL ?
  LABEL "Transaction Type"
  POSITION 9
  MAX-WIDTH 4
  VALMSG "Transaction type must be defined first ."
  HELP "This transaction type (you don't want to modify this...)."
  ORDER 120
  MANDATORY

ADD FIELD "trans_sec_time" OF "transactions" AS integer 
  DESCRIPTION "Used in arbitration for chrolological order, in case more than one transaction happens at the same minute. This provides granularity to the second. I don't think it's possible to do any better with Progress, but this should be enough. This field is assigned by trigger when the transaction is generated. It should never be modified."
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Seconds Since Midnight"
  POSITION 10
  MAX-WIDTH 4
  HELP "Don't change this field."
  ORDER 110
  MANDATORY

ADD FIELD "trans_num" OF "transactions" AS integer 
  FORMAT ">>>>>>>>9"
  INITIAL ?
  LABEL "Transaction Number"
  POSITION 11
  MAX-WIDTH 4
  COLUMN-LABEL "trans #"
  HELP "DO NOT CHANGE THIS FIELD"
  ORDER 10
  MANDATORY

ADD FIELD "trans_link" OF "transactions" AS integer 
  FORMAT ">>>>>>>>9"
  INITIAL ?
  LABEL "Transaction Link"
