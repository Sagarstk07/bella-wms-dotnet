  DESCRIPTION "Lock owner (e.g. ""CLIENT"")."
  FORMAT "x(8)"
  INITIAL ?
  POSITION 4
  MAX-WIDTH 16
  HELP "Lock owner."
  ORDER 10
  MANDATORY

ADD FIELD "lock" OF "system_lock" AS character 
  DESCRIPTION "Lock name (e.g.: CLMAIN)."
  FORMAT "x(8)"
  INITIAL ?
  LABEL "Lock Name"
  POSITION 5
  MAX-WIDTH 16
  HELP "Lock name."
  ORDER 20
  MANDATORY

ADD FIELD "date_time" OF "system_lock" AS character 
