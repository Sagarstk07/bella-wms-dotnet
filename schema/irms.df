  HELP "Enter this dock's id in IRMS."
  ORDER 30
  MANDATORY

ADD FIELD "custom_data" OF "dockmstr" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 14
  MAX-WIDTH 510
  EXTENT 5
  ORDER 120

ADD FIELD "current_trailer_id" OF "dockmstr" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Current Trailer"
  POSITION 15
  MAX-WIDTH 23
