ADD TABLE "rtdet"
  AREA "misc64_dat"
  LABEL "RT Detail"
  DESCRIPTION "Receipt transaction detail"
  DUMP-NAME "rtdet"

ADD FIELD "qc_pulled_qty" OF "rtdet" AS decimal 
  DESCRIPTION "Stores the QC quantity that has been pulled for inspection.                                                                                 "
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "QC Pulled Qty"
  POSITION 2
  MAX-WIDTH 17
  VIEW-AS ""
  COLUMN-LABEL "QC Pull Qty"
  HELP "Enter the QC quantity that has been pulled for inspection."
  DECIMALS 2
  ORDER 460

ADD FIELD "qc_request_qty" OF "rtdet" AS decimal 
  DESCRIPTION "Stores the QC quantity that is being requested for inspection.                                                                              "
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "QC Request Qty"
  POSITION 3
  MAX-WIDTH 17
  VIEW-AS ""
  COLUMN-LABEL "QC Req Qty"
  HELP "Enter the QC quantity that is being requested for inspection."
  DECIMALS 2
  ORDER 450

ADD FIELD "origin_country" OF "rtdet" AS character 
  DESCRIPTION "The origin country of the record"
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Origin Country"
  POSITION 4
  MAX-WIDTH 40
  VIEW-AS ""
  COLUMN-LABEL "Origin Country"
  HELP "Enter the country of origin"
  ORDER 440

ADD FIELD "rec_carton_id" OF "rtdet" AS character 
  DESCRIPTION "Enter the receiving carton id for this detail line.                                                                                         "
  FORMAT "x(32)"
  INITIAL ""
  LABEL "Rec Carton ID"
  POSITION 5
  MAX-WIDTH 64
  HELP "Enter the receiving carton id for this detail line."
  ORDER 430

ADD FIELD "wh_num" OF "rtdet" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 6
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "vend_item" OF "rtdet" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Vendor Item"
  POSITION 7
  MAX-WIDTH 48
  COLUMN-LABEL "vend item"
  VALMSG "Item must be defined in venddetail table first."
  HELP "Vendor-specific item number."
  ORDER 80
  MANDATORY

ADD FIELD "vendor_id" OF "rtdet" AS character 
  FORMAT "X(9)"
  INITIAL ""
  LABEL "Vendor ID"
  POSITION 8
  MAX-WIDTH 18
  HELP "Vendor ID"
  ORDER 50

ADD FIELD "uom" OF "rtdet" AS character 
  DESCRIPTION "UOM e.g.: EA, BX, CT"
  FORMAT "X(4)"
  INITIAL ""
  LABEL "Unit of Measure"
  POSITION 9
  MAX-WIDTH 8
  COLUMN-LABEL "uom"
  VALMSG "UOM must be defined in the UOM Table first."
  HELP "Unit of Measure for this RT line."
  ORDER 160

ADD FIELD "special_handling" OF "rtdet" AS character 
  FORMAT "X"
  INITIAL ""
  LABEL "Special Handling"
  POSITION 10
  MAX-WIDTH 2
  HELP "<B>ack-order, <C>ross-docking, <T>ie."
  ORDER 140

ADD FIELD "rt_id" OF "rtdet" AS integer 
  DESCRIPTION "RT Id assigned by IRMS, compare with rt_num"
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "RT Id"
  POSITION 11
  MAX-WIDTH 4
  COLUMN-LABEL "id"
  HELP "DO NOT EDIT THIS FIELD -- RT id assigned by IRMS"
  ORDER 10
  MANDATORY

ADD FIELD "rtn_order_suffix" OF "rtdet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "x(2)"
  INITIAL ""
  LABEL "Order Suffix"
  POSITION 12
  MAX-WIDTH 4
  ORDER 300

ADD FIELD "rtn_order" OF "rtdet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Order"
  POSITION 13
  MAX-WIDTH 20
  ORDER 290
  MANDATORY

ADD FIELD "row_status" OF "rtdet" AS character 
  DESCRIPTION "A == active       O == open
C == completed (received all lines of this"
  FORMAT "x"
  INITIAL "O"
  LABEL "Status"
  POSITION 14
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS 
    ""Open"", ""O"",
    ""Active"", ""A"",
    ""Complete"", ""C"""
  HELP "The status for this R/T line."
  ORDER 420
  MANDATORY

ADD FIELD "ret_line_sequence" OF "rtdet" AS integer 
  DESCRIPTION "Field added for R&D"
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "RtSeq"
  POSITION 15
  MAX-WIDTH 4
  COLUMN-LABEL "RtSq"
  HELP "Enter the return line sequence number."
  ORDER 320

ADD FIELD "ret_line" OF "rtdet" AS integer 
  DESCRIPTION "Field added for R&D"
  FORMAT ">>>9"
  INITIAL "1"
  LABEL "Line"
  POSITION 16
  MAX-WIDTH 4
  ORDER 310
  MANDATORY

ADD FIELD "return_fl" OF "rtdet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "X"
  INITIAL ""
  POSITION 17
  MAX-WIDTH 2
  ORDER 330

ADD FIELD "receiver_num" OF "rtdet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "x(10)"
  INITIAL ""
  POSITION 18
  MAX-WIDTH 20
  ORDER 370

ADD FIELD "rd_po_type" OF "rtdet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "X"
  INITIAL ""
  POSITION 19
  MAX-WIDTH 2
  ORDER 350

ADD FIELD "quantity" OF "rtdet" AS decimal 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Quantity Left"
  POSITION 20
  MAX-WIDTH 17
  HELP "Quantity."
  DECIMALS 2
  ORDER 90

ADD FIELD "qty_unavail" OF "rtdet" AS decimal 
  DESCRIPTION "Field added for R&D"
  FORMAT ">,>>>,>>>.99"
  INITIAL "0"
  POSITION 21
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 340

ADD FIELD "prod_desc" OF "rtdet" AS character 
  DESCRIPTION "Field added for R&D"
  FORMAT "x(30)"
  INITIAL ""
  POSITION 22
  MAX-WIDTH 60
  ORDER 380

ADD FIELD "po_type" OF "rtdet" AS character 
  DESCRIPTION "If there is a ""D"" here, this is a ""Department Order"", processed differ"
  FORMAT "XX"
  INITIAL ""
  LABEL "PO Type"
  POSITION 23
  MAX-WIDTH 4
  HELP "Purchase Order Type."
  ORDER 230

ADD FIELD "po_suffix" OF "rtdet" AS character 
  FORMAT "X(2)"
  INITIAL ""
  LABEL "PO Suffix"
  POSITION 24
  MAX-WIDTH 4
  ORDER 220

ADD FIELD "po_number" OF "rtdet" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "PO Number"
  POSITION 25
  MAX-WIDTH 20
  ORDER 210

