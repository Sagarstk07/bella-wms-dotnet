  ORDER 60

ADD FIELD "key2" OF "item_group" AS character 
  FORMAT "x(16)"
  INITIAL ""
  POSITION 5
  MAX-WIDTH 32
  ORDER 50

ADD FIELD "key1" OF "item_group" AS character 
  FORMAT "X(16)"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 32
  ORDER 40

ADD FIELD "custom_data" OF "item_group" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 7
  MAX-WIDTH 510
  EXTENT 5
  ORDER 70

