ADD FIELD "char_3" OF "drop_program" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 2
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 130

ADD FIELD "char_2" OF "drop_program" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 3
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 120

ADD FIELD "char_1" OF "drop_program" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL ""
  POSITION 4
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 110

