ADD TABLE "cartondtl"
  AREA "misc128_dat"
  LABEL "Carton Detail"
  DESCRIPTION "What is inside shipping cartons."
  DUMP-NAME "cartondt"

ADD FIELD "uom" OF "cartondtl" AS character 
  DESCRIPTION "UOM e.g.: EA, BX, CT"
  FORMAT "X(4)"
  INITIAL ?
  LABEL "Unit of Measure"
  POSITION 2
  MAX-WIDTH 8
  COLUMN-LABEL "uom"
