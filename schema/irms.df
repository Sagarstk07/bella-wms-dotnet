  LABEL "Pallet Footprint"
  POSITION 18
  MAX-WIDTH 4
  HELP "Pallet Footprint"
  ORDER 200

ADD FIELD "min_lvl" OF "binmst" AS decimal 
  DESCRIPTION "Minimum Level (for auto-restock). Used only when location is a primary pick."
  FORMAT ">>,>>9.99"
  INITIAL ?
  LABEL "Minimum Level"
  POSITION 19
  MAX-WIDTH 17
  COLUMN-LABEL "min lvl"
  HELP "Enter the minimum allowed level for this item in this location."
