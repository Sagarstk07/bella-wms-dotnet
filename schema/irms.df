ADD TABLE "rtn_ctn_det"
  AREA "unused_dat"
  LABEL "Returns Carton Detail"
  DESCRIPTION "Returns cartons (detail)"
  DUMP-NAME "rtnctnde"

ADD FIELD "uom" OF "rtn_ctn_det" AS character 
  DESCRIPTION "UOM e.g.: EA, BX, CT"
  FORMAT "X(4)"
  INITIAL ?
  LABEL "Unit of Measure"
  POSITION 2
  MAX-WIDTH 8
  COLUMN-LABEL "uom"
  HELP "Enter the Unit of Measure for this item."
  ORDER 70

ADD FIELD "row_status" OF "rtn_ctn_det" AS character 
  FORMAT "X"
  INITIAL "O"
  LABEL "Status"
  POSITION 3
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS 
    ""Open"", ""O"",
    ""Active"", ""A"",
    ""Complete"", ""C"""
  COLUMN-LABEL "status"
  HELP "The status for this item."
  ORDER 100
  MANDATORY

ADD FIELD "qty" OF "rtn_ctn_det" AS decimal 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Quantity"
  POSITION 4
  MAX-WIDTH 17
  HELP "Quantity."
  DECIMALS 2
  ORDER 60

ADD FIELD "lot" OF "rtn_ctn_det" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Lot"
  POSITION 5
  MAX-WIDTH 48
  HELP "Lot Number."
  ORDER 50

ADD FIELD "custom_data" OF "rtn_ctn_det" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 510
  EXTENT 5
  ORDER 90

ADD FIELD "carton_num" OF "rtn_ctn_det" AS integer 
  DESCRIPTION "Unique id (sequence rtn_ctn_num)."
  FORMAT "ZZZZZZZZZ9"
  INITIAL "0"
  LABEL "Pallet Number"
  POSITION 7
  MAX-WIDTH 4
  HELP "Don't edit this field; it's assigned by the system."
  ORDER 10
  MANDATORY

ADD FIELD "abs_num" OF "rtn_ctn_det" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Absolute Item Number"
  POSITION 8
  MAX-WIDTH 48
  COLUMN-LABEL "abs num"
  HELP "Enter the company-wide unique code for this item."
  ORDER 20
  MANDATORY

ADD INDEX "num_abs" ON "rtn_ctn_det" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "carton_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 

ADD TABLE "rtn_ctn_mst"
  AREA "unused_dat"
  LABEL "Return Cartons"
  DESCRIPTION "Return cartons (master)"
  DUMP-NAME "rtnctnms"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_rtnctn.t" CRC "?" 

ADD FIELD "wh_num" OF "rtn_ctn_mst" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "rtn_category" OF "rtn_ctn_mst" AS character 
  FORMAT "X(4)"
  INITIAL ""
  LABEL "Returns Category"
  POSITION 3
  MAX-WIDTH 8
  HELP "Returns Category associated with this carton."
  ORDER 50

ADD FIELD "row_status" OF "rtn_ctn_mst" AS character 
  FORMAT "X(1)"
  INITIAL ""
  LABEL "Status"
  POSITION 4
  MAX-WIDTH 2
  HELP "(O)pen, (A)ctive, (C)losed"
  ORDER 80

ADD FIELD "custom_data" OF "rtn_ctn_mst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 5
  MAX-WIDTH 510
  EXTENT 5
  ORDER 70

ADD FIELD "co_num" OF "rtn_ctn_mst" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 6
  MAX-WIDTH 8
  VALMSG "Company must be defined in the Company Master table first."
  HELP "Enter the company number."
  ORDER 20
  MANDATORY

ADD FIELD "carton_num" OF "rtn_ctn_mst" AS integer 
  DESCRIPTION "Unique id (sequence rtn_ctn_num)."
  FORMAT "ZZZZZZZZZ9"
  INITIAL "0"
  LABEL "Pallet Number"
  POSITION 7
  MAX-WIDTH 4
  HELP "Don't edit this field; it's assigned by the system."
  ORDER 10
  MANDATORY

ADD FIELD "carton_id" OF "rtn_ctn_mst" AS character 
  DESCRIPTION "Carton id, may be pre-printed. In any case, should be unique within a warehouse."
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Carton ID"
  POSITION 8
  MAX-WIDTH 20
  HELP "This carton's id, assigned by the user."
  ORDER 40

