ADD TABLE "item_history"
  AREA "item_history_dat"
  LABEL "Item History"
  DESCRIPTION "Holds the history of an item (receipts, adjustments,
shipments, returns) for trending."
  DUMP-NAME "item_his"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_itemhi.t" CRC "?" 

ADD FIELD "wh_num" OF "item_history" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "stock_stat" OF "item_history" AS character 
  DESCRIPTION "Allocatable stock, empty; all other codes, unallocatable."
  FORMAT "X"
  INITIAL ""
  LABEL "Stock Status"
  POSITION 3
  MAX-WIDTH 2
  HELP "Stock Status for this record"
  ORDER 50
  MANDATORY

ADD FIELD "start_bal" OF "item_history" AS decimal 
  DESCRIPTION "Starting balance for this item"
  FORMAT ">>>,>>9.99"
  INITIAL "0"
  LABEL "Starting Balance"
  POSITION 4
  MAX-WIDTH 17
  HELP "Starting balance for this item"
  DECIMALS 2
  ORDER 90

ADD FIELD "shipments_unsent" OF "item_history" AS decimal 
  FORMAT ">>>,>>9.99"
  INITIAL "0"
  LABEL "Shipments Unsent"
  POSITION 5
  MAX-WIDTH 17
  HELP "Shipments completed but not uploaded to the host."
  DECIMALS 2
  ORDER 140

ADD FIELD "shipments" OF "item_history" AS decimal 
  FORMAT ">>>,>>9.99"
  INITIAL "0"
  LABEL "Shipments"
  POSITION 6
  MAX-WIDTH 17
  HELP "Shipments for this item."
  DECIMALS 2
  ORDER 130

ADD FIELD "returns" OF "item_history" AS decimal 
  FORMAT ">>>,>>9.99"
  INITIAL "0"
  LABEL "Returns"
  POSITION 7
  MAX-WIDTH 17
  HELP "Returns for this item."
  DECIMALS 2
  ORDER 110

ADD FIELD "rec_type" OF "item_history" AS character 
  FORMAT "XX"
  INITIAL ""
  LABEL "Record Type"
  POSITION 8
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "rec_id" OF "item_history" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Record ID"
  POSITION 9
  MAX-WIDTH 4
  HELP "This value is assigned by the system. Don't modify it."
  ORDER 160

ADD FIELD "rec_date" OF "item_history" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Record Date"
  POSITION 10
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "receipts" OF "item_history" AS decimal 
  FORMAT ">>>,>>9.99"
  INITIAL "0"
  LABEL "Receipts"
  POSITION 11
  MAX-WIDTH 17
  HELP "Receipts for this item."
  DECIMALS 2
  ORDER 100

ADD FIELD "lot" OF "item_history" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Lot"
  POSITION 12
  MAX-WIDTH 48
  HELP "Lot Number."
  ORDER 80

ADD FIELD "end_bal" OF "item_history" AS decimal 
  FORMAT ">>>,>>9.99"
  INITIAL "0"
  LABEL "End Balance"
  POSITION 13
  MAX-WIDTH 17
  HELP "End Balance for this item."
  DECIMALS 2
  ORDER 150

ADD FIELD "custom_data" OF "item_history" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 14
  MAX-WIDTH 510
  EXTENT 5
  ORDER 170

ADD FIELD "co_num" OF "item_history" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 15
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10

ADD FIELD "adjustments" OF "item_history" AS decimal 
  FORMAT "->>>,>>9.99"
  INITIAL "0"
  LABEL "Adjustments"
  POSITION 16
  MAX-WIDTH 25
  HELP "Adjustments for this item."
  DECIMALS 2
  ORDER 120

ADD FIELD "abs_num" OF "item_history" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number). ("
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Item Number"
  POSITION 17
  MAX-WIDTH 48
  HELP "Enter the company-wide unique code for this item."
  ORDER 60
  MANDATORY

ADD INDEX "co_wh_type_abs_status_date" ON "item_history" 
  AREA "item_history_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "rec_type" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "stock_stat" ASCENDING 
  INDEX-FIELD "rec_date" ASCENDING 

ADD INDEX "co_wh_type_date_abs_status" ON "item_history" 
  AREA "item_history_idx"
  UNIQUE
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "rec_type" ASCENDING 
  INDEX-FIELD "rec_date" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "stock_stat" ASCENDING 

ADD INDEX "id" ON "item_history" 
  AREA "item_history_idx"
  UNIQUE
  INDEX-FIELD "rec_id" ASCENDING 

ADD TABLE "item_requirement"
  AREA "unused_dat"
  LABEL "Item Requirement"
  DUMP-NAME "l-item_requirement"

ADD FIELD "pack_qty" OF "item_requirement" AS integer 
  DESCRIPTION "Enter the requirement pack quantity.                                                                                                        "
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Requirement Pack Qty"
  POSITION 2
  MAX-WIDTH 4
  VIEW-AS ""
  COLUMN-LABEL "Qty"
  VALMSG "Enter the requirement pack quantity."
  HELP "Enter the requirement pack quantity."
  ORDER 70

ADD FIELD "pack_type" OF "item_requirement" AS character 
  DESCRIPTION "Enter the requirement pack type.                                                                                                            "
  FORMAT "x(2)"
  INITIAL ?
  LABEL "Requirement Pack Type"
  POSITION 3
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "Pack"
  VALMSG "Enter the requirement pack type."
  HELP "Enter the requirement pack type."
  ORDER 60

ADD FIELD "abs_num" OF "item_requirement" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number). (In All-Phase, this is their internal {aka big} item number, as contrasted to NAED number.)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Item Number"
  POSITION 4
  MAX-WIDTH 48
  HELP "Enter the company-wide unique code for this item."
  ORDER 50

ADD FIELD "description" OF "item_requirement" AS character 
  DESCRIPTION "Enter the requirement description.                                                                                                          "
  FORMAT "x(35)"
  INITIAL ?
  LABEL "Description"
  POSITION 5
  MAX-WIDTH 70
  VIEW-AS ""
  COLUMN-LABEL "Desc"
  VALMSG "Enter the requirement description."
  HELP "Enter the requirement description."
  ORDER 40

ADD FIELD "req_code" OF "item_requirement" AS character 
  DESCRIPTION "Enter the requirement code.                                                                                                                 "
  FORMAT "x(8)"
  INITIAL ?
  LABEL "Requirement Code"
  POSITION 6
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "Req Code"
  VALMSG "Enter the requirement code."
  HELP "Enter the requirement code."
  ORDER 30

ADD FIELD "wh_num" OF "item_requirement" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 7
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20

ADD FIELD "co_num" OF "item_requirement" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 8
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10

ADD INDEX "i-main" ON "item_requirement" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "req_code" ASCENDING 

ADD TABLE "keyvalue"
  AREA "unused_dat"
  LABEL "keyvalue"
  DESCRIPTION "CLOB accessed by id"
  DUMP-NAME "keyvalue"

ADD FIELD "clobobject" OF "keyvalue" AS clob 
  DESCRIPTION "Storage for large character data"
  FORMAT "x(8)"
  INITIAL ?
  LABEL ""
  POSITION 2
  LOB-AREA "lob_data"
  LOB-BYTES 104857600
  LOB-SIZE 100M
  CLOB-CODEPAGE "UTF-8"
  CLOB-COLLATION "BASIC"
  CLOB-TYPE 2
  VIEW-AS ""
  COLUMN-LABEL ""
  ORDER 70

ADD FIELD "validator" OF "keyvalue" AS character 
  FORMAT "x(120)"
  INITIAL ?
  LABEL "Validator Method"
  POSITION 3
  MAX-WIDTH 240
  VIEW-AS ""
  COLUMN-LABEL "Validator Method"
  HELP "Relative path to a class that implements rf.interface_keyvalue"
  ORDER 60

ADD FIELD "dtstamp" OF "keyvalue" AS datetime 
  FORMAT "99/99/9999 HH:MM:SS.SSS"
  INITIAL ?
  LABEL "Date Time"
  POSITION 4
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Date Time"
  HELP "Updated by system to mark changes"
  ORDER 50

ADD FIELD "category" OF "keyvalue" AS character 
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Cateogry"
  POSITION 5
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "Category"
  HELP "Grouping by function or application"
  ORDER 40

ADD FIELD "key_id" OF "keyvalue" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "ID"
  POSITION 6
  MAX-WIDTH 48
  VIEW-AS ""
  COLUMN-LABEL "ID"
  HELP "Supply a unique Key to pair with the CLOB value"
  ORDER 30

ADD FIELD "wh_num" OF "keyvalue" AS character 
  DESCRIPTION "Warehouse Number.                                                                                                                           "
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 7
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Warehouse"
  HELP "Enter the Warehouse Number."
  ORDER 20

ADD FIELD "co_num" OF "keyvalue" AS character 
  DESCRIPTION "Company Number                                                                                                                              "
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 8
  MAX-WIDTH 8
  VIEW-AS ""
  COLUMN-LABEL "Company"
  HELP "Enter the company number."
  ORDER 10

ADD INDEX "co_wh_id" ON "keyvalue" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "key_id" ASCENDING 

ADD INDEX "co_wh_cat" ON "keyvalue" 
  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "category" ASCENDING 

ADD TABLE "kitdtl"
  AREA "unused_dat"
  LABEL "Kit Detail"
  DESCRIPTION "Detail for the Kitmst table"
  DUMP-NAME "kitdtl"

ADD FIELD "wh_num" OF "kitdtl" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "same_lot" OF "kitdtl" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Same Lot"
  POSITION 3
  MAX-WIDTH 1
  HELP "Force building kit with quantity from the same lot only."
  ORDER 60

ADD FIELD "qty" OF "kitdtl" AS decimal 
  DESCRIPTION "Quantity of this item in the kit."
  FORMAT ">,>>9"
  INITIAL "0"
  LABEL "Quantity"
  POSITION 4
  MAX-WIDTH 17
  HELP "How many of this item in the kit?"
  DECIMALS 2
  ORDER 50
  MANDATORY

ADD FIELD "id" OF "kitdtl" AS integer 
  DESCRIPTION "Sequential number, link to kitdtl"
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Kit Id"
  POSITION 5
  MAX-WIDTH 4
  HELP "Do not modify this field."
  ORDER 10
  MANDATORY

ADD FIELD "custom_data" OF "kitdtl" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 510
  EXTENT 5
  ORDER 70

ADD FIELD "co_num" OF "kitdtl" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 7
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 20

ADD FIELD "abs_num" OF "kitdtl" AS character 
  DESCRIPTION "Item number of one of the components of a kit."
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Item Number"
  POSITION 8
  MAX-WIDTH 48
  VALMSG "Please enter the company-wide code for this item."
  HELP "Enter the company-wide unique code for this item."
  ORDER 40
  MANDATORY

ADD INDEX "id_abs" ON "kitdtl" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "id" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 

ADD INDEX "co_wh_abs" ON "kitdtl" 
  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 

ADD TABLE "kitmst"
  AREA "misc128_dat"
  LABEL "Kit Master Table"
  DESCRIPTION "Table contains items which make up a ""kit"", and their
quantities.
"
  DUMP-NAME "kitmst"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_kit.t" CRC "?" 

ADD FIELD "wh_num" OF "kitmst" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "row_status" OF "kitmst" AS logical 
  DESCRIPTION "Kit: Active or Inactive"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 3
  MAX-WIDTH 1
  HELP "Is this kit active in the system?"
  ORDER 130
  MANDATORY

ADD FIELD "pre_built" OF "kitmst" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Kit Type"
  POSITION 4
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS RADIO-SET
radio-buttons ""Pre-Built"", yes, ""Build on demand"", no"
  HELP "Pre-built or build on demand?"
  ORDER 50

ADD FIELD "kit_num" OF "kitmst" AS character 
  DESCRIPTION "The item number that means a kit."
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Item Number"
  POSITION 5
  MAX-WIDTH 48
  VALMSG "Don't modify this field."
  HELP "Don't modify this field."
  ORDER 40
  MANDATORY

ADD FIELD "id" OF "kitmst" AS integer 
  DESCRIPTION "Sequential number, link to kitdtl"
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Kit Id"
  POSITION 6
  MAX-WIDTH 4
  HELP "Do not modify this field."
  ORDER 10
  MANDATORY

ADD FIELD "disassembly_ranking" OF "kitmst" AS integer 
  FORMAT "->>9"
  INITIAL ?
  LABEL "Disassembly Ranking"
  POSITION 7
  MAX-WIDTH 4
  ORDER 110

ADD FIELD "disassembly_dept" OF "kitmst" AS integer 
  DESCRIPTION "Department to do the disassembly"
  FORMAT ">>>>>9"
  INITIAL ?
  LABEL "Disassembly Department"
  POSITION 8
  MAX-WIDTH 4
  HELP "Department were this kit is disassembled."
  ORDER 100

ADD FIELD "disassembly_allow" OF "kitmst" AS logical 
  FORMAT "yes/no"
  INITIAL ?
  LABEL "Disassembly Allowed"
  POSITION 9
  MAX-WIDTH 1
  ORDER 90

ADD FIELD "dept_num" OF "kitmst" AS integer 
  DESCRIPTION "Department to do the assembly"
  FORMAT ">>>>>9"
  INITIAL "0"
  LABEL "Department Number"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL "Dept #"
  HELP "Department were this kit is assembled."
  ORDER 80

ADD FIELD "custom_data" OF "kitmst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 11
  MAX-WIDTH 510
  EXTENT 5
  ORDER 120

ADD FIELD "co_num" OF "kitmst" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 12
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 20

ADD FIELD "assembly_required" OF "kitmst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Assembly Required"
  POSITION 13
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Assembly required for this kit."
  ORDER 60
  MANDATORY

ADD FIELD "assembly_instructions" OF "kitmst" AS character 
  FORMAT "X(200)"
  INITIAL ""
  LABEL "Assembly instructions"
  POSITION 14
  MAX-WIDTH 400
  VIEW-AS "view-as editor size 50 by 4"
  HELP "Assembly instructions"
  ORDER 70

ADD INDEX "co_wh_kit" ON "kitmst" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  DESCRIPTION "Enforce uniqueness..."
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "kit_num" ASCENDING 

ADD INDEX "id" ON "kitmst" 
  AREA "misc128_idx"
  UNIQUE
  INDEX-FIELD "id" ASCENDING 

