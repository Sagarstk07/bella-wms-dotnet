  INITIAL ""
  LABEL "Employee Number"
  POSITION 8
  MAX-WIDTH 11
  COLUMN-LABEL ""
  HELP "Employee who associated this task to a cart."
  ORDER 80

ADD FIELD "custom_data" OF "task" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 9
  MAX-WIDTH 510
  EXTENT 5
  ORDER 100

ADD FIELD "co_num" OF "task" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 10
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10
  MANDATORY

ADD FIELD "completed" OF "task" AS character 
  DESCRIPTION "Time stamp for this particular activity."
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Completed"
  POSITION 11
  MAX-WIDTH 32
  ORDER 70

