  DESCRIPTION "For future expansion."
  FORMAT ">,>>>,>>9"
  INITIAL ?
  POSITION 2
  MAX-WIDTH 4
  HELP "Maximum count of references."
  ORDER 50

ADD FIELD "ref_count" OF "system_lock" AS integer 
  DESCRIPTION "For future expansion."
  FORMAT ">,>>>,>>9"
  INITIAL ?
  LABEL "Reference Count"
  POSITION 3
  MAX-WIDTH 4
  HELP "Reference count."
  ORDER 40

