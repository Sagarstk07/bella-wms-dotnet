  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "trans_type" OF "task" AS character 
  FORMAT "x(2)"
  INITIAL ?
  LABEL "Transaction Type"
  POSITION 3
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "task_status" OF "task" AS character 
  FORMAT "X"
  INITIAL "O"
  LABEL "Status"
  POSITION 4
  MAX-WIDTH 2
  ORDER 110

ADD FIELD "task_id" OF "task" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  LABEL "Task Id"
  POSITION 5
  MAX-WIDTH 4
  ORDER 30

ADD FIELD "started" OF "task" AS character 
