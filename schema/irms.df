ADD TABLE "rtdet_status"
  AREA "misc256_dat"
  LABEL "Rt Detail Status"
  DESCRIPTION "All the statuses allowed for the rtdet table. Similar to rtmst_status."
  DUMP-NAME "rtdet_st"

ADD FIELD "name" OF "rtdet_status" AS character 
  DESCRIPTION "The name that is displayed for the user to see."
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Status Name"
  POSITION 2
  MAX-WIDTH 24
  COLUMN-LABEL "name"
  VALMSG "Please enter a name for this status."
  HELP "Please enter a name for this status."
  ORDER 20
  MANDATORY

ADD FIELD "custom_data" OF "rtdet_status" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 3
  MAX-WIDTH 510
  EXTENT 5
  ORDER 30

ADD FIELD "code" OF "rtdet_status" AS character 
  DESCRIPTION "Code, used for the row_status column in the rtdet table."
  FORMAT "X"
  INITIAL ""
  LABEL "Status Code"
  POSITION 4
  MAX-WIDTH 2
  COLUMN-LABEL "code"
  VALMSG "Please enter a Status Code."
  HELP "Please enter a Status Code."
  ORDER 10
  MANDATORY

ADD INDEX "code" ON "rtdet_status" 
  AREA "misc256_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "code" ASCENDING 

ADD INDEX "name" ON "rtdet_status" 
  AREA "misc256_idx"
  UNIQUE
  INDEX-FIELD "name" ASCENDING 

ADD TABLE "rtmst"
  AREA "misc128_dat"
  LABEL "RT Master"
  DESCRIPTION "R/Ts are ""receipt transactions"". "
  DUMP-NAME "rtmst"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_rtmst.t" CRC "?" 

ADD FIELD "wh_num" OF "rtmst" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "vendor_id" OF "rtmst" AS character 
  FORMAT "X(9)"
  INITIAL ?
  LABEL "Vendor ID"
  POSITION 3
  MAX-WIDTH 18
  HELP "Vendor ID"
  ORDER 70

ADD FIELD "unplanned" OF "rtmst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 4
  MAX-WIDTH 1
  ORDER 190

ADD FIELD "type" OF "rtmst" AS character 
  FORMAT "X"
  INITIAL "C"
  LABEL "R/T Type"
  POSITION 5
  MAX-WIDTH 2
  HELP "Enter the type for this order."
  ORDER 60
  MANDATORY

ADD FIELD "truck_id" OF "rtmst" AS character 
  FORMAT "x(20)"
  INITIAL ?
  LABEL "Truck Id"
  POSITION 6
  MAX-WIDTH 40
  HELP "ID for the truck which brought this inventory."
  ORDER 130

ADD FIELD "task_id" OF "rtmst" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  LABEL "Task Id"
  POSITION 7
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "rt_num" OF "rtmst" AS character 
  FORMAT "x(18)"
  INITIAL ""
  LABEL "RT Number"
  POSITION 8
  MAX-WIDTH 36
  COLUMN-LABEL "rt #"
  HELP "Enter RT ID (ASN #)"
  ORDER 40
  MANDATORY

ADD FIELD "rt_id" OF "rtmst" AS integer 
  DESCRIPTION "RT Id assigned by IRMS, compare with rt_num"
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "RT Id"
  POSITION 9
  MAX-WIDTH 4
  COLUMN-LABEL "id"
  HELP "DO NOT EDIT THIS FIELD -- RT id assigned by IRMS"
  ORDER 10
  MANDATORY

ADD FIELD "row_status" OF "rtmst" AS character 
  DESCRIPTION "A == active       O == open
C == completed (received all lines of this"
  FORMAT "X"
  INITIAL "O"
  LABEL "Status"
  POSITION 10
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS 
    ""Open"", ""O"",
    ""Active"", ""A"",
    ""Complete"", ""C"""
  COLUMN-LABEL "Status"
  HELP "The status of this R/T (Open, Active, Complete)."
  ORDER 240
  MANDATORY

ADD FIELD "release_id" OF "rtmst" AS character 
  FORMAT "x(24)"
  INITIAL ""
  POSITION 11
  MAX-WIDTH 48
  ORDER 180

ADD FIELD "percent_fill" OF "rtmst" AS decimal 
  FORMAT "->>,>>9.99"
  INITIAL ?
  LABEL "Percent Fill"
  POSITION 12
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 220

ADD FIELD "packing_list" OF "rtmst" AS logical 
  DESCRIPTION "Set to true if this is a packing list RT"
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 13
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  ORDER 120
  MANDATORY

ADD FIELD "order_suffix" OF "rtmst" AS character 
  FORMAT "X(2)"
  INITIAL ""
  LABEL "Order Suffix"
  POSITION 14
  MAX-WIDTH 4
  HELP "Order suffix, used only for RMAs"
  ORDER 110

ADD FIELD "order" OF "rtmst" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Order"
  POSITION 15
  MAX-WIDTH 20
  HELP "Order number, used only for RMAs"
  ORDER 100

ADD FIELD "num_cartons" OF "rtmst" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Number of Cartons"
  POSITION 16
  MAX-WIDTH 4
  ORDER 210

ADD FIELD "delivery" OF "rtmst" AS date 
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Delivery"
  POSITION 17
  MAX-WIDTH 4
  HELP "Estimated delivery date."
  ORDER 90

ADD FIELD "custom_data" OF "rtmst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 18
  MAX-WIDTH 510
  EXTENT 5
  ORDER 230

ADD FIELD "created_by" OF "rtmst" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Created By"
  POSITION 19
  MAX-WIDTH 12
  ORDER 200

ADD FIELD "co_num" OF "rtmst" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 20
  MAX-WIDTH 8
  VALMSG "Company must be defined in the Company Master table first."
  HELP "Enter the company number."
  ORDER 20

ADD FIELD "comments" OF "rtmst" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Comments"
  POSITION 21
  MAX-WIDTH 60
  COLUMN-LABEL "comments"
  HELP "Comments for this RT."
  ORDER 80

ADD FIELD "clearance_required" OF "rtmst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Customs Hold"
  POSITION 22
  MAX-WIDTH 1
