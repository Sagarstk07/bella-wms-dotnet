ADD FIELD "zone" OF "ship_zone" AS character 
  FORMAT "x(3)"
  INITIAL ?
  LABEL "Zone"
  POSITION 8
  MAX-WIDTH 6
  COLUMN-LABEL ""
  HELP "Enter the zone."
  ORDER 50

ADD FIELD "carrier_service" OF "ship_zone" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Service"
  POSITION 9
  MAX-WIDTH 20
  COLUMN-LABEL ""
  HELP "Enter the service for this carrier."
  ORDER 20

ADD FIELD "carrier_zone" OF "ship_zone" AS character 
  FORMAT "x(2)"
  INITIAL ""
  LABEL "Carrier Zone Id"
  POSITION 10
  MAX-WIDTH 4
  COLUMN-LABEL ""
  HELP "Enter the carrier zone."
  ORDER 10
  MANDATORY

ADD INDEX "cz_from_to" ON "ship_zone" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "carrier_zone" ASCENDING 
  INDEX-FIELD "origin_zip" ASCENDING 
  INDEX-FIELD "dest_zip" ASCENDING 

ADD TABLE "shpdtl"
  AREA "misc64_dat"
  LABEL "Shipping Detail"
  DESCRIPTION "Table used for generation of shipping manifests. This is the
detail table which corresponds to shpmst.
"
  DUMP-NAME "shpdtl"

ADD FIELD "zone" OF "shpdtl" AS integer 
  FORMAT ">9"
  INITIAL "0"
  LABEL "Zone"
  POSITION 2
  MAX-WIDTH 4
  HELP "Enter the UPS Zone to which the package is going to be shipped."
  ORDER 120

ADD FIELD "zip" OF "shpdtl" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "Zip Code"
  POSITION 3
  MAX-WIDTH 20
  HELP "Enter the Zip Code."
  ORDER 110

ADD FIELD "weight" OF "shpdtl" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Weight"
  POSITION 4
  MAX-WIDTH 17
  HELP "Enter this shipment's weight."
  DECIMALS 2
  ORDER 130

ADD FIELD "void" OF "shpdtl" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Void"
  POSITION 5
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  ORDER 50

ADD FIELD "ups_ground_track" OF "shpdtl" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "UPS Ground Track"
  POSITION 6
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX
"
  HELP "Is this a GROUNDTRAC package?"
  ORDER 190

ADD FIELD "tracking_id" OF "shpdtl" AS character 
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Tracking ID"
  POSITION 7
  MAX-WIDTH 60
  HELP "Enter the Tracking Number."
  ORDER 40

ADD FIELD "state" OF "shpdtl" AS character 
  DESCRIPTION "State"
  FORMAT "XX"
  INITIAL ""
  LABEL "State"
  POSITION 8
  MAX-WIDTH 15
  HELP "Enter the standard State abbreviation."
  ORDER 100

ADD FIELD "shp_by_irms" OF "shpdtl" AS logical 
  DESCRIPTION "will be turned off if an external shipment system was used"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Shipped By IRMS"
  POSITION 9
  MAX-WIDTH 1
  HELP "Order was shipped by IRMS"
  ORDER 240

ADD FIELD "residential_flag" OF "shpdtl" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Residential Flag"
  POSITION 10
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this a residential delivery address?"
  ORDER 150

ADD FIELD "pro_num_id" OF "shpdtl" AS character 
  DESCRIPTION "Can't always store the pro number as a number..."
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Pro Number"
  POSITION 11
  MAX-WIDTH 40
  HELP "Pro Number"
  ORDER 20

ADD FIELD "package_type" OF "shpdtl" AS character 
  DESCRIPTION "Package Type"
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Package Type"
  POSITION 12
  MAX-WIDTH 24
  ORDER 60

ADD FIELD "oversized" OF "shpdtl" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Oversized Item"
  POSITION 13
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  ORDER 230
  MANDATORY

ADD FIELD "manifest_id" OF "shpdtl" AS integer 
  DESCRIPTION "Manifest id generated by the system"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Manifest Id"
  POSITION 14
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "invoice_num" OF "shpdtl" AS character 
  FORMAT "X(12)"
  INITIAL ""
  LABEL "Invoice Number"
  POSITION 15
  MAX-WIDTH 24
  HELP "Enter the Invoice Number."
  ORDER 30

ADD FIELD "declared_value" OF "shpdtl" AS decimal 
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Declared Value"
  POSITION 16
  MAX-WIDTH 17
  HELP "Declared value of this package."
  DECIMALS 2
  ORDER 180

ADD FIELD "custom_data" OF "shpdtl" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 17
  MAX-WIDTH 510
  EXTENT 5
  ORDER 250

ADD FIELD "consignee_name" OF "shpdtl" AS character 
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Consignee Name"
  POSITION 18
  MAX-WIDTH 66
  HELP "Name of the consignee."
  ORDER 70

ADD FIELD "cod_amt" OF "shpdtl" AS decimal 
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "COD Amount"
  POSITION 19
  MAX-WIDTH 17
  HELP "COD amount to be collected."
  DECIMALS 2
  ORDER 170

ADD FIELD "city" OF "shpdtl" AS character 
  DESCRIPTION "City."
  FORMAT "x(20)"
  INITIAL ""
  LABEL "City"
  POSITION 20
  MAX-WIDTH 41
  HELP "Enter the city where the consignee is located."
  ORDER 90

ADD FIELD "charges" OF "shpdtl" AS decimal 
  DESCRIPTION "Charges shown are the actual shipping charges based on zone and package weight from the standard common carrier rate chart. This does not include COD and Declared Value charges."
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Charges"
  POSITION 21
  MAX-WIDTH 17
  HELP "Shipping charges."
  DECIMALS 2
  ORDER 160

ADD FIELD "call_tag_issued" OF "shpdtl" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Call Tag"
  POSITION 22
  MAX-WIDTH 1
  ORDER 220

ADD FIELD "add_on_handling" OF "shpdtl" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Add On Handling"
  POSITION 23
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Does this package requires additional handling?"
  ORDER 200

ADD FIELD "add_on_cost" OF "shpdtl" AS decimal 
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Add On Cost"
  POSITION 24
  MAX-WIDTH 17
  HELP "Additional handling cost."
  DECIMALS 2
  ORDER 210

ADD FIELD "addr" OF "shpdtl" AS character 
  DESCRIPTION "Address.                                                                                                                                    "
  FORMAT "x(35)"
  INITIAL ""
  LABEL "Address"
  POSITION 25
  MAX-WIDTH 144
  HELP "Enter the consignee's address."
  EXTENT 3
  ORDER 80

ADD FIELD "actual_weight" OF "shpdtl" AS decimal 
  DESCRIPTION "Store the ""real"" weight of the package (as opposed to what we reported to the carrier, which could be different because of things like dimensional weight)."
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Weight"
  POSITION 26
  MAX-WIDTH 17
  HELP "Actual weight."
  DECIMALS 2
  ORDER 140

ADD INDEX "tracking_void" ON "shpdtl" 
  AREA "misc64_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "tracking_id" ASCENDING 
  INDEX-FIELD "void" ASCENDING 

ADD INDEX "id" ON "shpdtl" 
  AREA "misc64_idx"
  DESCRIPTION "main link to shpdtl"
  INDEX-FIELD "manifest_id" ASCENDING 

ADD TABLE "shpmst"
  AREA "misc128_dat"
  LABEL "Shipping Master"
  DESCRIPTION "Table used for generation of shipping manifests.
"
  DUMP-NAME "shpmst"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_shpmst.t" CRC "?" 

ADD FIELD "ship_system_manifest" OF "shpmst" AS character 
  DESCRIPTION "Ship System Manifest Number                                                                                                                 "
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Ship System Manifest #"
  POSITION 2
  MAX-WIDTH 20
  VIEW-AS ""
  COLUMN-LABEL "Manifest!Number"
  VALMSG "Enter the ship system manifest number."
  HELP "Enter the ship system manifest number."
  ORDER 160

ADD FIELD "manifest_status" OF "shpmst" AS character 
  DESCRIPTION "Manifest file creation status o = open c = closed                                                                                           "
  FORMAT "x(1)"
  INITIAL "o"
  LABEL "Status"
  POSITION 3
  MAX-WIDTH 2
  COLUMN-LABEL "S"
  HELP "Status o = open c = closed."
  ORDER 150

ADD FIELD "filename" OF "shpmst" AS character 
  DESCRIPTION "Filename for this manifest.                                                                                                                 "
  FORMAT "x(40)"
  INITIAL ?
  LABEL "Filename"
  POSITION 4
  MAX-WIDTH 70
  COLUMN-LABEL "Filename"
  HELP "Enter the filename for this manifest."
  ORDER 140

ADD FIELD "page_num" OF "shpmst" AS character 
  DESCRIPTION "Page number for this manifest.                                                                                                              "
  FORMAT "x(3)"
  INITIAL ?
  LABEL "Page #"
  POSITION 5
  MAX-WIDTH 16
  COLUMN-LABEL "PG#"
  HELP "Enter page number for this manifest."
  ORDER 130

ADD FIELD "book_num" OF "shpmst" AS character 
  DESCRIPTION "Book number for this manifest.                                                                                                              "
  FORMAT "x(8)"
  INITIAL ?
  LABEL "Book #"
  POSITION 6
  MAX-WIDTH 16
  COLUMN-LABEL "Book"
  HELP "Enter book number for this manifest."
  ORDER 120

ADD FIELD "wh_num" OF "shpmst" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 7
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "trailer_num" OF "shpmst" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "Trailer #"
  POSITION 8
  MAX-WIDTH 23
  HELP "Enter the Trailer Number."
  ORDER 60

ADD FIELD "row_status" OF "shpmst" AS logical 
  DESCRIPTION "A manifest is closed when it is printed."
  FORMAT "Closed/Open"
  INITIAL "no"
  LABEL "Status"
  POSITION 9
  MAX-WIDTH 1
  ORDER 110
  MANDATORY

ADD FIELD "manifest_num" OF "shpmst" AS integer 
  DESCRIPTION "The manifest number, unique by carrier for this warehouse"
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Manifest Number"
  POSITION 10
  MAX-WIDTH 4
  ORDER 70

ADD FIELD "manifest_id" OF "shpmst" AS integer 
  DESCRIPTION "Manifest id generated by the system"
  FORMAT "999999999"
  INITIAL "0"
  LABEL "Manifest Id"
  POSITION 11
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "dock_id" OF "shpmst" AS character 
  DESCRIPTION "The dock for this shipment."
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Dock Id"
  POSITION 12
  MAX-WIDTH 12
  HELP "The dock for this shipment."
  ORDER 40

ADD FIELD "date_time" OF "shpmst" AS character 
  DESCRIPTION "Date and Time this shipment is shipped."
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Shipped Date"
  POSITION 13
  MAX-WIDTH 32
  HELP "Date and Time this shipment is shipped."
  ORDER 80
  FIELD-TRIGGER "Assign" NO-OVERRIDE PROCEDURE "datetim.t" CRC "?" 

ADD FIELD "custom_data" OF "shpmst" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 14
  MAX-WIDTH 510
  EXTENT 5
  ORDER 100

ADD FIELD "co_num" OF "shpmst" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 15
  MAX-WIDTH 8
  VALMSG "Company must be defined in Company Master table first."
  HELP "Enter the company number."
  ORDER 20

ADD FIELD "carrier_id" OF "shpmst" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Carrier Id"
  POSITION 16
  MAX-WIDTH 12
  HELP "Enter this carrier's id in IRMS."
  ORDER 50
  MANDATORY

ADD FIELD "container_num" OF "shpmst" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Container Number"
  POSITION 17
  MAX-WIDTH 40
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the container number."
  ORDER 170

ADD INDEX "co_wh_carrier_manifest" ON "shpmst" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  DESCRIPTION "enforce uniqueness"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "carrier_id" ASCENDING 
  INDEX-FIELD "manifest_num" ASCENDING 

ADD INDEX "dock_status" ON "shpmst" 
  AREA "misc128_idx"
  INDEX-FIELD "dock_id" ASCENDING 
  INDEX-FIELD "row_status" ASCENDING 

ADD INDEX "id" ON "shpmst" 
  AREA "misc128_idx"
  UNIQUE
  DESCRIPTION "enforce uniqueness"
  INDEX-FIELD "manifest_id" ASCENDING 

ADD INDEX "manifest_stat" ON "shpmst" 
  AREA "misc128_idx"
  DESCRIPTION "For lookup of manifest status."
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "carrier_id" ASCENDING 
  INDEX-FIELD "manifest_status" ASCENDING 

ADD INDEX "status_chrono" ON "shpmst" 
  AREA "misc128_idx"
  DESCRIPTION "for nightly processing, delete completed manifests older than x days."
  INDEX-FIELD "row_status" ASCENDING 
  INDEX-FIELD "date_time" ASCENDING 

ADD INDEX "trailer_status" ON "shpmst" 
  AREA "misc128_idx"
  INDEX-FIELD "trailer_num" ASCENDING 
  INDEX-FIELD "row_status" ASCENDING 

ADD TABLE "stntbl"
  AREA "misc128_dat"
  LABEL "Stations Table"
  DESCRIPTION "Data about all RF stations + console
"
  DUMP-NAME "stntbl"

ADD FIELD "wh_num" OF "stntbl" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "stn_type" OF "stntbl" AS character 
  DESCRIPTION "'R', 'S', 'C', etc."
  FORMAT "X"
  INITIAL "R"
  LABEL "Station Type"
  POSITION 3
  MAX-WIDTH 2
  COLUMN-LABEL "stn type"
  HELP "Please enter this station's type."
  ORDER 40
  MANDATORY

ADD FIELD "stn_num" OF "stntbl" AS character 
  DESCRIPTION "Station id"
  FORMAT "X(6)"
  INITIAL ""
  LABEL "Station Id"
  POSITION 4
  MAX-WIDTH 12
  COLUMN-LABEL "stn #"
  HELP "Please enter this station's Id or number."
  ORDER 30
  MANDATORY

ADD FIELD "row_status" OF "stntbl" AS logical 
  DESCRIPTION "Station: Active or Inactive."
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 5
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this station active?"
  ORDER 16
  MANDATORY

ADD FIELD "line_queue" OF "stntbl" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Report Printer Queue"
  POSITION 6
  MAX-WIDTH 30
  HELP "System Queue where to route reports printed by this station."
  ORDER 80
  MANDATORY

ADD FIELD "line_printer" OF "stntbl" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Line Printer"
  POSITION 7
  MAX-WIDTH 30
  HELP "Please enter the type of device used for printing Reports."
  ORDER 70
  MANDATORY

ADD FIELD "last_pid" OF "stntbl" AS integer 
  DESCRIPTION "This is assigned every time a radio is activated. It is a help in case we need to determine the pid of the invocation of irms running at a specific station (e.g.: to bring it down)."
  FORMAT ">>>>>>>>>9"
  INITIAL "0"
  LABEL "PID of latest login"
  POSITION 8
  MAX-WIDTH 4
  HELP "The last known PID running in this station (don't change)"
  ORDER 90
  MANDATORY

ADD FIELD "last_logout" OF "stntbl" AS character 
  DESCRIPTION "Date and time when last_empnum logged out (set at logout by irms_rf)."
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Last Log Out"
  POSITION 9
  MAX-WIDTH 32
  HELP "Time when the latest user logged out (don't change)."
  ORDER 130
  MANDATORY

ADD FIELD "last_login" OF "stntbl" AS character 
  DESCRIPTION "Date and time when last_empnum logged in (set at log in by irms_rf)."
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Last Log In"
  POSITION 10
  MAX-WIDTH 32
  HELP "Time when the latest user logged in (don't change)"
  ORDER 120
  MANDATORY

ADD FIELD "last_emp_num" OF "stntbl" AS character 
  DESCRIPTION "The last employee that has logged in through this station."
  FORMAT "x(6)"
  INITIAL "0"
  LABEL "Last Employee"
  POSITION 11
  MAX-WIDTH 12
  COLUMN-LABEL "emp #"
  VALMSG "Don't edit this field."
  HELP "Last employee logged in this station (don't change this field)."
  ORDER 110
  MANDATORY

ADD FIELD "last_activation" OF "stntbl" AS character 
  DESCRIPTION "Date and time of the most recent activation of this radio. This is set"
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Most Recent Activation"
  POSITION 12
  MAX-WIDTH 32
  HELP "Last time this radio powered up (don't change)"
  ORDER 100
  FIELD-TRIGGER "Assign" OVERRIDE PROCEDURE "datetim.t" CRC "?" 

ADD FIELD "label_queue" OF "stntbl" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Label Printer Queue"
  POSITION 13
  MAX-WIDTH 30
  HELP "System Queue where to route labels printed by this station."
  ORDER 60
  MANDATORY

ADD FIELD "label_printer" OF "stntbl" AS character 
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Label Printer Type"
  POSITION 14
  MAX-WIDTH 30
  HELP "Please enter the type of device used for printing labels."
  ORDER 50
  MANDATORY

ADD FIELD "custom_data" OF "stntbl" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 15
  MAX-WIDTH 510
  EXTENT 5
  ORDER 150

ADD FIELD "co_num" OF "stntbl" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 16
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10

ADD INDEX "co_wh_stn" ON "stntbl" 
  AREA "misc128_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "stn_num" ASCENDING 

ADD TABLE "suggested_movement"
  AREA "unused_dat"
  LABEL "Movement Master Table"
  DESCRIPTION "Table contains movement requests (for replenishments,
production scheduling, etc.)"
  DUMP-NAME "sugg_mov"
  TABLE-TRIGGER "CREATE" OVERRIDE PROCEDURE "n_smove.t" CRC "?" 

ADD FIELD "zone_to" OF "suggested_movement" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Front Loading Zone"
  POSITION 2
  MAX-WIDTH 20
  ORDER 120

ADD FIELD "wh_zone" OF "suggested_movement" AS character 
  DESCRIPTION "warehouse zone"
  FORMAT "XX"
  INITIAL "P"
  LABEL "Warehouse Zone"
  POSITION 3
  MAX-WIDTH 4
  ORDER 190
  MANDATORY

ADD FIELD "wh_num" OF "suggested_movement" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 4
  MAX-WIDTH 8
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "urgent" OF "suggested_movement" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 5
  MAX-WIDTH 1
  ORDER 140

ADD FIELD "truck_id" OF "suggested_movement" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Truck Id"
  POSITION 6
  MAX-WIDTH 40
  HELP "Truck or cart id"
  ORDER 210

ADD FIELD "to_wh_num" OF "suggested_movement" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL "0"
  LABEL "Warehouse Number"
  POSITION 7
  MAX-WIDTH 8
  COLUMN-LABEL "wh #"
  VALMSG "Warehouse must be defined in the Warehouse Master table first."
  HELP "Move to this warehouse."
  ORDER 130
  MANDATORY

ADD FIELD "task_id" OF "suggested_movement" AS integer 
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  LABEL "Task Id"
  POSITION 8
  MAX-WIDTH 4
  ORDER 40

ADD FIELD "row_status" OF "suggested_movement" AS character 
  DESCRIPTION "Status of this movement record: Open, Active or Complete"
  FORMAT "X"
  INITIAL ""
  LABEL "Status"
  POSITION 9
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS RADIO-SET
  RADIO-BUTTONS
  ""Open"", ""O"",
  ""Active"", ""A"",
  ""Complete"", ""C"""
  COLUMN-LABEL "status"
  HELP "Status of this movement record"
  ORDER 250
  MANDATORY

ADD FIELD "quantity" OF "suggested_movement" AS decimal 
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Quantity"
  POSITION 10
  MAX-WIDTH 17
  HELP "Quantity to be moved."
  DECIMALS 2
  ORDER 90

