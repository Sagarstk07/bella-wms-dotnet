  MANDATORY

ADD FIELD "serial_by_location" OF "item" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "By Location"
  POSITION 27
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  HELP "Serial numbers kept by location?"
  ORDER 310

ADD FIELD "sell_price" OF "item" AS decimal 
  FORMAT "$>>>,>>9.9999"
  INITIAL "0"
  LABEL "Selling Price"
  POSITION 28
  MAX-WIDTH 19
  HELP "Selling price for this item."
  DECIMALS 4
  ORDER 490

ADD FIELD "self_ship" OF "item" AS logical 
