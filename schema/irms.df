  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 26
  MAX-WIDTH 510
  EXTENT 5
  ORDER 280

ADD FIELD "cube" OF "binmst" AS decimal 
  FORMAT ">>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Cube"
  POSITION 27
  MAX-WIDTH 18
