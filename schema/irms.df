ADD TABLE "ordhdr"
  AREA "misc32_dat"
  LABEL "Order Header"
  DESCRIPTION "Has header information for all orders known to the system
"
  VALEXP "NOT (CAN-FIND( orddtl OF ordhdr ))"
  VALMSG "Can't delete order header when there are still detail records."
  DUMP-NAME "ordhdr"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_ordhdr.t" CRC "?" 

