  DESCRIPTION "Describes the return field to be used for the help.                                                                                         "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Return Field"
  POSITION 3
  MAX-WIDTH 16
  COLUMN-LABEL "Return Field"
  HELP "Enter the Return Field to be used for the help."
  ORDER 50

