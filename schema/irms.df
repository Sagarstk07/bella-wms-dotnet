ADD TABLE "item"
  AREA "misc32_dat"
  LABEL "Item Master"
  DESCRIPTION "The master item table.
"
  DUMP-NAME "item"

ADD FIELD "mill_code" OF "item" AS character 
  DESCRIPTION "Unique identifier for the mill."
  FORMAT "x(5)"
  INITIAL ""
  LABEL "Mill Code"
  POSITION 2
  MAX-WIDTH 10
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the mill code."
  ORDER 850

ADD FIELD "carton_width" OF "item" AS decimal 
  DESCRIPTION "This value will be sent in the hmu manifest file.                                                                                           "
  FORMAT "zzz,zz9.99"
  INITIAL "0"
  LABEL "Carton Width"
  POSITION 3
  MAX-WIDTH 20
  VIEW-AS ""
  COLUMN-LABEL "Carton Width"
  HELP "Enter the width of the carton."
  DECIMALS 2
  ORDER 840

ADD FIELD "carton_length" OF "item" AS decimal 
  DESCRIPTION "This value will be sent in the hmu manifest file.                                                                                           "
  FORMAT "zzz,zz9.99"
  INITIAL "0"
  LABEL "Carton Length"
  POSITION 4
  MAX-WIDTH 20
  VIEW-AS ""
  COLUMN-LABEL "Carton Length"
  HELP "Enter the length of the carton."
  DECIMALS 2
  ORDER 830

ADD FIELD "carton_height" OF "item" AS decimal 
  DESCRIPTION "This value will be sent in the hmu manifest file.                                                                                           "
  FORMAT "zzz,zz9.99"
  INITIAL "0"
  LABEL "Carton Height"
  POSITION 5
  MAX-WIDTH 20
  VIEW-AS ""
  COLUMN-LABEL "Carton Height"
  HELP "Enter the height of the carton."
  DECIMALS 2
  ORDER 820

ADD FIELD "prod_size" OF "item" AS character 
  DESCRIPTION "Unique identifyer for the FDM4 size table.                                                                                                  "
  FORMAT "x(5)"
  INITIAL ""
  LABEL "Product Size"
  POSITION 6
  MAX-WIDTH 10
  VIEW-AS ""
  HELP "Enter the Product Size code for this item."
  ORDER 810

ADD FIELD "require_prim" OF "item" AS logical 
  DESCRIPTION "Enter whether or not this item requires a primary pick bin.                                                                                 "
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Require Primary Pick"
  POSITION 7
  MAX-WIDTH 1
  COLUMN-LABEL "Req Prim"
  HELP "Enter whether or not this item requires a primary pick bin."
  ORDER 780

ADD FIELD "ytd_phy_unit_var" OF "item" AS decimal 
  DESCRIPTION "Year to date average variance on the number of units as perphysical in"
  FORMAT ">>9.99%"
  INITIAL "0"
  LABEL "Physical Inventory Accuracy"
  POSITION 8
  MAX-WIDTH 17
  HELP "This is the average YTD error per physical inventory."
  DECIMALS 2
  ORDER 460

ADD FIELD "ytd_phy_dollar_var" OF "item" AS decimal 
  DESCRIPTION "Year to date average error on dollar amounts, as per physical inventories."
  FORMAT "$->>>,>>9.99"
  INITIAL "0"
  LABEL "YTD Phys Count Dollar Variance"
  POSITION 9
  MAX-WIDTH 17
  HELP "This is the average YTD error on dollar amounts per physical."
  DECIMALS 2
  ORDER 470

ADD FIELD "ytd_cc_unit_var" OF "item" AS decimal 
  DESCRIPTION "Year to date average variance on the number of units as per cycle coun"
  FORMAT ">>9.99%"
  INITIAL "0"
  LABEL "Cycle Count Accuracy"
  POSITION 10
  MAX-WIDTH 17
  HELP "This is the average YTD error per cycle counts."
  DECIMALS 2
  ORDER 440

ADD FIELD "ytd_cc_dollar_var" OF "item" AS decimal 
  DESCRIPTION "Year to date average error on dollar amounts, as per cycle counts."
  FORMAT "$->>>,>>9.99"
  INITIAL "0"
  LABEL "YTD C. Count Dollar Variance"
  POSITION 11
  MAX-WIDTH 17
  HELP "This is the average YTD error on dollar amounts per cycle count"
  DECIMALS 2
  ORDER 450

ADD FIELD "width" OF "item" AS decimal 
  FORMAT ">>9.9999"
  INITIAL "0"
  LABEL "Width"
  POSITION 12
  MAX-WIDTH 17
  HELP "Enter item width"
  DECIMALS 4
  ORDER 400

ADD FIELD "wh_zone" OF "item" AS character 
  DESCRIPTION "The default warehouse zone for this item (used at receiving)."
  FORMAT "XX"
  INITIAL ""
  LABEL "Warehouse Zone"
  POSITION 13
  MAX-WIDTH 4
  HELP "Enter the default warehouse zone for this item."
  ORDER 200

ADD FIELD "wh_num" OF "item" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 14
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "weight" OF "item" AS decimal 
  FORMAT ">>>,>>>.9999"
  INITIAL "0"
  LABEL "Item Weight"
  POSITION 15
  MAX-WIDTH 24
  COLUMN-LABEL "weight"
  HELP "Enter this item's weight."
  DECIMALS 4
  ORDER 420

ADD FIELD "upc_num" OF "item" AS character 
  DESCRIPTION "UPC Number."
  FORMAT "x(24)"
  INITIAL ""
  LABEL "UPC Number"
  POSITION 16
  MAX-WIDTH 48
  HELP "Enter this item's UPC number."
  ORDER 90

ADD FIELD "uom" OF "item" AS character 
  DESCRIPTION "UOM e.g.: EA, BX, CT"
  FORMAT "X(4)"
  INITIAL ""
  LABEL "Unit of Measure"
  POSITION 17
  MAX-WIDTH 8
  COLUMN-LABEL "uom"
  VALMSG "UOM must be defined in the UOM Table first."
  HELP "Enter the Unit of Measure for this item."
  ORDER 130

ADD FIELD "unavailable_at" OF "item" AS character 
  DESCRIPTION "Unavailable at expiration date or shipping threshold."
  FORMAT "X"
  INITIAL "E"
  LABEL "Unavailable At"
  POSITION 18
  MAX-WIDTH 2
  VIEW-AS "view-as radio-set radio-buttons
""Expiration date"", ""E"", ""Shipping threshold"", ""S"""
  HELP "When item becomes unavailable."
  ORDER 600

ADD FIELD "tracking_num" OF "item" AS integer 
  DESCRIPTION "???"
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Tracking Number"
  POSITION 19
  MAX-WIDTH 4
  HELP "Enter the tracking number for this item."
  ORDER 280

ADD FIELD "stack_height" OF "item" AS integer 
  DESCRIPTION "How high can we stack this item."
  FORMAT ">,>>>,>>9"
  INITIAL ?
  LABEL "Stacking Height"
  POSITION 20
  MAX-WIDTH 4
  HELP "Item Stacking Height"
  ORDER 770

ADD FIELD "shp_threshold" OF "item" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Shipping Threshold"
  POSITION 21
  MAX-WIDTH 4
  HELP "Shipping threshold for this item, in days."
  ORDER 590

ADD FIELD "shelf_life_flag" OF "item" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Shelf Life Control"
  POSITION 22
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  HELP "Apply shelf life controls to this item?"
  ORDER 360

ADD FIELD "shelf_life" OF "item" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Shelf Life"
  POSITION 23
  MAX-WIDTH 4
  HELP "Shelf life for this item (in days)."
  ORDER 370

ADD FIELD "serial_outbound" OF "item" AS logical 
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Outbound"
  POSITION 24
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box
"
  HELP "Capture outbound serial numbers?"
