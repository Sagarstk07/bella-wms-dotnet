  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "emp_num" ASCENDING 

ADD INDEX "i_date" ON "user_state" 
  AREA "misc64_idx"
  DESCRIPTION "login date index"
  INDEX-FIELD "login_date_time" ASCENDING 
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "emp_num" ASCENDING 

ADD INDEX "i_emp" ON "user_state" 
  AREA "misc64_idx"
  DESCRIPTION "employee index"
  INDEX-FIELD "emp_num" ASCENDING 

ADD INDEX "i_session" ON "user_state" 
  AREA "misc64_idx"
  UNIQUE
  DESCRIPTION "session index"
  INDEX-FIELD "session_id" ASCENDING 

ADD TABLE "vendaddr"
  AREA "unused_dat"
  LABEL "Vendor Address"
  DESCRIPTION "This table stores alternate addresses for a vendor. There is a
many-to-one relationship into the Vendor Master table.
"
  DUMP-NAME "vendaddr"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_vendad.t" CRC "?" 

ADD FIELD "zip" OF "vendaddr" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Zip Code"
  POSITION 2
  MAX-WIDTH 20
  HELP "Enter the Zip Code"
  ORDER 90

ADD FIELD "wh_num" OF "vendaddr" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 3
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "vend_addr_num" OF "vendaddr" AS integer 
  DESCRIPTION "This field serves as an unique key into a record from this table."
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "Vendor Address Code"
  POSITION 4
  MAX-WIDTH 4
  HELP "This number is assigned by the system. Don't change it."
  ORDER 10
  MANDATORY

ADD FIELD "vendor_id" OF "vendaddr" AS character 
  FORMAT "X(9)"
  INITIAL ""
  LABEL "Vendor ID"
  POSITION 5
  MAX-WIDTH 18
  HELP "Vendor ID"
  ORDER 40
  MANDATORY

ADD FIELD "state" OF "vendaddr" AS character 
  DESCRIPTION "State"
  FORMAT "XX"
  INITIAL ""
  LABEL "State"
  POSITION 6
  MAX-WIDTH 4
  HELP "Enter the standard State abbreviation."
  ORDER 80

ADD FIELD "row_status" OF "vendaddr" AS logical 
  DESCRIPTION "Vendor: Active or Inactive"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 7
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this vendor active?"
  ORDER 180
  MANDATORY

ADD FIELD "phone_number" OF "vendaddr" AS character 
  FORMAT "X(20)"
  INITIAL ""
  LABEL "Phone Number"
  POSITION 8
  MAX-WIDTH 40
  HELP "Contact's phone number."
  ORDER 120

ADD FIELD "fax_number" OF "vendaddr" AS character 
  FORMAT "X(20)"
  INITIAL ""
  LABEL "Fax Number"
  POSITION 9
  MAX-WIDTH 40
  HELP "Contact's fax number."
  ORDER 130

ADD FIELD "edi_code" OF "vendaddr" AS character 
  DESCRIPTION "Code for EDI (Electronic Data ???) for this vendor"
  FORMAT "X(6)"
  INITIAL ""
  LABEL "EDI Code"
  POSITION 10
  MAX-WIDTH 12
  HELP "EDI code for this vendor."
  ORDER 140

ADD FIELD "duns_number" OF "vendaddr" AS character 
  DESCRIPTION "DUNS Number has something to do with credit verification."
  FORMAT "X(10)"
  INITIAL ""
  LABEL "DUNS Number"
  POSITION 11
  MAX-WIDTH 20
  HELP "DUNS Number for this vendor."
  ORDER 150

ADD FIELD "custom_data" OF "vendaddr" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 12
  MAX-WIDTH 510
  EXTENT 5
  ORDER 170

ADD FIELD "co_num" OF "vendaddr" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 13
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 20

ADD FIELD "country" OF "vendaddr" AS character 
  FORMAT "x(20)"
  INITIAL "USA"
  LABEL "Country"
  POSITION 14
  MAX-WIDTH 40
  HELP "Country"
  ORDER 100

ADD FIELD "contact_name" OF "vendaddr" AS character 
  FORMAT "X(30)"
  INITIAL ""
  LABEL "Contact Name"
  POSITION 15
  MAX-WIDTH 60
  HELP "Contact name."
  ORDER 110

ADD FIELD "city" OF "vendaddr" AS character 
  DESCRIPTION "City."
  FORMAT "x(20)"
  INITIAL ""
  LABEL "City"
  POSITION 16
  MAX-WIDTH 40
  HELP "Enter the city where this vendor is located."
  ORDER 70

ADD FIELD "addr_seq" OF "vendaddr" AS integer 
  DESCRIPTION "indexed: co, wh, vendor, addr_num (unique)"
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  LABEL "Address Sequence"
  POSITION 17
  MAX-WIDTH 4
  ORDER 50

ADD FIELD "addr" OF "vendaddr" AS character 
  DESCRIPTION "Address."
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Address"
  POSITION 18
  MAX-WIDTH 124
  HELP "Enter this vendor's address."
  EXTENT 2
  ORDER 60

ADD INDEX "co_wh_vendor_sequence" ON "vendaddr" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "vendor_id" ASCENDING 
  INDEX-FIELD "addr_seq" ASCENDING 

ADD INDEX "addr_num" ON "vendaddr" 
  AREA "unused_idx"
  UNIQUE
  DESCRIPTION "Enforce uniqueness"
  INDEX-FIELD "vend_addr_num" ASCENDING 

