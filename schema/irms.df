ADD TABLE "item_alloc"
  AREA "misc128_dat"
  LABEL "Item Allocation"
  DESCRIPTION "Table contains one record for each instance of a system entity
which allocates items (i.e.: makes them unavailable to
promise). Table is used to calculate unavailable to promise qua
ntity)"
  DUMP-NAME "item_all"
  TABLE-TRIGGER "Create" OVERRIDE PROCEDURE "n_alloc.t" CRC "?" 

ADD FIELD "wh_num" OF "item_alloc" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 2
  MAX-WIDTH 8
  HELP "Warehouse"
  ORDER 40
  MANDATORY

ADD FIELD "type" OF "item_alloc" AS character 
  DESCRIPTION "Allocation type. Mandatory field."
  FORMAT "!"
  INITIAL ?
  LABEL "Type"
  POSITION 3
  MAX-WIDTH 2
  VALMSG "Please enter one of the pre-defined allocation types."
  HELP "Allocation type."
  ORDER 50
  MANDATORY

ADD FIELD "trans_num" OF "item_alloc" AS integer 
  DESCRIPTION "If used, point to a transaction record for more information."
  FORMAT ">>>>>>>>9"
  INITIAL ?
  LABEL "Transaction Number"
  POSITION 4
  MAX-WIDTH 4
  HELP "Link to the transactions history table."
  ORDER 150

ADD FIELD "quantity" OF "item_alloc" AS decimal 
  FORMAT ">>>,>>9.99"
  INITIAL "0"
  LABEL "Quantity"
  POSITION 5
  MAX-WIDTH 17
  HELP "Allocated quantity."
  DECIMALS 2
  ORDER 130
  MANDATORY

ADD FIELD "lot" OF "item_alloc" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Lot"
  POSITION 6
  MAX-WIDTH 48
  HELP "Lot Number."
  ORDER 120

ADD FIELD "key3" OF "item_alloc" AS integer 
  DESCRIPTION "Third type-specific key."
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  POSITION 7
  MAX-WIDTH 4
  HELP "Third key."
  ORDER 80

ADD FIELD "key2" OF "item_alloc" AS integer 
  DESCRIPTION "Second type-specific key"
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  POSITION 8
  MAX-WIDTH 4
  HELP "Second Key"
  ORDER 70

ADD FIELD "key1" OF "item_alloc" AS integer 
  DESCRIPTION "First type-specific key"
  FORMAT ">>>,>>>,>>9"
  INITIAL ?
  POSITION 9
  MAX-WIDTH 4
  HELP "First Key"
  ORDER 60

ADD FIELD "id" OF "item_alloc" AS integer 
  FORMAT ">>>>>>>>9"
  INITIAL ?
  LABEL "Id"
  POSITION 10
  MAX-WIDTH 4
  HELP "DO NOT EDIT THIS FIELD."
  ORDER 10
  MANDATORY

ADD FIELD "emp_num" OF "item_alloc" AS character 
  DESCRIPTION "Employee who did the activity which placed the allocation."
  FORMAT "x(5)"
  INITIAL ?
  LABEL "Employee Number"
  POSITION 11
  MAX-WIDTH 10
  HELP "Employee who did the activity which placed the allocation."
  ORDER 140

ADD FIELD "date_time" OF "item_alloc" AS character 
  DESCRIPTION "This field is created by trigger"
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Time Stamp"
  POSITION 12
  MAX-WIDTH 32
  HELP "When this record was created"
  ORDER 20
  MANDATORY

ADD FIELD "custom_data" OF "item_alloc" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 13
  MAX-WIDTH 510
  EXTENT 5
  ORDER 170

ADD FIELD "co_num" OF "item_alloc" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 14
  MAX-WIDTH 8
  HELP "Company"
  ORDER 30

ADD FIELD "comment" OF "item_alloc" AS character 
  FORMAT "X(30)"
  INITIAL ?
  POSITION 15
  MAX-WIDTH 60
  ORDER 160

ADD FIELD "abs_num" OF "item_alloc" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Item Number"
  POSITION 16
  MAX-WIDTH 48
  HELP "Company-wide absolute number."
  ORDER 90
  MANDATORY

ADD INDEX "co_wh_time" ON "item_alloc" 
  AREA "misc128_idx"
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "date_time" ASCENDING 

ADD INDEX "co_wh_abs_type_time" ON "item_alloc" 
  AREA "misc128_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "abs_num" ASCENDING 
  INDEX-FIELD "type" ASCENDING 
  INDEX-FIELD "date_time" ASCENDING 

ADD INDEX "co_wh_type_key_lot" ON "item_alloc" 
