ADD TABLE "err_msg"
  AREA "misc64_dat"
  LABEL "Error Messages"
  DESCRIPTION "Error codes and messages to print."
  DUMP-NAME "err_msg"

ADD FIELD "rf_msg_system" OF "err_msg" AS character 
  DESCRIPTION "Same as rf_msg, but the user is not allowed to change this."
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Default RF Message"
  POSITION 2
  MAX-WIDTH 120
  HELP "Default error message for the RF -- don't change."
  ORDER 30

ADD FIELD "rf_msg" OF "err_msg" AS character 
  DESCRIPTION "Error message for the RF IRMS. Can be up to 2 chars less than the full"
  FORMAT "x(60)"
  INITIAL ""
  LABEL "RF Message"
  POSITION 3
  MAX-WIDTH 120
  HELP "Enter the error message used on the RF IRMS."
  ORDER 20

ADD FIELD "msg_system" OF "err_msg" AS character 
  DESCRIPTION "Same as msg, but the user can't change this."
  FORMAT "x(78)"
  INITIAL ""
  LABEL "Default Message"
  POSITION 4
  MAX-WIDTH 156
  HELP "Default error message -- don't change."
  ORDER 50

ADD FIELD "msg" OF "err_msg" AS character 
  DESCRIPTION "Error message for the Online IRMS. Can be up to full-screen wide."
  FORMAT "x(78)"
  INITIAL ""
  LABEL "Message"
  POSITION 5
  MAX-WIDTH 156
  HELP "Enter a full-width error message."
  ORDER 40

ADD FIELD "custom_data" OF "err_msg" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 6
  MAX-WIDTH 510
  EXTENT 5
  ORDER 60

ADD FIELD "brief" OF "err_msg" AS character 
  DESCRIPTION "This is the key for this table. This is used only internally."
  FORMAT "x(20)"
  FORMAT-SA "U"
  INITIAL ""
  LABEL "Error Name"
  POSITION 7
  MAX-WIDTH 40
  HELP "The name used to search for this error message."
  ORDER 10

ADD INDEX "brief" ON "err_msg" 
  AREA "misc64_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "brief" ASCENDING 

ADD TABLE "file_retent"
  AREA "misc128_dat"
  LABEL "File Retention Table"
  DUMP-NAME "file_ret"

ADD FIELD "timestamp" OF "file_retent" AS character 
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Time Stamp"
  POSITION 2
  MAX-WIDTH 32
  ORDER 60
  FIELD-TRIGGER "Assign" OVERRIDE PROCEDURE "datetim.t" CRC "?" 

