  MANDATORY

ADD FIELD "serial_inbound" OF "item" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Inbound"
  POSITION 25
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  HELP "Capture inbound serial numbers?"
  ORDER 330

ADD FIELD "serial_flag" OF "item" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Serialized Item"
  POSITION 26
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Does this item require serial number tracking"
