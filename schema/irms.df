  INDEX-FIELD "ReportName" ASCENDING 
  INDEX-FIELD "group_index" ASCENDING 

ADD TABLE "rbreport"
  AREA "unused_dat"
  LABEL "Print Engine"
  DESCRIPTION "Used for storing information on reports to be printed by the Progress Report Engine"
  DUMP-NAME "rbreport"

ADD FIELD "rb_window_title" OF "rbreport" AS character 
  DESCRIPTION "The text to be shown in the title bar of any Report Engine window."
  FORMAT "X(31)"
  INITIAL ""
  LABEL "Window Title"
  POSITION 2
  MAX-WIDTH 62
  VIEW-AS "VIEW-AS FILL-IN SIZE 33 BY 1"
  COLUMN-LABEL "Title"
  HELP "Enter a window title for preview and dialog windows"
  ORDER 150

ADD FIELD "rb_test_pattern" OF "rbreport" AS logical 
  DESCRIPTION "Indicates whether the Report Engine should give the user the option of printing a test pattern before printing the report."
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Test Pattern"
  POSITION 3
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS FILL-IN SIZE 10 BY 1"
  COLUMN-LABEL "Test Pattern"
  HELP "Enter yes to have Report Engine prompt for a test pattern"
  ORDER 140

ADD FIELD "rb_tag" OF "rbreport" AS character 
  DESCRIPTION "Value to match against -RBTAG command-line parameter.  If -RBTAG is specified, Report Engine will process only records whose rb_tag value matches the -RBTAG value."
  FORMAT "X(32)"
  INITIAL ""
  LABEL "Tag"
  POSITION 4
  MAX-WIDTH 64
  VIEW-AS "VIEW-AS FILL-IN SIZE 32 BY 1"
  COLUMN-LABEL "Tag"
  HELP "Enter the value to match against the -RBTAG parameter"
  ORDER 200

ADD FIELD "rb_status" OF "rbreport" AS character 
  DESCRIPTION "Status information that can be updated by the Report Engine as it processes the report.  
Value will be ""STARTED"", ""COMPLETED"", ""CANCELLED"" or ""ERROR:..."""
  FORMAT "X(254)"
  INITIAL ""
  LABEL "Report Status"
  POSITION 5
  MAX-WIDTH 508
  VIEW-AS "VIEW-AS FILL-IN SIZE 50 BY 1"
  COLUMN-LABEL "Status"
  HELP "Generally an output value; enter """" initially"
  ORDER 190

ADD FIELD "rb_report_name" OF "rbreport" AS character 
  DESCRIPTION "The name of the report to be printed."
  FORMAT "X(32)"
  INITIAL ""
  LABEL "Report Name"
  POSITION 6
  MAX-WIDTH 64
  VIEW-AS "VIEW-AS FILL-IN SIZE 32 BY 1"
  COLUMN-LABEL "Name"
  HELP "Enter the name of the report that you want printed"
  ORDER 20
  MANDATORY

ADD FIELD "rb_report_library" OF "rbreport" AS character 
  DESCRIPTION "The report library that contains the report to be printed."
  FORMAT "X(512)"
  INITIAL ""
  LABEL "Report Library"
  POSITION 7
  MAX-WIDTH 1024
  VIEW-AS "VIEW-AS FILL-IN SIZE 60 BY 1"
  COLUMN-LABEL "Library"
  HELP "Enter the pathname of the report library containing the report"
  ORDER 10
  MANDATORY

ADD FIELD "rb_print_destination" OF "rbreport" AS character 
  DESCRIPTION "Indicates where the output of the report should go.  ""D"" indicates the screen, ""A"" indicates a text export to the file named in the rb_output_file parameter, ""?"" causes the user to be prompted for the destination, and a space or empty value indicates that the report should be sent to the printer."
  FORMAT "X(1)"
  INITIAL ""
  LABEL "Print Destination"
  POSITION 8
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS FILL-IN SIZE 3 BY 1"
  COLUMN-LABEL "Print Dest"
  VALEXP "rb_print_destination = ""D"" OR rb_print_destination = ""A"" OR rb_print_destination = ""?"" OR rb_print_destination = ? OR rb_print_destination = "" """
  VALMSG "Invalid rb_print_destination parameter"
  HELP "Enter where the output should go"
  ORDER 70

ADD FIELD "rb_printer_port" OF "rbreport" AS character 
  DESCRIPTION "This is the name of the port associated with the printer specified in rb_printer_name."
  FORMAT "X(32)"
  INITIAL ""
  LABEL "Printer Port"
  POSITION 9
  MAX-WIDTH 64
  VIEW-AS "VIEW-AS FILL-IN SIZE 32 BY 1"
  COLUMN-LABEL "Port"
  HELP "Enter the name of the printer port"
  ORDER 90

ADD FIELD "rb_printer_name" OF "rbreport" AS character 
  DESCRIPTION "The name of the printer to which you want to send the report, as defined in the SYSTEM.INI file."
  FORMAT "X(32)"
  INITIAL ""
  LABEL "Printer Name"
  POSITION 10
  MAX-WIDTH 64
  VIEW-AS "VIEW-AS FILL-IN SIZE 32 BY 1"
  COLUMN-LABEL "Printer"
  HELP "Enter the printer name"
  ORDER 80

ADD FIELD "rb_output_file" OF "rbreport" AS character 
  DESCRIPTION "The name of the file to receive the report output."
  FORMAT "X(512)"
  INITIAL ""
  LABEL "Output File"
  POSITION 11
  MAX-WIDTH 1024
  VIEW-AS "VIEW-AS FILL-IN SIZE 60 BY 1"
  COLUMN-LABEL "Output File"
  HELP "Enter the name of the output file"
  ORDER 100

ADD FIELD "rb_other_parameters" OF "rbreport" AS character 
  DESCRIPTION "Table overrides and user-defined parameters.  The new-line character (~n) separates adjacent field/value pairs."
  FORMAT "X(512)"
  INITIAL ""
  LABEL "Table Overrides/User Defined Parameters"
  POSITION 12
  MAX-WIDTH 1024
  VIEW-AS "VIEW-AS FILL-IN SIZE 60 BY 1"
  COLUMN-LABEL "Other Parameters"
  HELP "Enter any table overrides and/or user-defined parameters"
  ORDER 180

ADD FIELD "rb_number_copies" OF "rbreport" AS integer 
  DESCRIPTION "The number of copies of the report to be printed."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Number Of Copies"
  POSITION 13
  MAX-WIDTH 4
  VIEW-AS "VIEW-AS FILL-IN SIZE 4 BY 1"
  COLUMN-LABEL "Copies"
  VALEXP "rb_number_copies >= 0 AND rb_number_copies < 1000"
  VALMSG "The number of copies must be between 0 and 999"
  HELP "Enter the number of report copies"
  ORDER 110

ADD FIELD "rb_memo_file" OF "rbreport" AS character 
  DESCRIPTION "The pathname of the memo file to be used instead of the memo file stored in the report."
  FORMAT "X(512)"
  INITIAL ""
  LABEL "Memo File Pathname"
  POSITION 14
  MAX-WIDTH 1024
  VIEW-AS "VIEW-AS FILL-IN SIZE 60 BY 1"
  COLUMN-LABEL "Memo File"
  HELP "Enter the memo file pathname"
  ORDER 60

ADD FIELD "rb_include_records" OF "rbreport" AS character 
  DESCRIPTION "This specifies how filtering information is to be applied.  A blank or an ""S"" causes the filter stored in the report to be used, an ""E"" causes the report to be run without any filter, an ""O"" overrides the filter stored in the report with the filter specified in the ""rb_filter"" parameter, and a ""?"" displays a dialog box prompting the user for a filter."
  FORMAT "X(1)"
  INITIAL ""
  LABEL "Include Records"
  POSITION 15
  MAX-WIDTH 2
  VIEW-AS "VIEW-AS FILL-IN SIZE 3 BY 1"
  COLUMN-LABEL "Include Records"
  VALEXP "rb_include_records = "" "" OR rb_include_records = ""S"" OR rb_include_records = ""E"" OR rb_include_records = ""O"" OR rb_include_records = ""?"" OR rb_include_records = ?"
  VALMSG "Invalid rb_include_records parameter value"
  HELP "Enter the filter override option"
  ORDER 40

ADD FIELD "rb_filter" OF "rbreport" AS character 
  DESCRIPTION "The filter to be used in processing the report.  This value is only looked at if rb_include_records = ""O""."
  FORMAT "X(512)"
  INITIAL ""
  LABEL "Filter Expression"
  POSITION 16
  MAX-WIDTH 1024
  VIEW-AS "VIEW-AS FILL-IN SIZE 60 BY 1"
  COLUMN-LABEL "Filter"
  HELP "Enter the filter for the report"
  ORDER 50

ADD FIELD "rb_end_page" OF "rbreport" AS integer 
  DESCRIPTION "The page number of the last page to be printed."
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Ending Page"
  POSITION 17
  MAX-WIDTH 4
  VIEW-AS "VIEW-AS FILL-IN SIZE 10 BY 1"
  COLUMN-LABEL "End Page"
  HELP "Enter the last page to be printed"
  ORDER 130

ADD FIELD "rb_display_status" OF "rbreport" AS logical 
  DESCRIPTION "Indicated whether a dialog showing the number of records and pages that have been processed is displayed."
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Display Status"
  POSITION 18
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS FILL-IN SIZE 8 BY 1"
  COLUMN-LABEL "Display Status"
  HELP "Enter YES to cause a print status dialog to be displayed."
  ORDER 170

ADD FIELD "rb_display_errors" OF "rbreport" AS logical 
  DESCRIPTION "Display any messages on the screen."
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Display Errors"
  POSITION 19
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS FILL-IN SIZE 8 BY 1"
  COLUMN-LABEL "Display Errors"
  HELP "Enter YES to cause errors to be reported interactively"
  ORDER 160

ADD FIELD "rb_db_connection" OF "rbreport" AS character 
  DESCRIPTION "The database override information goes here.  Each database override is separated from the next one by a new-line character (~n)."
  FORMAT "X(512)"
  INITIAL ""
  LABEL "Connection Information"
  POSITION 20
  MAX-WIDTH 1024
  VIEW-AS "VIEW-AS FILL-IN SIZE 60 BY 1"
  COLUMN-LABEL "DB Connection"
  HELP "Enter any database overrides"
  ORDER 30

ADD FIELD "rb_begin_page" OF "rbreport" AS integer 
  DESCRIPTION "The beginning page number for the report."
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Beginning Page Number"
  POSITION 21
  MAX-WIDTH 4
  VIEW-AS "VIEW-AS FILL-IN SIZE 10 BY 1"
  COLUMN-LABEL "Begin Page"
  HELP "Enter the starting page number"
  ORDER 120

ADD INDEX "tag" ON "rbreport" 
  AREA "unused_idx"
  PRIMARY
  INDEX-FIELD "rb_tag" ASCENDING 

ADD TABLE "return_action"
