  LABEL "Item#"
  POSITION 12
  MAX-WIDTH 19
  VIEW-AS ""
  COLUMN-LABEL "Item#"
  HELP "Enter the Item Number that is contained in the LPN carton."
  ORDER 70

ADD FIELD "quantity" OF "lpn" AS decimal 
  DESCRIPTION "Describes the quantity that is in the LPN.                                                                                                  "
  FORMAT ">>>,>>9.99"
  INITIAL "0"
  LABEL "Quantity"
  POSITION 13
  MAX-WIDTH 17
  VIEW-AS ""
  COLUMN-LABEL "Quantity"
