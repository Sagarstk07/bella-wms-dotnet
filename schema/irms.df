ADD TABLE "cmpmst"
  AREA "misc64_dat"
  LABEL "Company Master"
  DESCRIPTION "Table has information on all companies known to this
invocation of IRMS"
  VALEXP "( NOT (CAN-FIND(depmst WHERE depmst.co_num EQ cmpmst.co_num))) AND (NOT (CAN-FIND(shfmst where shfmst.co_num EQ
cmpmst.co_num)))"
  VALMSG "Can't delete company if it still has departments or shifts."
  DUMP-NAME "cmpmst"

ADD FIELD "zip" OF "cmpmst" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Zip Code"
  POSITION 2
  MAX-WIDTH 20
  COLUMN-LABEL "zip"
  HELP "Enter the Zip Code"
  ORDER 60

