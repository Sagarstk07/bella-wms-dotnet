ADD FIELD "line" OF "prod_stg_dtl" AS integer 
  DESCRIPTION "Production stage detail line number."
  FORMAT ">>>9"
  INITIAL "1"
  LABEL "Line"
  POSITION 5
  MAX-WIDTH 4
