  INITIAL ""
  LABEL "Image Src"
  POSITION 40
  MAX-WIDTH 240
  VIEW-AS ""
  COLUMN-LABEL "Image Src"
  ORDER 390

ADD INDEX "co_wh_bin" ON "binmst" 
  AREA "misc64_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "bin_num" ASCENDING 

