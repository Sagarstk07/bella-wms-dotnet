ADD INDEX "trans_num" ON "transactions" 
  AREA "transactions_idx"
  UNIQUE
  DESCRIPTION "Enforce uniqueness."
  INDEX-FIELD "trans_num" ASCENDING 

ADD INDEX "type_transmission" ON "transactions" 
  AREA "transactions_idx"
  INDEX-FIELD "trans_type" ASCENDING 
  INDEX-FIELD "transmission" ASCENDING 

ADD TABLE "uom"
  AREA "misc256_dat"
  LABEL "UOM Table"
  DUMP-NAME "uomtbl"

ADD FIELD "uom_desc" OF "uom" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "UOM Description"
  POSITION 2
  MAX-WIDTH 60
  COLUMN-LABEL "desc"
  HELP "Enter a description for this UOM"
  ORDER 20

ADD FIELD "uom" OF "uom" AS character 
  DESCRIPTION "UOM e.g.: EA, BX, CT"
  FORMAT "X(4)"
  INITIAL ""
  LABEL "Unit of Measure"
  POSITION 3
  MAX-WIDTH 8
  COLUMN-LABEL "uom"
  HELP "Enter an UOM code."
  ORDER 10
  MANDATORY

ADD FIELD "row_status" OF "uom" AS logical 
  DESCRIPTION "UOM: active or inactive"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 4
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this UOM active?"
  ORDER 50
  MANDATORY

ADD FIELD "custom_data" OF "uom" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 5
  MAX-WIDTH 510
  EXTENT 5
  ORDER 40

ADD INDEX "uom" ON "uom" 
  AREA "misc256_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "uom" ASCENDING 

ADD TABLE "user_menu"
  AREA "unused_dat"
  DESCRIPTION "User Menu                                                      "
  DUMP-NAME "userme"

ADD FIELD "emp_num" OF "user_menu" AS character 
  DESCRIPTION "Describes the employee name for this menu.                                                                                                  "
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Employee"
  POSITION 2
  MAX-WIDTH 16
  HELP "Enter the employee name for this menu."
  ORDER 50

ADD FIELD "group_name" OF "user_menu" AS character 
  DESCRIPTION "Describes the group name of the menu entry.                                                                                                 "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Group Name"
  POSITION 3
  MAX-WIDTH 16
  HELP "Enter the group name for this menu entry."
  ORDER 40

ADD FIELD "assembly_name" OF "user_menu" AS character 
  DESCRIPTION "Describes the assembly name that holds the form.                                                                                            "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Assembly"
  POSITION 4
  MAX-WIDTH 16
  HELP "Enter the assembly name that holds the form."
  ORDER 30

ADD FIELD "form_name" OF "user_menu" AS character 
  DESCRIPTION "Describes the form name that holds the menu.                                                                                                "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Form Name"
  POSITION 5
  MAX-WIDTH 16
  HELP "Enter the form name."
  ORDER 20

ADD FIELD "menu_name" OF "user_menu" AS character 
  DESCRIPTION "Describes the menu name.                                                                                                                    "
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Menu Nmae"
  POSITION 6
  MAX-WIDTH 16
  HELP "Enter the menu name."
  ORDER 10

ADD INDEX "main-key" ON "user_menu" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "emp_num" ASCENDING 
  INDEX-FIELD "menu_name" ASCENDING 
  INDEX-FIELD "group_name" ASCENDING 
  INDEX-FIELD "form_name" ASCENDING 
  INDEX-FIELD "assembly_name" ASCENDING 

