  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_custad.t" CRC "?" 

ADD FIELD "zip" OF "custaddr" AS character 
  FORMAT "X(10)"
  INITIAL ""
  LABEL "Zip Code"
  POSITION 2
  MAX-WIDTH 20
  COLUMN-LABEL "Zip"
