ADD TABLE "bin_size"
  AREA "unused_dat"
  LABEL "Default Bin Sizes"
  DESCRIPTION "Table has the default bin sizes, keyed to company and
warehouse."
  DUMP-NAME "bin_size"

ADD FIELD "width" OF "bin_size" AS integer 
  FORMAT ">,>>9"
  INITIAL "0"
  LABEL "Width"
  POSITION 2
  MAX-WIDTH 4
  HELP "This location's width in inches."
  ORDER 70

ADD FIELD "wh_num" OF "bin_size" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 3
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "max_weight" OF "bin_size" AS integer 
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Maximum Weight"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "max weight"
  HELP "Maximum weight for this location, in pounds."
  ORDER 50
  MANDATORY

ADD FIELD "max_pal" OF "bin_size" AS integer 
  FORMAT ">>9"
  INITIAL "1"
  LABEL "Maximum Pallets"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "max pal"
  HELP "Maximum pallets in location"
  ORDER 90
  MANDATORY

ADD FIELD "loc_type_name" OF "bin_size" AS character 
  FORMAT "x(8)"
  INITIAL "Pallet"
  LABEL "Location Type"
  POSITION 6
  MAX-WIDTH 16
  ORDER 40

ADD FIELD "loc_type" OF "bin_size" AS character 
  FORMAT "x"
  INITIAL "P"
  LABEL "Location Code"
  POSITION 7
  MAX-WIDTH 2
  VIEW-AS ""
  HELP "Location type, the same as in binmst."
  ORDER 30
  MANDATORY

ADD FIELD "height" OF "bin_size" AS integer 
  FORMAT ">,>>9"
  INITIAL "0"
  LABEL "Height"
  POSITION 8
  MAX-WIDTH 4
  HELP "This location's height in inches."
  ORDER 60

ADD FIELD "depth" OF "bin_size" AS integer 
  FORMAT ">,>>9"
  INITIAL "0"
  LABEL "Depth"
  POSITION 9
  MAX-WIDTH 4
  HELP "This location's depth in inches."
  ORDER 80

ADD FIELD "custom_data" OF "bin_size" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ?
  POSITION 10
  MAX-WIDTH 510
  EXTENT 5
  ORDER 100

ADD FIELD "co_num" OF "bin_size" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 11
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 10

ADD INDEX "co_wh_code" ON "bin_size" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "loc_type" ASCENDING 

ADD TABLE "binmst"
  AREA "misc64_dat"
  LABEL "Location Master Table"
  DESCRIPTION "All locations in the warehouse. "
  DUMP-NAME "binmst"

ADD FIELD "cart_layout" OF "binmst" AS character 
  DESCRIPTION "Stores the cart layout type"
  FORMAT "x(8)"
  INITIAL ""
  LABEL "Cart Layout"
  POSITION 2
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "Layout Type"
  HELP "Enter the cart layout type"
  ORDER 340

ADD FIELD "lpn_control_ovrr" OF "binmst" AS character 
  DESCRIPTION "Stores the LPN Control Override of the current location.                                                                                    "
  FORMAT "x"
  INITIAL ""
  LABEL "LPN Control Override"
  POSITION 3
  MAX-WIDTH 2
  VIEW-AS ""
  COLUMN-LABEL "LPN Ovrr"
  HELP "Enter the LPN Control Override for the location (blank allowed)"
  ORDER 330

ADD FIELD "replen_abs_num" OF "binmst" AS character 
  DESCRIPTION "Stores the bulk Item Number used for automatic replishments."
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Replen Item Number"
  POSITION 4
  MAX-WIDTH 48
  VIEW-AS ""
  COLUMN-LABEL "Replen Item"
  HELP "Enter the bulk Item Number used for automatic replishments."
  ORDER 320

ADD FIELD "short_term_primary" OF "binmst" AS logical 
  DESCRIPTION "Indicates if location is a short term primary.                                                                                              "
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Short Term Primary"
  POSITION 5
  MAX-WIDTH 1
  COLUMN-LABEL "Short Term!Primary"
  HELP "Enter Y to designate location as a short term primary."
  ORDER 310

ADD FIELD "bin_seq" OF "binmst" AS decimal 
  DESCRIPTION "This value will determine the pick sequence when an order is being    picked.                                                               "
  FORMAT "zzzzz9.99"
  INITIAL "0"
  LABEL "Bin Seq"
  POSITION 6
  MAX-WIDTH 17
  COLUMN-LABEL "Bin Seq"
  VALMSG "Enter the bin pick sequence value."
  HELP "Enter the bin pick sequence value."
  DECIMALS 2
  ORDER 300

ADD FIELD "wood_flag" OF "binmst" AS logical 
  DESCRIPTION "Is there a pallet in this bin?"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Wood"
  POSITION 7
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  HELP "If there is wood (that is, a pallet) in this bin."
  ORDER 240
  MANDATORY

ADD FIELD "width" OF "binmst" AS integer 
  FORMAT ">,>>9"
  INITIAL "0"
  LABEL "Width"
  POSITION 8
  MAX-WIDTH 4
  HELP "This location's width in inches."
  ORDER 170

ADD FIELD "wh_zone" OF "binmst" AS character 
  DESCRIPTION "warehouse zone"
  FORMAT "XX"
  INITIAL ?
  LABEL "Warehouse Zone"
  POSITION 9
  MAX-WIDTH 14
  HELP "Enter the zone where this location is."
  ORDER 40
  MANDATORY

ADD FIELD "wh_num" OF "binmst" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 10
  MAX-WIDTH 11
  HELP "Enter the Warehouse Number."
  ORDER 20
  MANDATORY

ADD FIELD "stack_height" OF "binmst" AS integer 
  DESCRIPTION "How high can we stack pallets."
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Stacking Height"
  POSITION 11
  MAX-WIDTH 4
  HELP "Pallet Stacking Height"
  ORDER 210

ADD FIELD "row_status" OF "binmst" AS logical 
  DESCRIPTION "Location: active or inactive"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Active"
  POSITION 12
  MAX-WIDTH 1
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Is this location active?"
  ORDER 290
  MANDATORY

ADD FIELD "rep_unit" OF "binmst" AS character 
  DESCRIPTION """E""aches, Full ""C""artons, Full ""Pallets"""
  FORMAT "X"
  INITIAL "C"
  LABEL "Replenish. Unit"
  POSITION 13
  MAX-WIDTH 2
  VIEW-AS "view-as radio-set
radio-buttons ""Eaches"", ""E"",
""Full Cartons"", ""C"",
""Full Pallets"", ""P"""
  HELP "Replenishment unit."
  ORDER 130

ADD FIELD "rep_qty" OF "binmst" AS decimal 
  DESCRIPTION "Replenishment quantity (for auto-restock) (Used only when the location is a primary pick location.)"
  FORMAT ">>,>>9.99"
  INITIAL ?
  LABEL "Rep Quantity"
  POSITION 14
  MAX-WIDTH 17
  HELP "Enter the quantity at which this item should be replenished."
  DECIMALS 2
  ORDER 120

ADD FIELD "prim_pick_type" OF "binmst" AS character 
  DESCRIPTION "F == full, S == split, C == counter sales"
  FORMAT "X"
  INITIAL "S"
  LABEL "P.P. Type"
  POSITION 15
  MAX-WIDTH 2
  HELP "Primary Pick Type: Full case, Split case, Counter Sales"
  ORDER 80

ADD FIELD "prim_pick" OF "binmst" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Primary Pick"
  POSITION 16
  MAX-WIDTH 1
  VIEW-AS "view-as toggle-box"
  HELP "Is this location a primary pick location?"
