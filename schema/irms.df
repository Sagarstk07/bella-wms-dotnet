  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "rtn_category" ASCENDING 
  INDEX-FIELD "row_status" ASCENDING 

ADD INDEX "num" ON "rtn_ctn_mst" 
  AREA "unused_idx"
  UNIQUE
  INDEX-FIELD "carton_num" ASCENDING 

ADD TABLE "rule"
  AREA "unused_dat"
  LABEL "Rule"
  DESCRIPTION "Each record represents a rule for a specific application process."
  DUMP-NAME "rule"

ADD FIELD "co_num" OF "rule" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the company."
  ORDER 10
  MANDATORY

ADD FIELD "wh_num" OF "rule" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 3
  MAX-WIDTH 8
  HELP "Enter the warehouse id ('*' for all warehouses)."
  ORDER 15

ADD FIELD "application" OF "rule" AS character 
  DESCRIPTION "i.e. cartonization, shipping, packing, etc."
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Application"
  POSITION 4
  MAX-WIDTH 40
  HELP "Enter the application area for this rule."
  ORDER 20

ADD FIELD "type" OF "rule" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Rule Type"
  POSITION 5
  MAX-WIDTH 40
  COLUMN-LABEL "Type"
  HELP "Enter the type for this rule."
  ORDER 30

ADD FIELD "type_level" OF "rule" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Type Level"
  POSITION 6
  MAX-WIDTH 40
  COLUMN-LABEL "Level"
  HELP "Enter the level in which to apply the type."
  ORDER 40

ADD FIELD "description" OF "rule" AS character 
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Description"
  POSITION 7
  MAX-WIDTH 60
  COLUMN-LABEL "Description"
  HELP "Enter the summary/short description for this rule."
  ORDER 50

ADD FIELD "long_desc" OF "rule" AS character 
  FORMAT "X(2000)"
  INITIAL ""
  LABEL "Long Description"
  POSITION 8
  MAX-WIDTH 4000
  COLUMN-LABEL "Long Desc"
  HELP "Enter the description of this rule and its values."
  ORDER 60

ADD FIELD "check_point" OF "rule" AS character 
  DESCRIPTION "Can be used to group rules."
  FORMAT "x(15)"
  INITIAL ""
  LABEL "Check Point"
  POSITION 9
  MAX-WIDTH 30
  HELP "Enter the point in which to apply this rule."
  ORDER 70

ADD INDEX "co-wh-type" ON "rule" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "type" ASCENDING 
  INDEX-FIELD "type_level" ASCENDING 

ADD INDEX "co-wh-app-type" ON "rule" 
  AREA "unused_idx"
  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "application" ASCENDING 
  INDEX-FIELD "type" ASCENDING 
  INDEX-FIELD "type_level" ASCENDING 

ADD TABLE "rule_value"
  AREA "unused_dat"
  LABEL "Rule Value"
  DESCRIPTION "Each record represents a valid value for a rule."
  DUMP-NAME "ruleval"

ADD FIELD "co_num" OF "rule_value" AS character 
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 2
  MAX-WIDTH 8
  HELP "Enter the company."
