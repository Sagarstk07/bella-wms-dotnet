  MANDATORY

ADD FIELD "kit_qty" OF "prod_stg_dtl" AS decimal 
  DESCRIPTION "Movement quantity."
  FORMAT ">>>,>>9"
  INITIAL "0"
  LABEL "Kit Quantity"
  POSITION 6
  MAX-WIDTH 17
  HELP "Quantity."
  DECIMALS 2
  ORDER 110

ADD FIELD "kit_num" OF "prod_stg_dtl" AS character 
  DESCRIPTION "The item number that means a kit."
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Item Number"
  POSITION 7
  MAX-WIDTH 48
  VALMSG "Don't modify this field."
  HELP "Don't modify this field."
