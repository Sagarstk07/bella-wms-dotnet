ADD TABLE "dockmstr"
  AREA "misc128_dat"
  LABEL "Dock Master Table"
  DESCRIPTION "Has information about shipping docks.                          "
  DUMP-NAME "dockmstr"

ADD FIELD "host_batch" OF "dockmstr" AS character 
  DESCRIPTION "This stores the wave code from the ERP.                                                                                                     "
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Host Wave"
  POSITION 2
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the wave code."
  ORDER 180

ADD FIELD "sub_control_id_now" OF "dockmstr" AS character 
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Current Sub Control"
  POSITION 3
  MAX-WIDTH 24
  VIEW-AS ""
  COLUMN-LABEL "Current Sub Control"
  HELP "Enter a sub control id that will store the address number."
  ORDER 170

ADD FIELD "control_id_default" OF "dockmstr" AS character 
  DESCRIPTION "The Default Control ID for the dock.                                                                                                        "
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Default Control"
  POSITION 4
  MAX-WIDTH 24
  COLUMN-LABEL "Default!Control"
  HELP "Enter the Default Control ID for the dock."
  ORDER 160

ADD FIELD "control_id_now" OF "dockmstr" AS character 
  DESCRIPTION "The Current Control for the dock master.                                                                                                    "
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Current Control"
  POSITION 5
  MAX-WIDTH 24
  COLUMN-LABEL "Current!Control"
  HELP "Enter the Current Control for the dock master record."
  ORDER 150

ADD FIELD "control_type" OF "dockmstr" AS character 
  DESCRIPTION "The Dock's Control Type.                                                                                                                    "
  FORMAT "x(1)"
  INITIAL ""
  LABEL "Control Type"
  POSITION 6
  MAX-WIDTH 2
  COLUMN-LABEL "Control!Type"
  HELP "Enter the Dock's control type (blank - carrier, C - Customer)."
