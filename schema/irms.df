  INDEX-FIELD "co_num" ASCENDING 
  INDEX-FIELD "wh_num" ASCENDING 
  INDEX-FIELD "suggested_bin" ASCENDING 
  INDEX-FIELD "bin_num" ASCENDING 

ADD INDEX "co_wh_task" ON "inventory" 
  AREA "misc64_idx"
