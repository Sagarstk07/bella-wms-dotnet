  INDEX-FIELD "from_zip" ASCENDING 
  INDEX-FIELD "to_zip" ASCENDING 

ADD TABLE "parcel_zone"
  AREA "unused_dat"
  LABEL "Parcel Zone Master"
  DESCRIPTION "Carrier-zone is the zone code found in the carrier table. From zip is the first 3 digits of the origin zip code, encoded as an integer. The zone, ETA and zone status can be found indexed by the first 3 digits of the destination ZIP code."
  DUMP-NAME "parcel_z"

ADD FIELD "zone_status" OF "parcel_zone" AS logical 
  DESCRIPTION "Zone: active or inactive"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Active"
  POSITION 2
  MAX-WIDTH 7992
  VIEW-AS "VIEW-AS TOGGLE-BOX"
  HELP "Do we ship to this zone?"
  EXTENT 999
  ORDER 80
  MANDATORY

ADD FIELD "zone" OF "parcel_zone" AS character 
  FORMAT "X(3)"
  INITIAL ?
  LABEL "Zone"
  POSITION 3
  MAX-WIDTH 7992
  HELP "Zone."
  EXTENT 999
  ORDER 30

ADD FIELD "n_days" OF "parcel_zone" AS integer 
  FORMAT ">>9"
  INITIAL ?
  LABEL "ETA"
  POSITION 4
  MAX-WIDTH 7992
  HELP "Estimated time of arrival (days)."
  EXTENT 999
  ORDER 40

ADD FIELD "from_zip" OF "parcel_zone" AS integer 
  FORMAT "999"
  INITIAL ?
  LABEL "From"
  POSITION 5
  MAX-WIDTH 4
  HELP "First 3 digits of the origin ZIP code"
  ORDER 20
  MANDATORY

ADD FIELD "carrier_zone" OF "parcel_zone" AS character 
  DESCRIPTION "Ties a carrier (from carriers table) into a set of fields in this table."
  FORMAT "x(2)"
  INITIAL ""
  LABEL "Carrier Zone Id"
  POSITION 6
  MAX-WIDTH 4
  HELP "Carrier Zone ID"
  ORDER 10
  MANDATORY

ADD INDEX "cz_from" ON "parcel_zone" 
  AREA "unused_idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "carrier_zone" ASCENDING 
  INDEX-FIELD "from_zip" ASCENDING 

ADD TABLE "perf_audit"
  AREA "unused_dat"
  DESCRIPTION "Describes queries that have gone through the system.           "
  DUMP-NAME "perfau"

ADD FIELD "index_list" OF "perf_audit" AS character 
  DESCRIPTION "Describes the indexes that were used for this query.                                                                                        "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Indexes Used"
  POSITION 2
  MAX-WIDTH 16
  COLUMN-LABEL "Indexes Used"
  HELP "Enter the indexes used for this query."
  ORDER 130

ADD FIELD "create_date" OF "perf_audit" AS date 
  DESCRIPTION "Describes the date that this process was created.                                                                                           "
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "Created"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Created"
  HELP "Enter the create date for this process."
  ORDER 120

ADD FIELD "login_name" OF "perf_audit" AS character 
  DESCRIPTION "Describes the Login Name of the user.                                                                                                       "
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Login Name"
  POSITION 4
  MAX-WIDTH 16
  COLUMN-LABEL "Login Name"
  HELP "Enter the Login Name of the user."
  ORDER 110

ADD FIELD "time_end" OF "perf_audit" AS integer 
  DESCRIPTION "Describes the end time of this process.                                                                                                     "
  FORMAT ">>>>>>>9"
  INITIAL "0"
  LABEL "End Time"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "End Time"
  HELP "Enter the end time of this process."
  ORDER 100

ADD FIELD "time_start" OF "perf_audit" AS integer 
  DESCRIPTION "Describes the start time of this process.                                                                                                   "
  FORMAT ">>>>>>>"
  INITIAL "0"
  LABEL "Start Time"
  POSITION 6
  MAX-WIDTH 4
  COLUMN-LABEL "Start Time"
  HELP "Enter the start time of this process."
  ORDER 90

ADD FIELD "process_id" OF "perf_audit" AS integer 
  DESCRIPTION "Describes the process id that caused this to happen.                                                                                        "
  FORMAT ">>>>>>9"
  INITIAL "0"
  LABEL "Process ID"
  POSITION 7
  MAX-WIDTH 4
  COLUMN-LABEL "Process ID"
  HELP "Enter the OS process id that caused this to happen."
  ORDER 80

ADD FIELD "db_id" OF "perf_audit" AS integer 
  DESCRIPTION "Describes the DB user id logged in.                                                                                                         "
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "DB User"
  POSITION 8
  MAX-WIDTH 4
  COLUMN-LABEL "DB User"
  HELP "Enter the DB User id."
  ORDER 70

ADD FIELD "table_list" OF "perf_audit" AS character 
  DESCRIPTION "Describes the list of tables used for the query.                                                                                            "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Table List"
  POSITION 9
  MAX-WIDTH 16
  COLUMN-LABEL "Table List"
  HELP "Enter the list of tables for this query."
  ORDER 60

ADD FIELD "field_list" OF "perf_audit" AS character 
  DESCRIPTION "Describes the field list for the query.                                                                                                     "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Field List"
  POSITION 10
  MAX-WIDTH 16
  COLUMN-LABEL "Field List"
  HELP "Enter the field list that was used for the query."
  ORDER 50

ADD FIELD "query_string" OF "perf_audit" AS character 
  DESCRIPTION "Dsecribes the query that was performed.                                                                                                     "
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Query"
  POSITION 11
  MAX-WIDTH 16
  COLUMN-LABEL "Query"
  HELP "Enter the Query that was performed."
  ORDER 40

ADD FIELD "iaccess" OF "perf_audit" AS integer 
  DESCRIPTION "Describes the number of db accesses.                                                                                                        "
  FORMAT ">>>,>>>,>>>,>>9"
  INITIAL "0"
  LABEL "Accesses"
  POSITION 12
  MAX-WIDTH 4
  COLUMN-LABEL "Accesses"
  HELP "Enter the number of db accesses."
  ORDER 30

ADD FIELD "ireads" OF "perf_audit" AS integer 
  DESCRIPTION "Describes the number of db reads.                                                                                                           "
  FORMAT ">>>,>>>,>>>,>>9"
  INITIAL "0"
  LABEL "DBReads"
  POSITION 13
  MAX-WIDTH 4
  COLUMN-LABEL "DBReads"
  HELP "Enter the number of reads this caused."
  ORDER 20

ADD FIELD "program_name" OF "perf_audit" AS character 
  DESCRIPTION "Describes the program that ran the query.                                                                                                   "
  FORMAT "x(20)"
  INITIAL ?
  LABEL "Program"
  POSITION 14
  MAX-WIDTH 16
  COLUMN-LABEL "Program"
  HELP "Enter the program that ran the query."
  ORDER 10

ADD INDEX "dtread-key" ON "perf_audit" 
  AREA "unused_idx"
  PRIMARY
  INDEX-FIELD "create_date" ASCENDING 
  INDEX-FIELD "ireads" DESCENDING 

ADD INDEX "dtaccess-key" ON "perf_audit" 
  AREA "unused_idx"
  INDEX-FIELD "create_date" ASCENDING 
  INDEX-FIELD "iaccess" DESCENDING 

ADD INDEX "dtpid-key" ON "perf_audit" 
  AREA "unused_idx"
  INDEX-FIELD "create_date" ASCENDING 
  INDEX-FIELD "process_id" ASCENDING 

ADD INDEX "dtuser-key" ON "perf_audit" 
  AREA "unused_idx"
  INDEX-FIELD "create_date" ASCENDING 
  INDEX-FIELD "login_name" ASCENDING 
  INDEX-FIELD "ireads" DESCENDING 

ADD TABLE "pick"
  AREA "misc64_dat"
  LABEL "Pick Master Table"
  DESCRIPTION "This is used to generate and maintain pick labels.
"
  DUMP-NAME "pick"
  TABLE-TRIGGER "Create" NO-OVERRIDE PROCEDURE "n_pick.t" CRC "?" 
  TABLE-TRIGGER "WRITE" NO-OVERRIDE PROCEDURE "w_pick.t" CRC "?" 

ADD FIELD "position_id" OF "pick" AS character 
  DESCRIPTION "Stores the id for the specific position on the cart"
  FORMAT "x(3)"
  INITIAL ""
  LABEL "Position ID"
  POSITION 2
  MAX-WIDTH 6
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the id for the specific position on the cart."
  ORDER 330

ADD FIELD "po_number" OF "pick" AS character 
  DESCRIPTION "The purchase order po number.                                                                                                               "
  FORMAT "x(8)"
  INITIAL ?
  LABEL "PO Number"
  POSITION 3
  MAX-WIDTH 19
  VIEW-AS ""
  COLUMN-LABEL "PO Number"
  VALMSG "Enter the purchase order number"
  HELP "Enter the purchase order number"
  ORDER 320

ADD FIELD "origin_country" OF "pick" AS character 
  DESCRIPTION "Country of Origin.                                                                                                                          "
  FORMAT "XX"
  INITIAL ?
  LABEL "Country of Origin."
  POSITION 4
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL ""
  VALMSG "Enter the country code."
  HELP "Enter the country code."
  ORDER 310

ADD FIELD "allow_pick" OF "pick" AS logical 
  DESCRIPTION "Stores whether the pick is ready to be picked or not.                                                                                       "
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Allow Pick"
  POSITION 5
  MAX-WIDTH 1
  VIEW-AS ""
  COLUMN-LABEL "Allow Pick"
  HELP "Enter Yes if this pick is ready to be picked."
  ORDER 300

ADD FIELD "lpn_scanid" OF "pick" AS character 
  DESCRIPTION "Describes the LPN id that is used for scanning, composite field.                                                                            "
  FORMAT "x(24)"
  INITIAL ""
  LABEL "LPN ScanID"
  POSITION 6
  MAX-WIDTH 16
  VIEW-AS ""
  COLUMN-LABEL "LPN ScanID"
  HELP "Enter the LPN Scannable ID."
  ORDER 290

ADD FIELD "cart" OF "pick" AS character 
  DESCRIPTION "Used to associate a pick to a cart (multipel picks can be associated  to a cart, but only one cart can be associated to a pick)             "
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Cart"
  POSITION 7
  MAX-WIDTH 40
  HELP "Enter the cart used for this pick."
  ORDER 280

ADD FIELD "bin_seq" OF "pick" AS decimal 
  DESCRIPTION "This value will determine the pick sequence when an order is being    picked.                                                               "
  FORMAT "zzzzz9.99"
  INITIAL "0"
  LABEL "Bin Seq"
  POSITION 8
  MAX-WIDTH 17
  COLUMN-LABEL "Bin Seq"
  VALMSG "Enter the bin pick sequence value."
  HELP "Enter the bin pick sequence value."
  DECIMALS 2
  ORDER 270

ADD FIELD "wh_zone" OF "pick" AS character 
  DESCRIPTION "warehouse zone"
  FORMAT "XX"
  INITIAL "P"
  LABEL "Warehouse Zone"
  POSITION 9
  MAX-WIDTH 4
  ORDER 140
  MANDATORY

ADD FIELD "wh_num" OF "pick" AS character 
  DESCRIPTION "Warehouse Number."
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Warehouse"
  POSITION 10
  MAX-WIDTH 8
  HELP "Enter the Warehouse Number."
  ORDER 30
  MANDATORY

ADD FIELD "stock_stat" OF "pick" AS character 
  DESCRIPTION "Allocatable stock, empty; all other codes, unallocatable."
  FORMAT "X"
  INITIAL ""
  LABEL "Stock Status"
  POSITION 11
  MAX-WIDTH 2
  HELP "The status of this stock item."
  ORDER 240
  MANDATORY

ADD FIELD "serial_num" OF "pick" AS character 
  DESCRIPTION "The serial number (captured from the item, as set by manufacturer)."
  FORMAT "x(20)"
  INITIAL ?
  LABEL "Serial Number"
  POSITION 12
  MAX-WIDTH 40
  HELP "Enter the serial number."
  ORDER 110

ADD FIELD "reserved" OF "pick" AS logical 
  DESCRIPTION "Sometimes we create a pick label but we are not able to reserve inventory for that pick. In these cases, this field will be set to false. In normal cases, this field will be set to true. This should be checked whenever using the pick table to check or update the reserved_qty column in the inventory table."
  FORMAT "yes/no"
  INITIAL "no"
  POSITION 13
  MAX-WIDTH 1
  ORDER 200
  MANDATORY

ADD FIELD "qty" OF "pick" AS decimal 
  FORMAT ">>,>>9.99"
  INITIAL "0"
  LABEL "Quantity"
  POSITION 14
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 170

ADD FIELD "printed" OF "pick" AS logical 
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Printed"
  POSITION 15
  MAX-WIDTH 1
  HELP "This pick has had its label printed at least once."
  ORDER 210
  MANDATORY

ADD FIELD "pick_status" OF "pick" AS character 
  DESCRIPTION "Same statuses as order detail."
  FORMAT "X"
  INITIAL "O"
  LABEL "Status"
  POSITION 16
  MAX-WIDTH 2
  ORDER 260

ADD FIELD "pick_sequence" OF "pick" AS integer 
  FORMAT "999"
  INITIAL ?
  LABEL "Pick Sequence"
  POSITION 17
  MAX-WIDTH 4
  HELP "Used for sorting picks in warehouse scan order."
  ORDER 130

ADD FIELD "pallet_num" OF "pick" AS integer 
  FORMAT "ZZZZZZZZZ9"
  INITIAL ?
  LABEL "Pallet/Tote"
  POSITION 18
  MAX-WIDTH 4
  ORDER 220

ADD FIELD "pallet_id" OF "pick" AS character 
  FORMAT "x(17)"
  INITIAL ""
  LABEL "Pallet Id"
  POSITION 19
  MAX-WIDTH 34
  COLUMN-LABEL "pallet"
  ORDER 230

ADD FIELD "orig_qty" OF "pick" AS decimal 
  FORMAT ">>,>>9.99"
  INITIAL "0"
  LABEL "Original Qty"
  POSITION 20
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 180

ADD FIELD "order_suffix" OF "pick" AS character 
  FORMAT "X(2)"
  INITIAL ""
  LABEL "Order Suffix"
  POSITION 21
  MAX-WIDTH 4
  ORDER 60

ADD FIELD "order" OF "pick" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Order"
  POSITION 22
  MAX-WIDTH 20
  ORDER 50

ADD FIELD "lot" OF "pick" AS character 
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Lot"
  POSITION 23
  MAX-WIDTH 48
  HELP "Lot Number."
  ORDER 120

ADD FIELD "line_sequence" OF "pick" AS integer 
  DESCRIPTION "Used for items that are kits, this is a sub-line number."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Seq"
  POSITION 24
  MAX-WIDTH 4
  COLUMN-LABEL "Sq"
  HELP "Enter the order line sequence number."
  ORDER 80

ADD FIELD "line" OF "pick" AS integer 
  FORMAT ">>>9"
  INITIAL "1"
  LABEL "Line"
  POSITION 25
  MAX-WIDTH 4
  VALMSG "Please enter a non-zero order line."
  HELP "Order Line number."
  ORDER 70
  MANDATORY

ADD FIELD "id" OF "pick" AS integer 
  DESCRIPTION "This is generated by trigger, on create. Don't change it. This number uniquely identifies a pick (label), and it's barcoded in the pick label"
  FORMAT ">>>,>>>,>>9"
  INITIAL "0"
  LABEL "Pick Id"
  POSITION 26
  MAX-WIDTH 4
  HELP "Don't change this field"
  ORDER 10

ADD FIELD "date_time" OF "pick" AS character 
  DESCRIPTION "Time stamp: when this pick record was created."
  FORMAT "9999-99-99 99:99"
  INITIAL ""
  LABEL "Pick Requested"
  POSITION 27
  MAX-WIDTH 32
  ORDER 190
  FIELD-TRIGGER "Assign" OVERRIDE PROCEDURE "datetim.t" CRC "?" 

ADD FIELD "custom_data" OF "pick" AS character 
  DESCRIPTION "Catch-all field for customization."
  FORMAT "X(50)"
  INITIAL ""
  POSITION 28
  MAX-WIDTH 510
  EXTENT 5
  ORDER 250

ADD FIELD "co_num" OF "pick" AS character 
  DESCRIPTION "Company Number"
  FORMAT "x(4)"
  INITIAL ""
  LABEL "Company"
  POSITION 29
  MAX-WIDTH 8
  HELP "Enter the company number."
  ORDER 20
  MANDATORY

ADD FIELD "carton_id" OF "pick" AS character 
  DESCRIPTION "Carton id, may be pre-printed. In any case, should be unique within a warehouse."
  FORMAT "x(17)"
  INITIAL ""
  LABEL "Carton ID"
  POSITION 30
  MAX-WIDTH 34
  HELP "Carton where this pick was placed, if any"
  ORDER 90

ADD FIELD "bin_num" OF "pick" AS character 
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Location"
  POSITION 31
  MAX-WIDTH 20
  HELP "Location where this order line will be picked."
  ORDER 160
  MANDATORY

ADD FIELD "batch" OF "pick" AS integer 
  DESCRIPTION "This number is generated by sequence, and it uniquely identifies a batch of labels. It is used for reprint purposes. It is printed on the pick label, but not barcoded."
  FORMAT ">,>>>,>>9"
  INITIAL "0"
  LABEL "Label Batch"
  POSITION 32
  MAX-WIDTH 4
  HELP "Don't change this field."
  ORDER 40

ADD FIELD "aisle" OF "pick" AS integer 
  DESCRIPTION "Aisle (within the zone) where this location is."
  FORMAT ">>>9"
  INITIAL "1"
  LABEL "Aisle"
  POSITION 33
  MAX-WIDTH 4
  ORDER 150
  MANDATORY

ADD FIELD "abs_num" OF "pick" AS character 
  DESCRIPTION "Company-wide absolute number (may be different from catalog number). (In All-Phase, this is their internal {aka big} item number, as contrasted to NAED number.)"
  FORMAT "x(24)"
  INITIAL ""
  LABEL "Item Number"
  POSITION 34
  MAX-WIDTH 48
  VALMSG "Please enter the company-wide code for this item."
  HELP "Enter the company-wide unique code for this item."
  ORDER 100

ADD FIELD "container_id" OF "pick" AS integer 
  DESCRIPTION "Link picks to a container for shipment.                                                                                                     "
  FORMAT ">>>>>>9"
