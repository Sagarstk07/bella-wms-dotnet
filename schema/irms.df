  MANDATORY

ADD FIELD "carrier_default" OF "dockmstr" AS character 
  FORMAT "x(6)"
  INITIAL ""
  LABEL "Default Carrier"
  POSITION 18
  MAX-WIDTH 12
  HELP "Default Carrier for this dock."
  ORDER 50
  MANDATORY

ADD FIELD "container_num" OF "dockmstr" AS character 
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Container Number"
  POSITION 19
  MAX-WIDTH 40
  VIEW-AS ""
  COLUMN-LABEL ""
  HELP "Enter the container number."
  ORDER 190

